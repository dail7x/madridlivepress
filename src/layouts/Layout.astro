---
import Header from '@/components/ui/Header.astro';
import Footer from '@/components/ui/Footer.astro';
import DirectusLivePreview from '@/components/ui/DirectusLivePreview.astro';
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  lang?: 'es' | 'en';
  alternateUrlEs?: string;
  alternateUrlEn?: string;
}

const {
  title = 'Madrid Live Press | Sala de Prensa de la Noche y la Cultura de Madrid',
  description = 'Sala de prensa virtual internacional de la noche, el ocio cultural y los 96 espacios asociados de Madrid, gestionada por NocheMadrid.',
  image = '/images/hero-backstage.webp',
  lang = 'es',
  alternateUrlEs,
  alternateUrlEn,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://madridlivepress.116.203.118.1.sslip.io');
const currentPath = Astro.url.pathname;
const isEn = lang === 'en' || currentPath.startsWith('/en');
const prefix = isEn ? '/en' : '';

function getAlternateLanguagePath(pathname: string, targetLang: 'es' | 'en'): string {
  const cleanPath = pathname.replace(/\/$/, '') || '/';
  
  if (targetLang === 'es') {
    if (cleanPath === '/en' || cleanPath === '/en/') return '/';
    if (cleanPath === '/en/news' || cleanPath === '/en/comunicados') return '/comunicados';
    if (cleanPath.startsWith('/en/news/')) return cleanPath.replace('/en/news/', '/comunicados/');
    if (cleanPath.startsWith('/en/comunicados/')) return cleanPath.replace('/en/comunicados/', '/comunicados/');
    if (cleanPath === '/en/directory' || cleanPath === '/en/directorio') return '/directorio';
    if (cleanPath.startsWith('/en/directory/')) return cleanPath.replace('/en/directory/', '/directorio/');
    if (cleanPath.startsWith('/en/directorio/')) return cleanPath.replace('/en/directorio/', '/directorio/');
    if (cleanPath === '/en/press-kits') return '/press-kits';
    if (cleanPath === '/en/coverage' || cleanPath === '/en/cobertura') return '/cobertura';
    if (cleanPath === '/en/archive' || cleanPath === '/en/archivo') return '/archivo';
    if (cleanPath === '/en/about' || cleanPath === '/en/sobre-el-sector') return '/sobre-el-sector';
    if (cleanPath === '/en/events' || cleanPath === '/en/eventos') return '/eventos';
    if (cleanPath.startsWith('/en/events/')) return cleanPath.replace('/en/events/', '/eventos/');
    if (cleanPath.startsWith('/en/eventos/')) return cleanPath.replace('/en/eventos/', '/eventos/');
    if (cleanPath === '/en/accreditation' || cleanPath === '/en/acreditaciones') return '/acreditaciones';
    return cleanPath.replace(/^\/en/, '') || '/';
  }

  if (targetLang === 'en') {
    if (cleanPath === '/' || cleanPath === '') return '/en';
    if (cleanPath === '/comunicados') return '/en/news';
    if (cleanPath.startsWith('/comunicados/')) return cleanPath.replace('/comunicados/', '/en/news/');
    if (cleanPath === '/directorio') return '/en/directory';
    if (cleanPath.startsWith('/directorio/')) return cleanPath.replace('/directorio/', '/en/directory/');
    if (cleanPath === '/press-kits') return '/en/press-kits';
    if (cleanPath === '/cobertura') return '/en/coverage';
    if (cleanPath === '/archivo') return '/en/archive';
    if (cleanPath === '/sobre-el-sector') return '/en/about';
    if (cleanPath === '/eventos') return '/en/events';
    if (cleanPath.startsWith('/eventos/')) return cleanPath.replace('/eventos/', '/en/events/');
    if (cleanPath === '/acreditaciones') return '/en/accreditation';
    return cleanPath.startsWith('/en') ? cleanPath : `/en${cleanPath}`;
  }

  return pathname;
}

const targetPathEs = alternateUrlEs || getAlternateLanguagePath(currentPath, 'es');
const targetPathEn = alternateUrlEn || getAlternateLanguagePath(currentPath, 'en');
---

<!doctype html>
<html lang={lang} class="bg-paper text-ink">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Astro View Transitions for Instant App-Like Navigation -->
    <ClientRouter />
  </head>
  <body class="bg-paper text-ink antialiased min-h-screen selection:bg-vermilion selection:text-white flex flex-col">
    <!-- Directus Live Preview & Visual Editing Controller -->
    <DirectusLivePreview />

    <div class="flex min-h-screen flex-1">
      <!-- Fixed Left Vertical Rail (Visible on md/lg screens - Swiss Editorial Design) -->
      <aside
        class="hidden md:flex flex-col justify-between items-center w-14 lg:w-16 border-r border-zinc-200 bg-paper py-8 select-none z-30 fixed top-0 bottom-0 left-0"
        aria-label="Barra lateral de navegación y estado"
      >
        <!-- Top: Vertical Brand Title -->
        <div class="pt-2 flex items-center">
          <a
            href={isEn ? '/en' : '/'}
            data-astro-prefetch="hover"
            class="writing-vertical font-mono text-[11px] font-bold tracking-[0.25em] text-zinc-900 hover:text-vermilion transition-colors uppercase whitespace-nowrap flex items-center gap-2"
          >
            <span>MADRID LIVE PRESS</span>
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-vermilion"></span>
          </a>
        </div>

        <!-- Middle: Monogram Indicators -->
        <div class="flex flex-col items-center gap-3 font-mono text-xs font-semibold text-zinc-400">
          <span class="hover:text-zinc-900 transition-colors">N</span>
          <span class="hover:text-zinc-900 transition-colors">R</span>
          <span class="hover:text-zinc-900 transition-colors">A</span>
        </div>

        <!-- Bottom: Language Toggle & Madrid Clock -->
        <div class="flex flex-col items-center gap-6 pb-2">
          <!-- ES / EN Vertical Language Switcher -->
          <div class="writing-vertical font-mono text-[11px] tracking-widest text-zinc-500">
            <a
              href={targetPathEs}
              class={`hover:text-zinc-900 transition-colors ${!isEn ? 'text-zinc-900 font-bold' : 'text-zinc-400'}`}
            >
              ES
            </a>
            <span class="mx-1 text-zinc-300">/</span>
            <a
              href={targetPathEn}
              class={`hover:text-zinc-900 transition-colors ${isEn ? 'text-zinc-900 font-bold' : 'text-zinc-400'}`}
            >
              EN
            </a>
          </div>

          <!-- Madrid Live Clock -->
          <div class="writing-vertical font-mono text-[10px] tracking-widest text-zinc-600 font-medium whitespace-nowrap">
            <span id="madridClock">MAD 12:00</span>
          </div>
        </div>
      </aside>

      <!-- Main Column (Offset by left rail on desktop) -->
      <div class="flex-1 md:pl-14 lg:pl-16 flex flex-col min-w-0 pb-16 md:pb-0">
        <!-- Top Minimalist Navigation Header -->
        <Header lang={lang} alternateUrlEs={targetPathEs} alternateUrlEn={targetPathEn} />

        <!-- Main Page Content -->
        <main class="flex-grow w-full">
          <slot />
        </main>

        <!-- Minimalist Editorial Footer -->
        <Footer lang={lang} />
      </div>
    </div>

    <!-- Fixed Bottom Mobile Navigation Bar (Mobile App Style - 5 Tabs) -->
    <nav
      class="md:hidden fixed bottom-0 left-0 right-0 z-40 bg-paper/95 backdrop-blur-lg border-t border-zinc-200 h-16 flex items-center justify-around px-1 select-none"
      aria-label="Barra de navegación móvil"
    >
      <a
        href={`${prefix}/comunicados`}
        data-astro-prefetch="hover"
        class={`flex flex-col items-center justify-center gap-1 flex-1 py-1 transition-colors active:scale-[0.95] ${
          currentPath.includes('/comunicados') ? 'text-zinc-950 font-bold' : 'text-zinc-500 hover:text-zinc-950'
        }`}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
          <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
        </svg>
        <span class="font-mono text-[8px] uppercase tracking-wider">{isEn ? 'NEWS' : 'NOTICIAS'}</span>
      </a>

      <a
        href={`${prefix}/press-kits`}
        data-astro-prefetch="hover"
        class={`flex flex-col items-center justify-center gap-1 flex-1 py-1 transition-colors active:scale-[0.95] ${
          currentPath.includes('/press-kits') ? 'text-zinc-950 font-bold' : 'text-zinc-500 hover:text-zinc-950'
        }`}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
        </svg>
        <span class="font-mono text-[8px] uppercase tracking-wider">{isEn ? 'KITS' : 'PRESS KITS'}</span>
      </a>

      <a
        href={`${prefix}/directorio`}
        data-astro-prefetch="hover"
        class={`flex flex-col items-center justify-center gap-1 flex-1 py-1 transition-colors active:scale-[0.95] ${
          currentPath.includes('/directorio') ? 'text-zinc-950 font-bold' : 'text-zinc-500 hover:text-zinc-950'
        }`}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <rect x="3" y="3" width="18" height="18" rx="2"></rect>
          <line x1="3" y1="9" x2="21" y2="9"></line>
          <line x1="9" y1="21" x2="9" y2="9"></line>
        </svg>
        <span class="font-mono text-[8px] uppercase tracking-wider">{isEn ? 'VENUES' : 'DIRECTORIO'}</span>
      </a>

      <a
        href={`${prefix}/archivo`}
        data-astro-prefetch="hover"
        class={`flex flex-col items-center justify-center gap-1 flex-1 py-1 transition-colors active:scale-[0.95] ${
          currentPath.includes('/archivo') ? 'text-zinc-950 font-bold' : 'text-zinc-500 hover:text-zinc-950'
        }`}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <polyline points="21 8 21 21 3 21 3 8"></polyline>
          <rect x="1" y="3" width="22" height="5"></rect>
          <line x1="10" y1="12" x2="14" y2="12"></line>
        </svg>
        <span class="font-mono text-[8px] uppercase tracking-wider">{isEn ? 'ARCHIVE' : 'ARCHIVO'}</span>
      </a>

      <a
        href={`${prefix}/sobre-el-sector`}
        data-astro-prefetch="hover"
        class={`flex flex-col items-center justify-center gap-1 flex-1 py-1 transition-colors active:scale-[0.95] ${
          currentPath.includes('/sobre-el-sector') ? 'text-zinc-950 font-bold' : 'text-zinc-500 hover:text-zinc-950'
        }`}
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span class="font-mono text-[8px] uppercase tracking-wider">{isEn ? 'SECTOR' : 'SECTOR'}</span>
      </a>
    </nav>

    <!-- Live Madrid Time Clock Script -->
    <script is:inline>
      function updateMadridTime() {
        try {
          const now = new Date();
          const options = {
            timeZone: 'Europe/Madrid',
            hour: '2-digit',
            minute: '2-digit',
            hour12: false,
          };
          const formatter = new Intl.DateTimeFormat('es-ES', options);
          const timeStr = formatter.format(now);
          const clockElem = document.getElementById('madridClock');
          if (clockElem) {
            clockElem.textContent = `MAD ${timeStr}`;
          }
        } catch (e) {}
      }
      updateMadridTime();
      setInterval(updateMadridTime, 10000);
    </script>
  </body>
</html>
