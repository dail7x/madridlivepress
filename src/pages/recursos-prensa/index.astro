---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import type { RecursoPrensa } from '@/lib/directus';

export const prerender = false;

const catFilter = Astro.url.searchParams.get('cat');

let recursos: RecursoPrensa[] = [];
try {
  const res = await directus.request(
    readItems('recursos_prensa' as any, {
      filter: { status: { _eq: 'published' } },
      fields: ['id', 'titulo', 'categoria_recurso', 'descripcion', 'archivo.*', 'formato', 'peso', 'imagen_previa.*'],
    })
  );
  recursos = (res as any) || [];
} catch (e) {
  console.error('Error in /recursos-prensa:', e);
}

const categories = [
  { label: 'Todos los recursos', value: 'all' },
  { label: 'Logos & Identidad', value: 'logos' },
  { label: 'B-Roll & Vídeo', value: 'b_roll' },
  { label: 'Fotografía Oficial (300 DPI)', value: 'fotografia' },
  { label: 'Informes & Balances', value: 'informes' },
];

const filteredRecursos = catFilter && catFilter !== 'all'
  ? recursos.filter((r) => r.categoria_recurso === catFilter)
  : recursos;
---

<Layout
  title="Media Kits y Recursos Audiovisuales para Medios | Madrid Live Press"
  description="Banco de imágenes en alta resolución (300 DPI), logotipos vectoriales, b-roll de salas y balances económicos de libre uso editorial."
  lang="es"
>
  <div class="w-full bg-paper">
    <!-- Top Monospaced Breadcrumb -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
      <div class="font-mono text-xs text-zinc-400 uppercase tracking-widest flex items-center gap-3">
        <a href="/" class="hover:text-zinc-950 transition-colors">PORTADA</a>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-900 font-semibold">RECURSOS PARA MEDIOS</span>
      </div>
    </div>

    <!-- Header Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 border-b border-zinc-200">
      <div class="space-y-3">
        <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 font-semibold">
          BANCO DE ASSETS MULTIMEDIA · 300 DPI / 4K
        </div>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-zinc-950 tracking-tight">
          Centro de Recursos Gráficos y Audiovisuales
        </h1>
        <p class="font-sans text-base text-zinc-600 max-w-3xl leading-relaxed">
          Materiales oficiales de libre uso periodístico sin royalties para cobertura informativa de la vida nocturna, cultura y festivales de Madrid.
        </p>
      </div>

      <!-- Category Filter Buttons -->
      <div class="flex flex-wrap gap-2 pt-8">
        {categories.map((c) => {
          const isActive = (!catFilter && c.value === 'all') || catFilter === c.value;
          return (
            <a
              href={c.value === 'all' ? '/recursos-prensa' : `/recursos-prensa?cat=${c.value}`}
              class={`font-mono text-xs uppercase px-3 py-1.5 border tracking-wider transition-colors ${
                isActive
                  ? 'border-zinc-900 bg-zinc-900 text-white'
                  : 'border-zinc-200 hover:border-zinc-900 text-zinc-700 hover:text-zinc-950'
              }`}
            >
              {c.label}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Resources Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {filteredRecursos.length === 0 ? (
          <div class="col-span-3 py-16 text-center text-zinc-500 font-sans text-sm">
            No se han encontrado recursos en esta categoría.
          </div>
        ) : (
          filteredRecursos.map((item) => {
            const fileUrl = item.archivo ? getAssetUrl(item.archivo) : '#';
            const preview = item.imagen_previa ? getAssetUrl(item.imagen_previa, { width: 600, height: 400, format: 'webp' }) : null;

            return (
              <article class="border border-zinc-200 bg-paper hover:border-zinc-950 transition-colors flex flex-col justify-between">
                <div>
                  {preview && (
                    <div class="aspect-[16/10] w-full border-b border-zinc-200 overflow-hidden bg-zinc-100">
                      <img
                        src={preview}
                        alt={item.titulo}
                        class="h-full w-full object-cover filter contrast-105"
                        loading="lazy"
                      />
                    </div>
                  )}

                  <div class="p-6 space-y-3">
                    <div class="flex items-center justify-between font-mono text-[11px] text-zinc-500 uppercase tracking-widest">
                      <span class="text-zinc-950 font-semibold">{item.categoria_recurso || 'Asset'}</span>
                      <span>{item.peso || '300 DPI'}</span>
                    </div>

                    <h2 class="font-display text-lg font-bold text-zinc-950">
                      {item.titulo}
                    </h2>

                    {item.descripcion && (
                      <p class="font-sans text-xs text-zinc-600 line-clamp-3 leading-relaxed">
                        {item.descripcion}
                      </p>
                    )}
                  </div>
                </div>

                <div class="p-6 pt-0 border-t border-zinc-100">
                  <a
                    href={fileUrl}
                    download
                    class="inline-flex items-center justify-between w-full font-mono text-xs uppercase tracking-wider font-semibold text-zinc-950 hover:text-vermilion transition-colors"
                  >
                    <span>DESCARGAR PAQUETE</span>
                    <span>↓</span>
                  </a>
                </div>
              </article>
            );
          })
        )}
      </div>
    </div>
  </div>
</Layout>
