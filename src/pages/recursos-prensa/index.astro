---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import { useTranslations } from '@/lib/i18n';
import type { RecursoPrensa } from '@/lib/directus';
import { DownloadCloud, ShieldCheck, FileArchive, ArrowRight } from 'lucide-astro';

export const prerender = false;

const t = useTranslations('es');
const catFilter = Astro.url.searchParams.get('cat');

let recursos: RecursoPrensa[] = [];
try {
  const res = await directus.request(
    readItems('recursos_prensa' as any, {
      filter: { status: { _eq: 'published' } },
      fields: ['id', 'titulo', 'categoria_recurso', 'descripcion', 'archivo.*', 'formato', 'peso', 'imagen_previa.*'],
    })
  );
  recursos = (res as any) || [];
} catch (e) {
  console.error('Error in /recursos-prensa:', e);
}

const categories = [
  { label: 'Todos los recursos', value: 'all' },
  { label: 'Logos & Identidad', value: 'logos' },
  { label: 'B-Roll & Vídeo HD/4K', value: 'b_roll' },
  { label: 'Fotografía Oficial', value: 'fotografia' },
  { label: 'Informes & Estadísticas', value: 'informes' },
  { label: 'Infografías', value: 'infografias' },
];

const filteredRecursos = catFilter && catFilter !== 'all'
  ? recursos.filter((r) => r.categoria_recurso === catFilter)
  : recursos;
---

<Layout
  title="Media Kits y Recursos Audiovisuales de Prensa"
  description="Descarga logotipos oficiales, banco de imágenes 4K, b-roll e informes estadísticos de libre uso editorial."
  lang="es"
>
  <div class="space-y-10">
    <div class="space-y-3 border-b border-white/10 pb-8">
      <div class="inline-flex items-center gap-2 text-amber-400 font-mono text-xs uppercase tracking-widest font-semibold">
        <DownloadCloud class="h-4 w-4" />
        <span>Material Descargable para Medios</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        {t.mediaKit.title}
      </h1>
      <p class="font-sans text-lg text-zinc-300 max-w-3xl">
        {t.mediaKit.subtitle}
      </p>
    </div>

    {/* Filter Buttons */}
    <div class="flex flex-wrap items-center gap-2 pb-2">
      {categories.map((c) => {
        const isSelected = (!catFilter && c.value === 'all') || catFilter === c.value;
        return (
          <a
            href={c.value === 'all' ? '/recursos-prensa' : `/recursos-prensa?cat=${c.value}`}
            class:list={[
              'rounded-full px-4 py-2 font-mono text-xs font-medium transition-all',
              isSelected
                ? 'bg-amber-500 text-black font-bold shadow-md shadow-amber-950/40'
                : 'bg-surface/80 text-zinc-300 border border-white/10 hover:border-white/20 hover:text-white',
            ]}
          >
            {c.label}
          </a>
        );
      })}
    </div>

    {/* Resources Grid */}
    {filteredRecursos.length === 0 ? (
      <div class="rounded-2xl border border-white/10 bg-surface/50 p-12 text-center text-zinc-400">
        No se encontraron recursos para este filtro.
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {filteredRecursos.map((item) => {
          const fileUrl = item.archivo ? getAssetUrl(item.archivo) : '#';
          const preview = item.imagen_previa
            ? getAssetUrl(item.imagen_previa, { width: 600, height: 350, format: 'webp' })
            : null;

          return (
            <div class="group rounded-3xl border border-white/10 bg-surface/80 p-6 flex flex-col justify-between hover:border-white/20 hover:shadow-2xl backdrop-blur-xl transition-all">
              <div class="space-y-4">
                {preview ? (
                  <div class="aspect-video w-full overflow-hidden rounded-2xl bg-black/40 border border-white/5">
                    <img
                      src={preview}
                      alt={item.titulo}
                      class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  </div>
                ) : (
                  <div class="aspect-video w-full rounded-2xl bg-gradient-to-br from-surface to-background border border-white/5 flex items-center justify-center text-amber-400/60">
                    <FileArchive class="h-12 w-12" />
                  </div>
                )}

                <div class="flex items-center justify-between">
                  <span class="rounded-md bg-white/5 px-2.5 py-1 font-mono text-[11px] font-medium uppercase tracking-wider text-rose-300">
                    {item.categoria_recurso || 'Recurso'}
                  </span>
                  <span class="font-mono text-xs text-zinc-400">
                    {item.peso || item.formato || 'ZIP'}
                  </span>
                </div>

                <h2 class="font-display text-xl font-bold text-white group-hover:text-amber-300 transition-colors">
                  {item.titulo}
                </h2>

                {item.descripcion && (
                  <p class="font-sans text-sm text-zinc-400 leading-relaxed">
                    {item.descripcion}
                  </p>
                )}
              </div>

              <div class="pt-6 mt-6 border-t border-white/10 space-y-3">
                <a
                  href={fileUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  download
                  class="inline-flex items-center justify-center gap-2 rounded-xl bg-amber-500 px-5 py-3 font-sans font-bold text-black hover:bg-amber-400 hover:scale-[1.02] shadow-lg shadow-amber-500/20 transition-all w-full"
                >
                  <DownloadCloud class="h-4 w-4" />
                  <span>Descargar Archivo</span>
                </a>

                <div class="flex items-center justify-center gap-1.5 font-mono text-[11px] text-zinc-500">
                  <ShieldCheck class="h-3.5 w-3.5 text-emerald-400" />
                  <span>Uso editorial libre de derechos</span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</Layout>
