---
import Layout from '@/layouts/Layout.astro';
import WireframeHeader from '@/components/ui/WireframeHeader.astro';

export const prerender = false;
---

<Layout
  title="Press Accreditation & Media Desk | Madrid Live Press"
  description="Request official media credentials, press passes, and direct access to NocheMadrid spokespersons and venues."
  lang="en"
>
  <div class="w-full bg-paper pb-16">
    <WireframeHeader
      title="ACCREDITATION"
      subtitle="Official press accreditation office for journalists, media editors, correspondents, and television networks."
      badge="PRESS DESK"
      updatedTime="BILINGUAL SERVICE"
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="max-w-2xl border border-zinc-200 bg-paper p-6 sm:p-8 space-y-6">
        <h2 class="font-display text-2xl font-bold text-zinc-950">
          Request Press Credentials
        </h2>
        <form class="space-y-4 font-mono text-xs">
          <div>
            <label class="block text-zinc-600 uppercase mb-1">Full Name *</label>
            <input type="text" required placeholder="Jane Doe" class="w-full border border-zinc-200 p-2.5 bg-paper text-zinc-950 focus:border-zinc-950 outline-none" />
          </div>
          <div>
            <label class="block text-zinc-600 uppercase mb-1">Media Outlet / Publication *</label>
            <input type="text" required placeholder="The Guardian / Billboard / BBC" class="w-full border border-zinc-200 p-2.5 bg-paper text-zinc-950 focus:border-zinc-950 outline-none" />
          </div>
          <div>
            <label class="block text-zinc-600 uppercase mb-1">Corporate Email *</label>
            <input type="email" required placeholder="journalist@newsroom.com" class="w-full border border-zinc-200 p-2.5 bg-paper text-zinc-950 focus:border-zinc-950 outline-none" />
          </div>
          <div>
            <label class="block text-zinc-600 uppercase mb-1">Coverage Scope / Request Details</label>
            <textarea rows="3" placeholder="Interviews with spokespersons, event pass, venue photography..." class="w-full border border-zinc-200 p-2.5 bg-paper text-zinc-950 focus:border-zinc-950 outline-none"></textarea>
          </div>
          <button type="submit" class="w-full bg-zinc-950 hover:bg-vermilion text-white font-bold py-3 uppercase tracking-wider transition-colors">
            Submit Accreditation Request ↗
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
