---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import type { Comunicado, Categoria } from '@/lib/directus';
import '@/styles/global.css';

export const prerender = false;

let allItems: Comunicado[] = [];
let categorias: Categoria[] = [];

try {
  const [articulosRes, categoriasRes] = await Promise.all([
    directus.request(
      readItems('comunicados' as any, {
        filter: { 
          status: { _eq: 'published' },
          categoria: { _neq: 1 } // Exclude Press Releases
        },
        sort: ['-fecha_publicacion', '-id'],
        limit: 50,
        fields: [
          'id',
          'status',
          'fecha_publicacion',
          'slug',
          'slug_en',
          'titulo',
          'titulo_en',
          'bajada',
          'bajada_en',
          'imagen_url_externa',
          'imagen_portada.*',
          'archivo_pdf.*',
          'tags',
          { categoria: ['id', 'nombre', 'nombre_en', 'slug', 'slug_en', 'color'] },
        ],
      })
    ),
    directus.request(
      readItems('categorias' as any, {
        filter: {
          id: { _neq: 1 }
        },
        fields: ['id', 'nombre', 'nombre_en', 'slug', 'slug_en', 'color'],
        sort: ['nombre'],
      })
    ),
  ]);

  allItems = (articulosRes as any) || [];
  categorias = (categoriasRes as any) || [];
} catch (e) {
  console.error('Error loading /en/articles:', e);
}

const articulos = allItems;

const DEFAULT_IMAGES = [
  'https://images.unsplash.com/photo-1514306191717-452ec28c7814?q=80&w=1200&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1539037116277-4db20889f2d4?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1513694203232-719a280e022f?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1507676184212-d03ab07a01bf?q=80&w=800&auto=format&fit=crop',
];

const featuredItem = articulos[0] || null;
const stackedItems = articulos.slice(1, 4);
const allRemainingItems = articulos.slice(4);
---

<Layout
  title="Madrid Stories & Culture | Noche Madrid Press"
  description="Live music, festivals, afternoon culture, and Madrid's world-leading nightlife appeal."
  lang="en"
>
  <div class="w-full bg-paper">
    <!-- Top Wireframe Header "ARTICLES" -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6">
      <div class="flex items-center justify-between gap-3 p-3 bg-zinc-50 border border-zinc-200 text-xs mb-3">
        <div class="flex items-center gap-2">
          <span class="inline-block w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
          <span class="font-mono text-zinc-900 font-bold uppercase tracking-wider">Madrid Stories · Public Articles</span>
          <span class="text-zinc-400 hidden sm:inline">|</span>
          <span class="text-zinc-600 hidden sm:inline">Concerts, festival reports, trends, and nocturnal lifestyle.</span>
        </div>
        <a 
          href="/en/news" 
          class="font-mono text-xs font-bold text-zinc-900 hover:text-emerald-700 underline flex items-center gap-1 transition-colors"
        >
          View Official Press Releases →
        </a>
      </div>

      <div class="w-full h-12 sm:h-16 lg:h-20 overflow-hidden flex items-end select-none pointer-events-none">
        <span class="font-display font-black text-4xl sm:text-6xl lg:text-[6.5rem] tracking-tight leading-none text-wireframe block translate-y-2 sm:translate-y-4">
          ARTICLES
        </span>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pt-2 pb-3 border-b border-zinc-200">
        <p class="font-sans text-xs sm:text-sm text-zinc-700 font-medium">
          Live music, festivals, afternoon culture, and Madrid's world-leading nightlife appeal.
        </p>

        <div class="font-mono text-[11px] sm:text-xs text-zinc-500 uppercase tracking-wider flex items-center gap-2 flex-shrink-0">
          <span id="newsTotalCount" class="font-bold text-zinc-950">{articulos.length} STORIES</span>
          <span class="text-zinc-300">·</span>
          <span>MADRID LIVE</span>
        </div>
      </div>
    </div>

    <!-- Category Filter Bar -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 border-b border-zinc-200">
      <div class="flex items-center justify-between gap-4 flex-wrap">
        <div class="flex items-center gap-4 sm:gap-6 overflow-x-auto no-scrollbar font-sans text-xs text-zinc-600 font-medium py-1" id="newsCatFilters">
          <button
            type="button"
            class="cat-filter-btn flex items-center gap-1.5 whitespace-nowrap text-zinc-950 font-bold is-active"
            data-cat="all"
          >
            <span>All</span>
            <span class="dot w-1.5 h-1.5 rounded-full bg-emerald-600 inline-block"></span>
          </button>

          {categorias.map((cat) => (
            <button
              type="button"
              class="cat-filter-btn flex items-center gap-1.5 whitespace-nowrap text-zinc-600 hover:text-zinc-950 transition-colors"
              data-cat={cat.slug_en || cat.slug}
            >
              <span>{cat.nombre_en || cat.nombre}</span>
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      {featuredItem && (
        <div class="news-item-card">
          <a
            href={`/en/articles/${featuredItem.slug_en || featuredItem.slug}`}
            class="group block border border-zinc-200 bg-paper hover:border-zinc-950 transition-all"
          >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-0">
              <div class="lg:col-span-7 aspect-[16/9] lg:aspect-auto min-h-[280px] lg:min-h-[360px] overflow-hidden bg-zinc-100 border-b lg:border-b-0 lg:border-r border-zinc-200">
                <img
                  src={(featuredItem as any).imagen_url_externa || (featuredItem.imagen_portada ? getAssetUrl(featuredItem.imagen_portada) : DEFAULT_IMAGES[0])}
                  alt={featuredItem.titulo_en || featuredItem.titulo}
                  class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
              </div>
              <div class="lg:col-span-5 p-6 sm:p-8 flex flex-col justify-between">
                <div>
                  <div class="flex items-center gap-2 mb-3 font-mono text-xs text-zinc-500 uppercase">
                    <span class="text-emerald-700 font-bold">FEATURED STORY</span>
                    <span>·</span>
                    <span>{(featuredItem.categoria as Categoria)?.nombre_en || (featuredItem.categoria as Categoria)?.nombre}</span>
                  </div>
                  <h2 class="font-display font-bold text-2xl sm:text-3xl text-zinc-950 group-hover:text-emerald-700 transition-colors leading-tight mb-4">
                    {featuredItem.titulo_en || featuredItem.titulo}
                  </h2>
                  <p class="font-sans text-sm text-zinc-600 leading-relaxed line-clamp-4">
                    {featuredItem.bajada_en || featuredItem.bajada}
                  </p>
                </div>
                <div class="pt-6 border-t border-zinc-100 font-mono text-xs font-bold text-zinc-950 flex items-center justify-between">
                  <span>READ STORY →</span>
                  <span class="text-zinc-400">MADRID LIVE</span>
                </div>
              </div>
            </div>
          </a>
        </div>
      )}

      <!-- Remaining Items Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 pt-6 border-t border-zinc-200">
        {[...stackedItems, ...allRemainingItems].map((item, idx) => {
          const imgUrl = (item as any).imagen_url_externa || (item.imagen_portada ? getAssetUrl(item.imagen_portada) : DEFAULT_IMAGES[(idx + 1) % DEFAULT_IMAGES.length]);
          return (
            <article class="border border-zinc-200 bg-white hover:border-zinc-950 transition-all flex flex-col justify-between group">
              <a href={`/en/articles/${item.slug_en || item.slug}`} class="block flex-1">
                <div class="aspect-[16/10] overflow-hidden bg-zinc-100 border-b border-zinc-200">
                  <img src={imgUrl} alt={item.titulo_en || item.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" />
                </div>
                <div class="p-5 space-y-2">
                  <div class="font-mono text-[10px] text-zinc-500 uppercase">
                    {(item.categoria as Categoria)?.nombre_en || (item.categoria as Categoria)?.nombre}
                  </div>
                  <h3 class="font-display font-bold text-base text-zinc-950 group-hover:text-emerald-700 transition-colors line-clamp-2">
                    {item.titulo_en || item.titulo}
                  </h3>
                  <p class="font-sans text-xs text-zinc-600 line-clamp-3">
                    {item.bajada_en || item.bajada}
                  </p>
                </div>
              </a>
              <div class="p-5 pt-0 border-t border-zinc-100 font-mono text-xs font-bold text-zinc-950 mt-auto flex justify-end">
                <a href={`/en/articles/${item.slug_en || item.slug}`} class="hover:text-emerald-700">
                  Read →
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</Layout>
