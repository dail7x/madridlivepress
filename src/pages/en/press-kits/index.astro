---
import Layout from '@/layouts/Layout.astro';
import WireframeHeader from '@/components/ui/WireframeHeader.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import type { RecursoPrensa } from '@/lib/directus';

export const prerender = false;

let recursos: RecursoPrensa[] = [];
try {
  const res = await directus.request(
    readItems('recursos_prensa' as any, {
      filter: { status: { _eq: 'published' } },
      sort: ['-id'],
      limit: 24,
      fields: [
        'id',
        'status',
        'titulo',
        'titulo_en',
        'descripcion',
        'descripcion_en',
        'tipo_recurso',
        'resolucion_formato',
        'tamano_mb',
        'archivo.*',
        'miniatura.*',
        'derechos_creditos',
      ],
    })
  );
  recursos = (res as any) || [];
} catch (e) {
  console.error('Error loading /en/press-kits:', e);
}

const DEFAULT_KIT_THUMBS = [
  '/images/press/abc-clipping.jpg',
  '/images/press/elmundo-clipping.jpg',
  '/images/press/hosteltur-clipping.jpg',
  '/images/press/telemadrid-clipping.jpg',
];
---

<Layout
  title="Press Kits & Official Editorial Media Assets | Madrid Live Press"
  description="Download official high-resolution photography, 4K b-roll footage, statistical dossiers and vector brand assets for newsrooms."
  lang="en"
>
  <div class="w-full bg-paper">
    <WireframeHeader
      title="PRESS KITS"
      subtitle="Official media assets, 4K b-roll footage, high-resolution photography, and technical dossiers ready for editorial use."
      badge="PRESS ASSETS"
      updatedTime="HIGH RESOLUTION · BILINGUAL"
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {recursos.map((kit, index) => {
          const thumb = kit.miniatura
            ? getAssetUrl(kit.miniatura, { width: 600, height: 400, format: 'webp' })
            : DEFAULT_KIT_THUMBS[index % DEFAULT_KIT_THUMBS.length];
          const fileUrl = kit.archivo ? getAssetUrl(kit.archivo) : thumb;
          const kitTitle = kit.titulo_en || kit.titulo;
          const kitDesc = kit.descripcion_en || kit.descripcion;

          return (
            <div class="border border-zinc-200 bg-paper p-5 flex flex-col justify-between space-y-4 hover:border-zinc-950 transition-colors">
              <div class="space-y-3">
                <div class="aspect-[16/10] overflow-hidden bg-zinc-100 border border-zinc-200">
                  <img src={thumb} alt={kitTitle} class="w-full h-full object-cover filter contrast-105" />
                </div>
                <div class="flex items-center justify-between font-mono text-[10px] text-zinc-500 uppercase">
                  <span>{kit.resolucion_formato || 'HIGH RESOLUTION'}</span>
                  {kit.tamano_mb && <span>{kit.tamano_mb} MB</span>}
                </div>
                <h3 class="font-display text-base font-bold text-zinc-950 leading-snug">{kitTitle}</h3>
                {kitDesc && (
                  <p class="font-sans text-xs text-zinc-600 leading-relaxed line-clamp-2">
                    {kitDesc}
                  </p>
                )}
              </div>
              <a href={fileUrl} target="_blank" download class="w-full bg-zinc-950 hover:bg-vermilion text-white font-mono text-xs uppercase font-bold py-2.5 px-4 text-center transition-colors">
                Download Kit ↓
              </a>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</Layout>
