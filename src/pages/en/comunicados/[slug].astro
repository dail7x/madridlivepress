---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import type { Comunicado, Categoria, Portavoz } from '@/lib/directus';

export const prerender = false;

const { slug } = Astro.params;

let item: Comunicado | null = null;
try {
  const res = await directus.request(
    readItems('comunicados' as any, {
      filter: { slug: { _eq: slug }, status: { _eq: 'published' } },
      fields: [
        'id',
        'status',
        'fecha_publicacion',
        'slug',
        'titulo',
        'bajada',
        'cuerpo',
        'imagen_portada.*',
        'archivo_pdf.*',
        'tags',
        { categoria: ['id', 'nombre', 'slug', 'color'] },
        { portavoz: ['id', 'nombre', 'cargo', 'bio'] },
      ],
      limit: 1,
    })
  );
  item = ((res as any) && (res as any)[0]) || null;
} catch (e) {}

if (!item) {
  return Astro.redirect('/en/404');
}

const pubDate = item.fecha_publicacion ? new Date(item.fecha_publicacion) : new Date();
const formattedDate = pubDate.toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
const heroImg = item.imagen_portada ? getAssetUrl(item.imagen_portada, { quality: 90, format: 'webp' }) : 'https://images.unsplash.com/photo-1507676184212-d03ab07a01bf?q=80&w=1200&auto=format&fit=crop';
---

<Layout
  title={`${item.titulo} | Madrid Live Press`}
  description={item.bajada || item.titulo}
  image={heroImg}
  lang="en"
>
  <article class="w-full bg-paper pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-8 pb-4">
      <div class="font-mono text-[11px] sm:text-xs text-zinc-600 uppercase tracking-widest flex items-center gap-2">
        <a href="/en/comunicados" class="hover:text-zinc-950">PRESS RELEASE</a>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-900 font-bold">NP-04{String(item.id || 1).padStart(2, '0')}</span>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-7 space-y-6">
          <div class="font-mono text-xs uppercase tracking-wider text-zinc-500">
            <span>PUBLISHED · {formattedDate} · 10:30 CET</span>
          </div>

          <h1 class="font-display text-2xl sm:text-4xl lg:text-5xl font-bold text-zinc-950 leading-tight">
            {item.titulo}
          </h1>

          {item.bajada && (
            <p class="font-sans text-base sm:text-lg text-zinc-700 leading-relaxed">
              {item.bajada}
            </p>
          )}

          <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-zinc-200 font-mono text-xs">
            <button onclick="window.print()" class="bg-vermilion hover:bg-rose-700 text-white font-bold py-3 px-6 uppercase tracking-wider transition-colors active:scale-[0.98]">
              ↓ Download PDF Release ↓
            </button>
            <a href="/en/press-kits" class="border border-zinc-950 hover:bg-zinc-100 text-zinc-950 font-bold py-3 px-6 uppercase tracking-wider">
              Official Media Kit ↗
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="border border-zinc-200 aspect-[4/3] w-full overflow-hidden bg-zinc-100">
            <img src={heroImg} alt={item.titulo} class="w-full h-full object-cover filter contrast-105" />
          </div>
          <div class="font-mono text-[10px] text-zinc-400 pt-2">© Madrid Live Press / Official Archive</div>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 border-t border-zinc-200 mt-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-8 prose prose-zinc max-w-none font-sans text-base leading-relaxed text-zinc-800 space-y-4">
          <p class="font-bold text-zinc-950">MADRID, {formattedDate}.—</p>
          {item.cuerpo ? <div set:html={item.cuerpo} /> : <p>Official press release issued by NocheMadrid.</p>}
        </div>

        <div class="lg:col-span-4 border border-zinc-200 p-6 bg-canvas space-y-3 font-mono text-xs">
          <div class="font-bold text-zinc-950 uppercase">OFFICIAL SOURCE ✓</div>
          <div class="text-zinc-600">NOCHEMADRID · Associated Venues Federation</div>
          <div class="pt-2 text-zinc-500">prensa@nochemadrid.org</div>
        </div>
      </div>
    </div>
  </article>
</Layout>
