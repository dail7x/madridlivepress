---
import Layout from '@/layouts/Layout.astro';
import WireframeHeader from '@/components/ui/WireframeHeader.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import type { Comunicado, Categoria } from '@/lib/directus';

export const prerender = false;

let comunicados: Comunicado[] = [];
let categorias: Categoria[] = [];

try {
  const [comunicadosRes, categoriasRes] = await Promise.all([
    directus.request(
      readItems('comunicados' as any, {
        filter: { status: { _eq: 'published' } },
        sort: ['-fecha_publicacion', '-id'],
        limit: 50,
        fields: [
          'id',
          'status',
          'fecha_publicacion',
          'slug',
          'titulo',
          'bajada',
          'imagen_portada.*',
          'archivo_pdf.*',
          'tags',
          { categoria: ['id', 'nombre', 'slug', 'color'] },
          { portavoz: ['id', 'nombre', 'cargo'] },
        ],
      })
    ),
    directus.request(
      readItems('categorias' as any, {
        fields: ['id', 'nombre', 'slug', 'color'],
        sort: ['nombre'],
      })
    ),
  ]);

  comunicados = (comunicadosRes as any) || [];
  categorias = (categoriasRes as any) || [];
} catch (e) {
  console.error('Error loading /en/comunicados:', e);
}

const DEFAULT_IMAGES = [
  'https://images.unsplash.com/photo-1514306191717-452ec28c7814?q=80&w=1200&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1539037116277-4db20889f2d4?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1513694203232-719a280e022f?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1585829365295-ab7cd400c167?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1507676184212-d03ab07a01bf?q=80&w=800&auto=format&fit=crop',
];

const featuredItem = comunicados[0] || null;
const stackedItems = comunicados.slice(1, 4);
const allRemainingItems = comunicados.slice(4);
---

<Layout
  title="News & Official Press Releases | Madrid Live Press"
  description="Madrid’s cultural pulse, verified and ready to publish. Official press office of NocheMadrid."
  lang="en"
>
  <div class="w-full bg-paper">
    <!-- Top Wireframe Header "NEWS" (Giant English Title) -->
    <WireframeHeader
      title="NEWS"
      subtitle="Madrid’s cultural pulse, verified and ready to publish."
      badge={`${comunicados.length} RESULTS`}
      updatedTime="LIVE 12:38 CET"
    />

    <!-- Category Filter Bar -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 border-b border-zinc-200">
      <div class="flex items-center justify-between gap-4 flex-wrap">
        <div class="flex items-center gap-4 sm:gap-6 overflow-x-auto no-scrollbar font-sans text-xs text-zinc-600 font-medium py-1" id="enNewsCatFilters">
          <button type="button" class="en-cat-btn flex items-center gap-1.5 text-zinc-950 font-bold is-active" data-cat="all">
            <span>All</span>
            <span class="dot w-1.5 h-1.5 rounded-full bg-vermilion inline-block"></span>
          </button>
          <button type="button" class="en-cat-btn text-zinc-600 hover:text-zinc-950" data-cat="artes-escenicas">Performing Arts</button>
          <button type="button" class="en-cat-btn text-zinc-600 hover:text-zinc-950" data-cat="institucional-economia">Economy & Institutions</button>
          <button type="button" class="en-cat-btn text-zinc-600 hover:text-zinc-950" data-cat="festivales-conciertos">Concerts & Festivals</button>
          <button type="button" class="en-cat-btn text-zinc-600 hover:text-zinc-950" data-cat="estudios-tendencias">Studies & Trends</button>
        </div>

        <div class="flex items-center gap-4 font-mono text-xs text-zinc-600 flex-shrink-0">
          <select id="enNewsSortSelect" class="bg-transparent border-0 font-mono text-xs text-zinc-800 font-semibold cursor-pointer">
            <option value="desc">Most recent ↓</option>
            <option value="asc">Oldest ↑</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        {featuredItem && (
          <div class="lg:col-span-7">
            <a
              href={`/en/comunicados/${featuredItem.slug}`}
              data-astro-prefetch="hover"
              class="group block border border-zinc-200 bg-paper hover:border-zinc-950 transition-all active:scale-[0.99]"
            >
              <div class="aspect-[21/9] sm:aspect-[16/8] max-h-56 lg:max-h-64 w-full overflow-hidden bg-zinc-100 border-b border-zinc-200">
                <img
                  src={featuredItem.imagen_portada ? getAssetUrl(featuredItem.imagen_portada, { width: 900, height: 400, format: 'webp' }) : DEFAULT_IMAGES[0]}
                  alt={featuredItem.titulo}
                  class="h-full w-full object-cover filter contrast-105 group-hover:scale-[1.02] transition-transform duration-500"
                />
              </div>

              <div class="p-4 sm:p-6 space-y-2">
                <div class="font-mono text-[10px] uppercase tracking-wider text-zinc-500 flex items-center gap-2">
                  <span class="text-zinc-950 font-bold">COVER STORY</span>
                  <span class="text-zinc-300">·</span>
                  <span>PERFORMING ARTS</span>
                </div>

                <h2 class="font-display text-xl sm:text-2xl font-bold text-zinc-950 leading-snug group-hover:text-vermilion transition-colors">
                  {featuredItem.titulo}
                </h2>

                <p class="font-sans text-xs text-zinc-600 line-clamp-2 leading-relaxed">
                  {featuredItem.bajada}
                </p>

                <div class="flex items-center justify-between pt-2 border-t border-zinc-100 font-mono text-[10px] text-zinc-500">
                  <div class="flex items-center gap-2">
                    <span class="text-zinc-900 font-semibold">
                      {new Date(featuredItem.fecha_publicacion).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase()}
                    </span>
                    <span class="text-zinc-300">·</span>
                    <span>PRESS KIT</span>
                    <span class="text-zinc-300">·</span>
                    <span>HIGH RESOLUTION</span>
                  </div>
                  <span class="text-zinc-950 text-base font-bold group-hover:translate-x-1 transition-transform">→</span>
                </div>
              </div>
            </a>
          </div>
        )}

        <div class="lg:col-span-5 space-y-3">
          {stackedItems.map((item, idx) => {
            const dateStr = new Date(item.fecha_publicacion).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
            return (
              <a
                href={`/en/comunicados/${item.slug}`}
                data-astro-prefetch="hover"
                class="group block border border-zinc-200 bg-paper p-3 hover:border-zinc-950 transition-all active:scale-[0.99]"
              >
                <div class="grid grid-cols-12 gap-3 items-center">
                  <div class="col-span-4 aspect-[4/3] overflow-hidden bg-zinc-100 border border-zinc-200">
                    <img src={DEFAULT_IMAGES[idx + 1]} alt={item.titulo} class="h-full w-full object-cover filter contrast-105" />
                  </div>
                  <div class="col-span-8 space-y-1">
                    <div class="font-mono text-[9px] uppercase tracking-wider text-zinc-500">{dateStr}</div>
                    <h3 class="font-display text-xs sm:text-sm font-bold text-zinc-950 leading-snug group-hover:text-vermilion transition-colors line-clamp-2">
                      {item.titulo}
                    </h3>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>

      <!-- Lower list -->
      <div class="border-t border-zinc-200 pt-8 grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6">
        {allRemainingItems.map((item, index) => {
          const num = String(index + 4).padStart(2, '0');
          const dateStr = new Date(item.fecha_publicacion).toLocaleDateString('en-US', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
          return (
            <a
              href={`/en/comunicados/${item.slug}`}
              data-astro-prefetch="hover"
              class="group block pb-5 border-b border-zinc-200 hover:border-zinc-950 transition-colors"
            >
              <div class="flex items-start gap-4">
                <span class="font-mono text-base font-bold text-zinc-400 group-hover:text-zinc-950">{num}</span>
                <div class="flex-1 space-y-1">
                  <div class="font-mono text-[10px] text-zinc-500 uppercase">{dateStr} · PRESS RELEASE</div>
                  <h4 class="font-display text-sm font-medium text-zinc-900 group-hover:text-vermilion">{item.titulo}</h4>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</Layout>
