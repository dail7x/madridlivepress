---
import Layout from '@/layouts/Layout.astro';
import WireframeHeader from '@/components/ui/WireframeHeader.astro';
import BlockPressMentions from '@/components/blocks/BlockPressMentions.astro';
import { COBERTURA_TOTAL, mediosCobertura } from '@/data/cobertura';

export const prerender = false;

const medios = mediosCobertura();
---

<Layout
  title="Media Coverage & Press Clipping | Noche Madrid Press"
  description="2026 press pieces that cite Noche Madrid: outlet, headline, date, and a link to the source note."
  lang="en"
>
  <div class="w-full bg-paper pb-16">
    <WireframeHeader
      title="COVERAGE"
      subtitle="2026 press pieces that cite Noche Madrid, newest first."
      badge="2026 CLIPPING"
      updatedTime={`${COBERTURA_TOTAL} PIECES`}
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
      <ul class="border border-zinc-200 bg-canvas p-6 flex flex-wrap items-center gap-x-5 gap-y-2 font-mono text-[11px] font-bold uppercase tracking-wider text-zinc-500">
        {medios.map((medio) => (
          <li class="hover:text-zinc-950 transition-colors">{medio}</li>
        ))}
      </ul>

      <BlockPressMentions lang="en" />
    </div>
  </div>
</Layout>
