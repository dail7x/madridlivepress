---
import Layout from '@/layouts/Layout.astro';
import WireframeHeader from '@/components/ui/WireframeHeader.astro';

export const prerender = false;
---

<Layout
  title="Media Agenda & Press Calls | Madrid Live Press"
  description="Official schedule of press conferences, media calls, and presentations for accredited journalists."
  lang="en"
>
  <div class="w-full bg-paper pb-16">
    <WireframeHeader
      title="MEDIA AGENDA"
      subtitle="Official calendar of press conferences, media calls, and sector presentations for accredited journalists."
      badge="UPCOMING CALL"
      updatedTime="OCTOBER 2026"
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
      <a
        href="/en/eventos/conferencia-anual-nochemadrid-2026"
        data-astro-prefetch="hover"
        class="group block border-2 border-zinc-950 bg-paper hover:bg-canvas transition-all p-6 sm:p-8 space-y-6 active:scale-[0.99]"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-4">
          <div class="flex items-center gap-3">
            <span class="w-3 h-3 rounded-full bg-vermilion inline-block animate-pulse"></span>
            <span class="font-mono text-xs font-bold text-zinc-950 uppercase tracking-wider">
              OFFICIAL PRESS CONFERENCE · MAIN MEDIA CALL
            </span>
          </div>
          <div class="font-mono text-xs text-vermilion font-bold uppercase tracking-wider">
            ✓ PRESS ACCREDITATION OPEN
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          <div class="lg:col-span-8 space-y-3">
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-zinc-950 group-hover:text-vermilion transition-colors leading-tight">
              Annual Nightlife Conference & NocheMadrid 2026 Awards
            </h2>
            <p class="font-sans text-sm sm:text-base text-zinc-700 leading-relaxed">
              Presentation of the Annual Economic Impact Report, cultural innovation awards ceremony, and international panel on Madrid's nightlife projection across Europe.
            </p>
          </div>

          <div class="lg:col-span-4 bg-paper p-4 border border-zinc-200 font-mono text-xs space-y-2">
            <div class="text-zinc-500 uppercase text-[10px]">Date & Time:</div>
            <div class="font-bold text-zinc-950 text-sm">Thursday, October 15, 2026 · 11:00 CET</div>
            <div class="text-zinc-500 uppercase text-[10px] pt-1">Venue:</div>
            <div class="text-zinc-800 font-medium">Teatro Eslava (Calle Arenal, 11, Madrid)</div>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-zinc-200 font-mono text-xs">
          <div class="text-zinc-500">Press passes for newsrooms, broadcasters, and photographers.</div>
          <div class="font-bold text-zinc-950 group-hover:text-vermilion uppercase flex items-center gap-1">
            <span>View Event Specs & Request Pass →</span>
          </div>
        </div>
      </a>
    </div>
  </div>
</Layout>
