---
import Layout from '@/layouts/Layout.astro';

export const prerender = false;

const { slug } = Astro.params;
---

<Layout
  title="Annual Nightlife Conference & Awards 2026 | Madrid Live Press"
  description="Official press call sheet, media pass request, and briefing for the Annual Nightlife Conference."
  lang="en"
>
  <article class="w-full bg-paper pb-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-8 pb-4">
      <div class="font-mono text-[11px] sm:text-xs text-zinc-600 uppercase tracking-widest flex items-center gap-2">
        <a href="/en/eventos" class="hover:text-zinc-950">MEDIA CALLS</a>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-950 font-bold">EVENT-01</span>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-7 space-y-6">
          <h1 class="font-display text-3xl sm:text-5xl font-bold text-zinc-950 leading-tight">
            Annual Nightlife Conference & NocheMadrid 2026 Awards
          </h1>
          <p class="font-sans text-base text-zinc-700 leading-relaxed">
            The NocheMadrid press office invites international journalists, cultural editors, television crews, and digital media to the presentation of the 2025-2026 Annual Economic Report and cultural excellence awards.
          </p>
          <div class="pt-4 border-t border-zinc-200 font-mono text-xs">
            <a href="/en/acreditaciones" class="bg-vermilion text-white font-bold py-3.5 px-6 uppercase tracking-wider">
              Request Press Accreditation ↗
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 border-2 border-zinc-950 p-6 bg-canvas space-y-3 font-mono text-xs">
          <div class="font-bold uppercase text-zinc-950">EVENT DETAILS</div>
          <div>Date: Thursday, October 15, 2026 · 11:00 CET</div>
          <div>Venue: Teatro Eslava (Calle Arenal, 11, Madrid)</div>
          <div>Media contact: prensa@nochemadrid.org</div>
        </div>
      </div>
    </div>
  </article>
</Layout>
