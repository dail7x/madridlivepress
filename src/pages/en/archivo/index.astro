---
import Layout from '@/layouts/Layout.astro';
import WireframeHeader from '@/components/ui/WireframeHeader.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import type { Comunicado } from '@/lib/directus';

export const prerender = false;

let items: Comunicado[] = [];
try {
  const res = await directus.request(
    readItems('comunicados' as any, {
      filter: { status: { _eq: 'published' } },
      sort: ['-fecha_publicacion', '-id'],
      limit: 50,
      fields: ['id', 'status', 'fecha_publicacion', 'slug', 'titulo', 'bajada', 'imagen_portada.*'],
    })
  );
  items = (res as any) || [];
} catch (e) {}
---

<Layout
  title="Historical & Media Archive | Madrid Live Press"
  description="Comprehensive digital repository of press releases, official photographs, statistical reports, and dossiers from Madrid nightlife."
  lang="en"
>
  <div class="w-full bg-paper">
    <WireframeHeader
      title="ARCHIVE"
      subtitle="Everything published. Everything you need to tell the story again."
      badge="1,284 ITEMS"
      updatedTime="2023—2026"
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="border-b border-zinc-200 pb-2 mb-6">
        <input
          id="enArchiveSearch"
          type="text"
          placeholder="Search by topic, venue, date or spokesperson..."
          class="w-full bg-transparent font-sans text-lg text-zinc-950 placeholder:text-zinc-400 focus:outline-none"
        />
      </div>

      <div class="divide-y divide-zinc-200 font-mono text-xs" id="enArchiveRows">
        {items.map((item, idx) => {
          const dateStr = new Date(item.fecha_publicacion).toLocaleDateString('en-US', { day: '2-digit', month: 'short' }).toUpperCase();
          const typeLabel = idx % 2 === 0 ? 'PRESS RELEASE' : 'INDUSTRY REPORT';

          return (
            <div class="en-archive-row py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 group hover:bg-canvas">
              <div class="flex items-center gap-6">
                <span class="font-bold text-zinc-950 w-16">{dateStr}</span>
                <span class="text-zinc-500 uppercase text-[10px] w-28">{typeLabel}</span>
                <a href={`/en/comunicados/${item.slug}`} class="font-sans font-medium text-sm text-zinc-950 group-hover:text-vermilion transition-colors">
                  {item.titulo}
                </a>
              </div>
              <div class="flex items-center gap-4 text-[11px] text-zinc-500">
                <span>PDF · HIGH RES</span>
                <a href={`/en/comunicados/${item.slug}`} class="font-bold text-zinc-950 hover:text-vermilion">VIEW ↗</a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>

  <script is:inline>
    function setupEnArchive() {
      const input = document.getElementById('enArchiveSearch');
      const rows = document.querySelectorAll('.en-archive-row');
      input?.addEventListener('input', (e) => {
        const q = (e.target.value || '').toLowerCase();
        rows.forEach((r) => {
          r.style.display = r.textContent.toLowerCase().includes(q) ? 'flex' : 'none';
        });
      });
    }
    document.addEventListener('astro:page-load', setupEnArchive);
    setupEnArchive();
  </script>
</Layout>
