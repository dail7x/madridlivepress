---
import Layout from '@/layouts/Layout.astro';
import WireframeHeader from '@/components/ui/WireframeHeader.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import type { Sala } from '@/lib/directus';

export const prerender = false;

let salas: Sala[] = [];
try {
  const res = await directus.request(
    readItems('salas' as any, {
      filter: { status: { _eq: 'published' } },
      sort: ['nombre'],
      limit: -1,
      fields: [
        'id',
        'status',
        'nombre',
        'slug',
        'direccion',
        'distrito',
        'tipo_espacio',
        'aforo',
        'descripcion',
        'imagen_portada.*',
        'sitio_web',
        'instagram_url',
      ],
    })
  );
  salas = (res as any) || [];
} catch (e) {
  console.error('Error loading /en/directorio:', e);
}

const DEFAULT_VENUE_PHOTOS = [
  'https://images.unsplash.com/photo-1514306191717-452ec28c7814?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1574391884720-bbc3740c59d1?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1507676184212-d03ab07a01bf?q=80&w=800&auto=format&fit=crop',
];
---

<Layout
  title="Official Venues & Clubs Directory | Madrid Live Press"
  description="Official directory of associated spaces federated in NocheMadrid: concert halls, nightclubs, musical theaters, flamenco tablaos, and special cultural venues."
  lang="en"
>
  <div class="w-full bg-paper">
    <WireframeHeader
      title="DIRECTORY"
      subtitle="Official Directory of Madrid’s Nightlife, Performing Arts & Entertainment Sector (Associated Spaces)."
      badge={`${salas.length} ASSOCIATED SPACES`}
      updatedTime="NOCHEMADRID"
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {salas.map((sala, index) => {
          const photoUrl = sala.imagen_portada
            ? getAssetUrl(sala.imagen_portada, { width: 600, height: 400, format: 'webp' })
            : DEFAULT_VENUE_PHOTOS[index % DEFAULT_VENUE_PHOTOS.length];
          const monogram = sala.nombre.split(' ').map((n) => n[0]).slice(0, 2).join('').toUpperCase();
          const instaUrl = (sala as any).instagram_url || 'https://www.instagram.com/nochemadrid/';

          return (
            <div class="border border-zinc-200 bg-paper p-5 flex flex-col justify-between space-y-4 hover:border-zinc-950 transition-colors">
              <div class="space-y-3">
                <div class="relative aspect-[16/10] overflow-hidden bg-zinc-100 border border-zinc-200">
                  <img src={photoUrl} alt={sala.nombre} class="w-full h-full object-cover filter contrast-105" loading="lazy" />
                  <div class="absolute top-3 left-3 bg-paper/95 px-2 py-0.5 font-mono text-[10px] font-bold uppercase">{monogram}</div>
                  <div class="absolute top-3 right-3 bg-zinc-950 text-white px-2 py-0.5 font-mono text-[9px] font-bold uppercase">✓ ASSOCIATE</div>
                </div>

                <div class="space-y-1">
                  <div class="font-mono text-[10px] text-zinc-500 uppercase flex justify-between">
                    <span>{sala.tipo_espacio || 'CULTURAL VENUE'}</span>
                    <span>{sala.aforo ? `${sala.aforo} PAX` : 'CERTIFIED'}</span>
                  </div>
                  <h3 class="font-display text-lg font-bold text-zinc-950">
                    <a href={`/en/directorio/${sala.slug}`} data-astro-prefetch="hover" class="hover:text-vermilion transition-colors">
                      {sala.nombre}
                    </a>
                  </h3>
                  <p class="font-mono text-xs text-zinc-600">📍 {sala.direccion || 'Madrid'}</p>
                </div>
              </div>

              <div class="pt-3 border-t border-zinc-100 flex items-center justify-between font-mono text-xs">
                <a href={`/en/directorio/${sala.slug}`} data-astro-prefetch="hover" class="font-bold text-zinc-950 hover:text-vermilion">
                  VIEW SPECS ↗
                </a>
                <a href={instaUrl} target="_blank" rel="noopener noreferrer" class="text-zinc-500 hover:text-vermilion">
                  Instagram
                </a>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</Layout>
