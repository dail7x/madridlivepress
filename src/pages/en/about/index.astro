---
import Layout from '@/layouts/Layout.astro';
import WireframeHeader from '@/components/ui/WireframeHeader.astro';
import { association, pressOffice } from '@/lib/contacts';

export const prerender = false;
---

<Layout
  title="About us | Noche Madrid Press"
  description="Noche Madrid is the association of nightlife business owners in the Community of Madrid. Sector: nightlife and shows."
  lang="en"
  alternateUrlEs="/sobre-nosotros"
  alternateUrlEn="/en/about"
>
  <div class="w-full bg-paper pb-16">
    <WireframeHeader
      title="ABOUT US"
      subtitle="Noche Madrid is the association of nightlife business owners in the Community of Madrid. Sector: nightlife and shows."
      badge="ASSOCIATION"
      updatedTime="SINCE 2010"
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-7 space-y-6">
          <h2 class="font-display text-2xl sm:text-4xl font-bold text-zinc-950 tracking-tight leading-tight">
            Who we are
          </h2>

          <div class="font-sans text-sm sm:text-base text-zinc-700 leading-relaxed space-y-4">
            <p>
              <strong>NOCHE MADRID</strong> is the main business organization in Madrid's nightlife sector and brings together all types of recreational, cultural, gastronomic and show activities that make up nightlife.
            </p>
            <p>
              The founding of NOCHE MADRID in 2010, as a result of the integration of the Asociación de Empresarios de Espectáculos, Salas de Fiesta y Ocio de la Comunidad de Madrid (ASFYDIS) and the Asociación Madrileña de Empresarios por la Calidad del Ocio (ECO), marked a turning point in the evolution of Madrid's nightlife and in the defense and dignification of professional and business activity in the leisure and entertainment sector.
            </p>
            <p>
              The social, economic and cultural importance of nightlife and its fundamental role in Madrid's international tourism projection are the pillars of the business project that I have the satisfaction of chairing, whose main objective is to undertake a comprehensive plan for business innovation, the dignification of the sector and the promotion of safe, responsible and quality leisure.
            </p>
          </div>

          <div class="pt-2 flex flex-wrap gap-4 font-mono text-xs">
            <a
              href="/en/studies"
              class="bg-zinc-950 text-white hover:bg-vermilion px-5 py-3 font-bold uppercase tracking-wider transition-colors inline-flex items-center gap-1.5"
            >
              <span>Studies and campaigns</span>
              <span>→</span>
            </a>
            <a
              href="/en/news"
              class="border border-zinc-950 hover:bg-zinc-100 text-zinc-950 px-5 py-3 font-bold uppercase tracking-wider transition-colors inline-flex items-center gap-1.5"
            >
              <span>Press releases</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 grid grid-cols-1 gap-4 bg-canvas p-6 border border-zinc-200 font-mono">
          <div class="border-b border-zinc-200 pb-4">
            <div class="font-display text-xl font-bold text-zinc-950">Association</div>
            <div class="text-[11px] text-zinc-500 uppercase tracking-widest mt-1">Nightlife business owners</div>
          </div>
          <div class="border-b border-zinc-200 pb-4">
            <div class="font-display text-xl font-bold text-zinc-950">Community of Madrid</div>
            <div class="text-[11px] text-zinc-500 uppercase tracking-widest mt-1">Territory</div>
          </div>
          <div>
            <div class="font-display text-xl font-bold text-zinc-950">Nightlife and shows</div>
            <div class="text-[11px] text-zinc-500 uppercase tracking-widest mt-1">Sector</div>
          </div>
        </div>
      </div>

      <div id="contact" class="border-t border-zinc-200 pt-10">
        <h3 class="font-mono text-xs font-bold text-zinc-400 uppercase tracking-widest mb-6">
          Contact
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="border border-zinc-200 p-6 bg-paper space-y-4">
            <div>
              <h4 class="font-display text-lg font-bold text-zinc-950">{association.name}</h4>
              <p class="font-mono text-xs text-zinc-500 uppercase">Association of nightlife business owners in the Community of Madrid</p>
            </div>
            <p class="font-sans text-sm text-zinc-600 leading-relaxed">
              Headquarters and general contact published on nocheMadrid.org.
            </p>
            <div class="space-y-1 font-mono text-xs">
              <a href={`mailto:${association.email}`} class="block text-vermilion font-bold hover:underline">{association.email}</a>
              <a href={`tel:${association.phoneTel}`} class="block text-zinc-950 font-bold">+34 {association.phoneDisplay}</a>
              <div class="text-zinc-500">{association.address} · {association.city}, Spain</div>
            </div>
          </div>

          <div class="border border-zinc-200 p-6 bg-paper space-y-4">
            <div>
              <h4 class="font-display text-lg font-bold text-zinc-950">{pressOffice.name}</h4>
              <p class="font-mono text-xs text-zinc-500 uppercase">{pressOffice.office}</p>
            </div>
            <p class="font-sans text-sm text-zinc-600 leading-relaxed">
              Primary press contact for newsrooms, agencies and correspondents.
            </p>
            <div class="space-y-1 font-mono text-xs">
              <a href={`tel:${pressOffice.phoneTel}`} class="block text-vermilion font-bold">Tel. +34 {pressOffice.phoneDisplay}</a>
              <div class="text-zinc-500">{pressOffice.lineEn}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
