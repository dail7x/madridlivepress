---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import type { Sala } from '@/lib/directus';

export const prerender = false;

const { slug } = Astro.params;

let item: Sala | null = null;
try {
  const res = await directus.request(
    readItems('salas' as any, {
      filter: {
        slug: { _eq: slug },
        status: { _eq: 'published' },
      },
      limit: 1,
      fields: [
        'id',
        'status',
        'nombre',
        'slug',
        'direccion',
        'distrito',
        'tipo_espacio',
        'aforo',
        'descripcion',
        'imagen_portada.*',
        'sitio_web',
        'instagram_url',
        'contacto_prensa_nombre',
        'contacto_prensa_email',
        'contacto_prensa_telefono',
        'dossier_pdf.*',
      ],
    })
  );
  item = ((res as any) && (res as any)[0]) || null;
} catch (e) {
  console.error(`Error loading venue "${slug}":`, e);
}

if (!item) {
  return Astro.redirect('/404');
}

const photoUrl = item.imagen_portada
  ? getAssetUrl(item.imagen_portada, { quality: 90, format: 'webp' })
  : 'https://images.unsplash.com/photo-1514306191717-452ec28c7814?q=80&w=1400&auto=format&fit=crop';

const typeLabelMap: Record<string, string> = {
  sala_conciertos: 'SALA DE CONCIERTOS Y MÚSICA EN VIVO',
  discoteca: 'DISCOTECA & CLUB NOCTURNO',
  teatro_musical: 'TEATRO MUSICAL Y ESPACIO ESCÉNICO',
  tablao: 'TABLAO FLAMENCO HISTÓRICO',
  bar_especial: 'BAR ESPECIAL Y COCTELERÍA CULTURAL',
};
const typeLabel = typeLabelMap[item.tipo_espacio] || 'ESPACIO ASOCIADO OFICIAL';
const monogram = item.nombre.split(' ').map((n) => n[0]).slice(0, 2).join('').toUpperCase();
const instaUrl = (item as any).instagram_url || 'https://www.instagram.com/nochemadrid/';
---

<Layout
  title={`${item.nombre} | Directorio Oficial | Madrid Live Press`}
  description={item.descripcion || `Ficha oficial del espacio ${item.nombre}, asociado a NocheMadrid.`}
  image={photoUrl}
  lang="es"
  alternateUrlEs={`/directorio/${item.slug}`}
  alternateUrlEn={`/en/directory/${item.slug}`}
>
  <article class="w-full bg-paper pb-16">
    <!-- Breadcrumb -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-8 pb-4">
      <div class="font-mono text-[11px] sm:text-xs text-zinc-600 uppercase tracking-widest flex items-center gap-2">
        <a href="/directorio" data-astro-prefetch="hover" class="hover:text-zinc-950 transition-colors">DIRECTORIO</a>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-700">{item.distrito || 'MADRID'}</span>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-950 font-bold">{item.nombre}</span>
      </div>
    </div>

    <!-- Hero Header -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Title, Metadata & Social Links -->
        <div class="lg:col-span-7 space-y-6">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-zinc-950 text-white font-mono text-sm font-bold flex items-center justify-center">
              {monogram}
            </div>
            <div class="font-mono text-xs text-zinc-500 uppercase tracking-wider">
              <span>{typeLabel}</span>
              <span class="text-zinc-300 mx-2">·</span>
              <span class="text-vermilion font-bold">✓ ASOCIADO NOCHEMADRID</span>
            </div>
          </div>

          <h1 class="font-display text-3xl sm:text-5xl font-bold text-zinc-950 tracking-tight leading-tight">
            {item.nombre}
          </h1>

          <p class="font-sans text-base sm:text-lg text-zinc-700 leading-relaxed">
            {item.descripcion}
          </p>

          <!-- Specs Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 p-4 border border-zinc-200 bg-canvas font-mono text-xs">
            <div>
              <span class="text-zinc-400 block text-[10px] uppercase">Aforo Homologado</span>
              <span class="font-bold text-zinc-950 text-sm">{item.aforo ? `${item.aforo} personas` : 'Consultar'}</span>
            </div>
            <div>
              <span class="text-zinc-400 block text-[10px] uppercase">Distrito</span>
              <span class="font-bold text-zinc-950 text-sm">{item.distrito || 'Centro'}</span>
            </div>
            <div>
              <span class="text-zinc-400 block text-[10px] uppercase">Dirección</span>
              <span class="font-bold text-zinc-950 text-sm">{item.direccion || 'Madrid'}</span>
            </div>
          </div>

          <!-- Social Links & Action Buttons -->
          <div class="space-y-3 pt-2">
            <div class="flex items-center gap-4 font-mono text-xs">
              <a
                href={instaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 font-bold text-zinc-950 hover:text-vermilion transition-colors border border-zinc-200 px-3 py-1.5 bg-paper"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
                <span>Instagram Oficial</span>
              </a>

              {item.sitio_web && (
                <a
                  href={item.sitio_web}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 font-bold text-zinc-950 hover:text-vermilion transition-colors border border-zinc-200 px-3 py-1.5 bg-paper"
                >
                  <span>Sitio Web</span>
                  <span>↗</span>
                </a>
              )}
            </div>

            <div class="flex flex-wrap items-center gap-4 pt-2">
              <a
                href="/acreditaciones"
                data-astro-prefetch="hover"
                class="bg-zinc-950 hover:bg-vermilion text-white font-mono text-xs uppercase tracking-wider font-bold py-3.5 px-6 transition-colors active:scale-[0.98]"
              >
                Solicitar Acreditación de Prensa ↗
              </a>
              <a
                href="/press-kits"
                data-astro-prefetch="hover"
                class="border border-zinc-950 hover:bg-zinc-100 text-zinc-950 font-mono text-xs uppercase tracking-wider font-bold py-3.5 px-6 transition-colors active:scale-[0.98]"
              >
                Descargar Press Kit Oficial ↓
              </a>
            </div>
          </div>
        </div>

        <!-- Right: Venue Photo with Credit -->
        <div class="lg:col-span-5 relative">
          <div class="border border-zinc-200 aspect-[4/3] w-full overflow-hidden bg-zinc-100">
            <img src={photoUrl} alt={item.nombre} class="w-full h-full object-cover filter contrast-105" />
          </div>
          <div class="font-mono text-[10px] text-zinc-400 pt-2 flex items-center justify-between">
            <span>© Archivo Oficial NocheMadrid</span>
            <span class="text-zinc-950 font-bold">MATERIAL OFICIAL DISPONIBLE</span>
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>
