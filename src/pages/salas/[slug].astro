---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import { useTranslations } from '@/lib/i18n';
import type { Sala } from '@/lib/directus';
import {
  ArrowLeft,
  MapPin,
  Users,
  Globe,
  Mail,
  Phone,
  Download,
  Building2,
  ShieldCheck,
  FileText,
  Instagram,
} from 'lucide-astro';

export const prerender = false;

const { slug } = Astro.params;
const t = useTranslations('es');

let sala: Sala | null = null;

try {
  const res = await directus.request(
    readItems('salas' as any, {
      filter: {
        slug: { _eq: slug },
        status: { _eq: 'published' },
      },
      fields: [
        'id',
        'nombre',
        'slug',
        'tipo_espacio',
        'distrito',
        'direccion',
        'aforo',
        'descripcion',
        'logo.*',
        'imagen_portada.*',
        'contacto_prensa_email',
        'contacto_prensa_nombre',
        'contacto_prensa_telefono',
        'dossier_pdf.*',
        'sitio_web',
        'instagram',
        'destacado',
      ],
      limit: 1,
    })
  );

  sala = ((res as any) && (res as any)[0]) || null;
} catch (e) {
  console.error(`Error loading venue "${slug}":`, e);
}

if (!sala) {
  return Astro.redirect('/404');
}

const coverUrl = sala.imagen_portada
  ? getAssetUrl(sala.imagen_portada, { width: 1400, height: 700, quality: 85, format: 'webp' })
  : null;
const logoUrl = sala.logo ? getAssetUrl(sala.logo, { width: 240, height: 240, format: 'webp' }) : null;
const dossierUrl = sala.dossier_pdf ? getAssetUrl(sala.dossier_pdf) : null;
---

<Layout
  title={`Ficha Técnica: ${sala.nombre}`}
  description={sala.descripcion || `Información oficial y ficha técnica para medios de ${sala.nombre}, asociada a NocheMadrid.`}
  image={coverUrl || undefined}
  lang="es"
>
  <div class="max-w-4xl mx-auto space-y-10">
    {/* Navigation */}
    <div class="border-b border-white/10 pb-4">
      <a
        href="/salas"
        class="inline-flex items-center gap-2 font-mono text-xs font-semibold text-zinc-400 hover:text-white transition-colors"
      >
        <ArrowLeft class="h-4 w-4" />
        <span>{t.venues.backToList}</span>
      </a>
    </div>

    {/* Venue Header */}
    <div class="flex flex-col sm:flex-row items-start justify-between gap-6">
      <div class="flex items-start gap-5">
        {logoUrl && (
          <div class="h-20 w-20 sm:h-24 sm:w-24 rounded-2xl bg-surface border border-white/15 p-2 shadow-xl flex-shrink-0 flex items-center justify-center overflow-hidden">
            <img src={logoUrl} alt={sala.nombre} class="h-full w-full object-contain" />
          </div>
        )}
        <div class="space-y-1.5">
          <div class="flex items-center gap-2">
            <span class="rounded-md bg-brand-primary/20 px-3 py-1 font-mono text-xs font-bold uppercase text-rose-300 border border-brand-primary/30">
              {sala.tipo_espacio ? sala.tipo_espacio.replace('_', ' ') : 'Sala'}
            </span>
            <span class="font-mono text-xs text-zinc-400">
              NocheMadrid #96
            </span>
          </div>
          <h1 class="font-display text-3xl sm:text-4xl font-extrabold text-white">
            {sala.nombre}
          </h1>
          <div class="flex items-center gap-2 font-sans text-sm text-zinc-400">
            <MapPin class="h-4 w-4 text-zinc-500 flex-shrink-0" />
            <span>{sala.direccion || sala.distrito}</span>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        {dossierUrl && (
          <a
            href={dossierUrl}
            target="_blank"
            rel="noopener noreferrer"
            download
            class="inline-flex items-center gap-2 rounded-xl bg-amber-500 px-4 py-2.5 font-mono text-xs font-bold text-black shadow-lg hover:bg-amber-400 transition-all"
          >
            <Download class="h-4 w-4" />
            <span>Dossier Técnico</span>
          </a>
        )}

        {sala.sitio_web && (
          <a
            href={sala.sitio_web}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-4 py-2.5 font-mono text-xs font-semibold text-white hover:bg-white/10 transition-all"
          >
            <Globe class="h-4 w-4" />
            <span>Web Oficial</span>
          </a>
        )}
      </div>
    </div>

    {/* Hero Image */}
    {coverUrl && (
      <div class="relative overflow-hidden rounded-3xl border border-white/10 shadow-2xl">
        <img src={coverUrl} alt={sala.nombre} class="w-full h-auto max-h-[460px] object-cover" />
      </div>
    )}

    {/* Technical Specs Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="rounded-2xl border border-white/10 bg-surface/80 p-5 space-y-1 backdrop-blur-md">
        <span class="font-mono text-[11px] uppercase tracking-wider text-zinc-400">Aforo Homologado</span>
        <div class="font-display text-2xl font-bold text-white flex items-center gap-2">
          <Users class="h-5 w-5 text-rose-400" />
          <span>{sala.aforo ? sala.aforo.toLocaleString() : 'N/D'}</span>
        </div>
        <span class="font-sans text-xs text-zinc-500">Capacidad autorizada de público</span>
      </div>

      <div class="rounded-2xl border border-white/10 bg-surface/80 p-5 space-y-1 backdrop-blur-md">
        <span class="font-mono text-[11px] uppercase tracking-wider text-zinc-400">Distrito Municipal</span>
        <div class="font-display text-2xl font-bold text-white flex items-center gap-2">
          <Building2 class="h-5 w-5 text-amber-400" />
          <span class="capitalize">{sala.distrito ? sala.distrito.replace('_', ' ') : 'Centro'}</span>
        </div>
        <span class="font-sans text-xs text-zinc-500">Comunidad de Madrid</span>
      </div>

      <div class="rounded-2xl border border-white/10 bg-surface/80 p-5 space-y-1 backdrop-blur-md">
        <span class="font-mono text-[11px] uppercase tracking-wider text-zinc-400">Certificación NocheMadrid</span>
        <div class="font-display text-xl font-bold text-emerald-400 flex items-center gap-2">
          <ShieldCheck class="h-5 w-5" />
          <span>Socio Activo</span>
        </div>
        <span class="font-sans text-xs text-zinc-500">Auditoría acústica y de aforo al día</span>
      </div>
    </div>

    {/* Description */}
    {sala.descripcion && (
      <div class="rounded-3xl border border-white/10 bg-surface/60 p-8 backdrop-blur-xl space-y-3">
        <h2 class="font-display text-xl font-bold text-white">
          Descripción del Espacio
        </h2>
        <p class="font-sans text-base text-zinc-300 leading-relaxed">
          {sala.descripcion}
        </p>
      </div>
    )}

    {/* Media Contact Card */}
    <div class="rounded-3xl border border-white/10 bg-black/50 p-8 space-y-4">
      <div class="flex items-center gap-2 text-rose-400 font-mono text-xs uppercase tracking-widest font-semibold">
        <Mail class="h-4 w-4" />
        <span>Gabinete de Prensa de la Sala</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {sala.contacto_prensa_nombre && (
          <div>
            <span class="font-mono text-xs text-zinc-400 block">Responsable de Medios</span>
            <span class="font-display text-base font-bold text-white">{sala.contacto_prensa_nombre}</span>
          </div>
        )}

        {sala.contacto_prensa_email && (
          <div>
            <span class="font-mono text-xs text-zinc-400 block">Correo Electrónico de Prensa</span>
            <a href={`mailto:${sala.contacto_prensa_email}`} class="font-mono text-sm text-brand-primary hover:underline">
              {sala.contacto_prensa_email}
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</Layout>
