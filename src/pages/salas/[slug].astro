---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import type { Sala } from '@/lib/directus';

export const prerender = false;

const { slug } = Astro.params;

let sala: Sala | null = null;

try {
  const res = await directus.request(
    readItems('salas' as any, {
      filter: {
        slug: { _eq: slug },
        status: { _eq: 'published' },
      },
      fields: [
        'id',
        'nombre',
        'slug',
        'tipo_espacio',
        'distrito',
        'direccion',
        'aforo',
        'descripcion',
        'logo.*',
        'imagen_portada.*',
        'contacto_prensa_email',
        'contacto_prensa_nombre',
        'contacto_prensa_telefono',
        'dossier_pdf.*',
        'sitio_web',
        'instagram',
      ],
      limit: 1,
    })
  );

  sala = ((res as any) && (res as any)[0]) || null;
} catch (e) {
  console.error(`Error loading venue "${slug}":`, e);
}

if (!sala) {
  return Astro.redirect('/404');
}

const coverUrl = sala.imagen_portada
  ? getAssetUrl(sala.imagen_portada, { quality: 90, format: 'webp' })
  : 'https://images.unsplash.com/photo-1514306191717-452ec28c7814?q=80&w=1200&auto=format&fit=crop';

const dossierUrl = sala.dossier_pdf ? getAssetUrl(sala.dossier_pdf) : null;
---

<Layout
  title={`${sala.nombre} - Ficha Técnica y Contacto de Prensa | Madrid Live Press`}
  description={sala.descripcion || `Ficha técnica oficial de ${sala.nombre} para medios de comunicación.`}
  image={coverUrl}
  lang="es"
>
  <div class="w-full bg-paper">
    <!-- Top Monospaced Breadcrumb -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
      <div class="font-mono text-xs text-zinc-400 uppercase tracking-widest flex items-center gap-3">
        <a href="/salas" class="hover:text-zinc-950 transition-colors">ARCHIVO DE SALAS</a>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-700">{sala.distrito?.toUpperCase() || 'MADRID'}</span>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-900 font-semibold">{sala.nombre.toUpperCase()}</span>
      </div>
    </div>

    <!-- Header Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Left: Technical Identity -->
        <div class="lg:col-span-7 space-y-6">
          <div class="font-mono text-xs text-zinc-500 uppercase tracking-widest flex items-center gap-3">
            <span class="text-zinc-950 font-bold">{sala.tipo_espacio || 'Espacio Escénico'}</span>
            <span class="text-zinc-300">|</span>
            <span>NOCHEMADRID FEDERADA</span>
          </div>

          <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-zinc-950 tracking-tight">
            {sala.nombre}
          </h1>

          {sala.descripcion && (
            <p class="font-sans text-base sm:text-lg text-zinc-700 leading-relaxed">
              {sala.descripcion}
            </p>
          )}

          <!-- Technical Specs Table -->
          <div class="border border-zinc-200 divide-y divide-zinc-200 font-mono text-xs bg-canvas">
            {sala.aforo && (
              <div class="p-3.5 flex justify-between">
                <span class="text-zinc-500 uppercase">AFORO HOMOLOGADO</span>
                <span class="text-zinc-950 font-bold">{sala.aforo.toLocaleString()} PERSONAS</span>
              </div>
            )}
            {sala.distrito && (
              <div class="p-3.5 flex justify-between">
                <span class="text-zinc-500 uppercase">DISTRITO</span>
                <span class="text-zinc-950 font-bold">{sala.distrito}</span>
              </div>
            )}
            {sala.direccion && (
              <div class="p-3.5 flex justify-between">
                <span class="text-zinc-500 uppercase">DIRECCIÓN</span>
                <span class="text-zinc-950">{sala.direccion}</span>
              </div>
            )}
            {sala.sitio_web && (
              <div class="p-3.5 flex justify-between">
                <span class="text-zinc-500 uppercase">SITIO WEB</span>
                <a href={sala.sitio_web} target="_blank" rel="noopener noreferrer" class="text-zinc-950 underline hover:text-vermilion">
                  {sala.sitio_web.replace(/^https?:\/\//, '')} ↗
                </a>
              </div>
            )}
          </div>

          <!-- Actions -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            {dossierUrl && (
              <a
                href={dossierUrl}
                download
                class="font-mono text-xs uppercase tracking-wider font-bold text-zinc-950 hover:text-vermilion border-b border-zinc-950 hover:border-vermilion pb-1 transition-colors"
              >
                DESCARGAR DOSSIER TÉCNICO · PDF ↓
              </a>
            )}
          </div>
        </div>

        <!-- Right: Venue Photography -->
        <div class="lg:col-span-5 relative">
          <div class="border border-zinc-200 aspect-[4/3] w-full overflow-hidden bg-zinc-100">
            <img
              src={coverUrl}
              alt={sala.nombre}
              class="h-full w-full object-cover filter contrast-105"
            />
          </div>
          <div class="hidden lg:block absolute -right-6 top-0 h-full">
            <span class="writing-vertical font-mono text-[9px] text-zinc-400 tracking-wider select-none whitespace-nowrap">
              © NocheMadrid / Archivo Documental
            </span>
          </div>

          <!-- Press Contact Card -->
          <div class="mt-6 border border-zinc-200 p-5 bg-canvas space-y-3 font-mono text-xs">
            <div class="font-bold text-zinc-950 uppercase tracking-wider">
              CONTACTO PARA MEDIOS
            </div>
            {sala.contacto_prensa_nombre && (
              <div class="text-zinc-700">Responsable: {sala.contacto_prensa_nombre}</div>
            )}
            {sala.contacto_prensa_email && (
              <div>
                <a href={`mailto:${sala.contacto_prensa_email}`} class="text-zinc-950 underline hover:text-vermilion">
                  {sala.contacto_prensa_email}
                </a>
              </div>
            )}
            {sala.contacto_prensa_telefono && (
              <div class="text-zinc-600">{sala.contacto_prensa_telefono}</div>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
