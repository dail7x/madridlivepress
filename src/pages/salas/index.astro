---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import { useTranslations } from '@/lib/i18n';
import type { Sala } from '@/lib/directus';
import { Building2, Search, MapPin, Users, Globe, ArrowUpRight, ShieldCheck } from 'lucide-astro';

export const prerender = false;

const t = useTranslations('es');

let salas: Sala[] = [];
try {
  const res = await directus.request(
    readItems('salas' as any, {
      filter: { status: { _eq: 'published' } },
      sort: ['-destacado', 'nombre'],
      fields: [
        'id',
        'nombre',
        'slug',
        'tipo_espacio',
        'distrito',
        'direccion',
        'aforo',
        'descripcion',
        'logo.*',
        'imagen_portada.*',
        'contacto_prensa_email',
        'contacto_prensa_nombre',
        'contacto_prensa_telefono',
        'dossier_pdf.*',
        'sitio_web',
        'instagram',
        'destacado',
      ],
    })
  );
  salas = (res as any) || [];
} catch (e) {
  console.error('Error in /salas:', e);
}

const districts = [
  { label: 'Todos los distritos', value: 'all' },
  { label: 'Centro / Sol / Gran Vía', value: 'centro' },
  { label: 'Chamberí', value: 'chamberi' },
  { label: 'Salamanca', value: 'salamanca' },
  { label: 'Malasaña / Chueca', value: 'malasana_chueca' },
  { label: 'Moncloa / Princesa', value: 'moncloa' },
  { label: 'Retiro / Arganzuela', value: 'retiro_arganzuela' },
  { label: 'Chamartín / Tetuán', value: 'chamartin_tetuan' },
  { label: 'Periferia / Comunidad de Madrid', value: 'comunidad_madrid' },
];

const types = [
  { label: 'Todas las tipologías', value: 'all' },
  { label: 'Discoteca / Club', value: 'discoteca' },
  { label: 'Sala de Conciertos', value: 'sala_conciertos' },
  { label: 'Teatro Musical / Espectáculos', value: 'teatro_musical' },
  { label: 'Tablao Flamenco', value: 'tablao' },
  { label: 'Bar Especial / Lounge', value: 'bar_especial' },
];
---

<Layout
  title="Directorio Oficial de las 96 Salas y Espacios Asociados"
  description="Fichas técnicas, aforos, datos de contacto de medios y ubicaciones de las 96 salas de ocio y cultura federadas en NocheMadrid."
  lang="es"
>
  <div class="space-y-10">
    {/* Header */}
    <div class="space-y-3 border-b border-white/10 pb-8">
      <div class="inline-flex items-center gap-2 text-rose-400 font-mono text-xs uppercase tracking-widest font-semibold">
        <Building2 class="h-4 w-4" />
        <span>Red Federada NocheMadrid</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        {t.venues.title}
      </h1>
      <p class="font-sans text-lg text-zinc-300 max-w-3xl">
        {t.venues.subtitle}
      </p>
    </div>

    {/* Search & Filters */}
    <div class="rounded-3xl border border-white/10 bg-surface/80 p-6 backdrop-blur-xl shadow-xl space-y-4">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="relative">
          <Search class="absolute left-4 top-1/2 -translate-y-1/2 h-4 w-4 text-zinc-400" />
          <input
            type="text"
            id="salasSearch"
            placeholder="Buscar por nombre, calle o zona..."
            class="w-full rounded-xl border border-white/10 bg-black/50 pl-11 pr-4 py-3 text-sm text-white placeholder:text-zinc-500 focus:border-brand-primary focus:outline-none"
          />
        </div>

        <div>
          <select
            id="salasDistrict"
            class="w-full rounded-xl border border-white/10 bg-black/50 px-4 py-3 text-sm text-white focus:border-brand-primary focus:outline-none"
          >
            {districts.map((d) => (
              <option value={d.value}>{d.label}</option>
            ))}
          </select>
        </div>

        <div>
          <select
            id="salasType"
            class="w-full rounded-xl border border-white/10 bg-black/50 px-4 py-3 text-sm text-white focus:border-brand-primary focus:outline-none"
          >
            {types.map((tp) => (
              <option value={tp.value}>{tp.label}</option>
            ))}
          </select>
        </div>
      </div>
    </div>

    {/* Venues Grid */}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="salasGrid">
      {salas.map((sala) => {
        const coverUrl = sala.imagen_portada
          ? getAssetUrl(sala.imagen_portada, { width: 600, height: 400, quality: 80, format: 'webp' })
          : null;
        const logoUrl = sala.logo ? getAssetUrl(sala.logo, { width: 120, height: 120, format: 'webp' }) : null;
        const detailUrl = `/salas/${sala.slug}`;

        return (
          <div
            class="sala-card group flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-surface/80 transition-all duration-300 hover:border-white/20 hover:-translate-y-1 hover:shadow-2xl hover:shadow-black/50 backdrop-blur-md"
            data-name={sala.nombre.toLowerCase()}
            data-district={sala.distrito}
            data-type={sala.tipo_espacio}
          >
            <div>
              <a href={detailUrl} class="relative block aspect-[16/10] w-full overflow-hidden bg-zinc-900">
                {coverUrl ? (
                  <img
                    src={coverUrl}
                    alt={sala.nombre}
                    class="h-full w-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-surface to-background text-zinc-600 font-mono text-xs">
                    {sala.nombre}
                  </div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-80"></div>

                {logoUrl && (
                  <div class="absolute bottom-3 left-3 h-10 w-10 rounded-xl bg-black/80 p-1 border border-white/15 backdrop-blur-md overflow-hidden">
                    <img src={logoUrl} alt={sala.nombre} class="h-full w-full object-contain" />
                  </div>
                )}

                {sala.destacado && (
                  <span class="absolute top-3 right-3 rounded-full bg-rose-500/90 px-2.5 py-0.5 font-mono text-[10px] font-bold uppercase tracking-wider text-white shadow-lg">
                    Destacada
                  </span>
                )}
              </a>

              <div class="p-5 space-y-3">
                <div>
                  <span class="font-mono text-[11px] uppercase tracking-wider text-amber-300/90 font-semibold">
                    {sala.tipo_espacio ? sala.tipo_espacio.replace('_', ' ') : 'Espacio'}
                  </span>
                  <h2 class="font-display text-lg font-bold text-white group-hover:text-rose-400 transition-colors">
                    <a href={detailUrl}>{sala.nombre}</a>
                  </h2>
                </div>

                <div class="space-y-1.5 font-sans text-xs text-zinc-400">
                  <div class="flex items-center gap-2">
                    <MapPin class="h-3.5 w-3.5 text-zinc-500 flex-shrink-0" />
                    <span class="truncate">{sala.direccion || sala.distrito}</span>
                  </div>
                  {sala.aforo && (
                    <div class="flex items-center gap-2 font-mono text-zinc-300">
                      <Users class="h-3.5 w-3.5 text-zinc-500 flex-shrink-0" />
                      <span>Aforo: {sala.aforo.toLocaleString()} personas</span>
                    </div>
                  )}
                </div>
              </div>
            </div>

            <div class="border-t border-white/10 px-5 py-3 bg-black/20 flex items-center justify-between">
              <a
                href={detailUrl}
                class="font-mono text-xs font-semibold text-zinc-300 hover:text-white transition-colors inline-flex items-center gap-1"
              >
                <span>Ficha Técnica</span>
                <ArrowUpRight class="h-3 w-3" />
              </a>

              {sala.sitio_web && (
                <a
                  href={sala.sitio_web}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-zinc-400 hover:text-white transition-colors"
                  title="Sitio web oficial"
                >
                  <Globe class="h-3.5 w-3.5" />
                </a>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <script is:inline>
    const search = document.getElementById('salasSearch');
    const district = document.getElementById('salasDistrict');
    const type = document.getElementById('salasType');
    const cards = document.querySelectorAll('.sala-card');

    function filter() {
      const q = (search?.value || '').toLowerCase().trim();
      const d = district?.value || 'all';
      const t = type?.value || 'all';

      cards.forEach((c) => {
        const name = c.getAttribute('data-name') || '';
        const cardD = c.getAttribute('data-district') || '';
        const cardT = c.getAttribute('data-type') || '';

        const mQ = !q || name.includes(q);
        const mD = d === 'all' || cardD === d;
        const mT = t === 'all' || cardT === t;

        if (mQ && mD && mT) {
          c.classList.remove('hidden');
        } else {
          c.classList.add('hidden');
        }
      });
    }

    search?.addEventListener('input', filter);
    district?.addEventListener('change', filter);
    type?.addEventListener('change', filter);
  </script>
</Layout>
