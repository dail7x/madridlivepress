---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import type { Sala } from '@/lib/directus';

export const prerender = false;

let salas: Sala[] = [];
try {
  const res = await directus.request(
    readItems('salas' as any, {
      filter: { status: { _eq: 'published' } },
      sort: ['-destacado', 'nombre'],
      fields: [
        'id',
        'nombre',
        'slug',
        'tipo_espacio',
        'distrito',
        'direccion',
        'aforo',
        'descripcion',
        'logo.*',
        'imagen_portada.*',
        'contacto_prensa_email',
        'contacto_prensa_nombre',
        'dossier_pdf.*',
        'sitio_web',
        'destacado',
      ],
    })
  );
  salas = (res as any) || [];
} catch (e) {
  console.error('Error in /salas:', e);
}

const districts = [
  { label: 'Todos los distritos', value: 'all' },
  { label: 'Centro / Gran Vía', value: 'centro' },
  { label: 'Chamberí', value: 'chamberi' },
  { label: 'Salamanca', value: 'salamanca' },
  { label: 'Malasaña / Chueca', value: 'malasana_chueca' },
  { label: 'Moncloa', value: 'moncloa' },
  { label: 'Arganzuela', value: 'arganzuela' },
];
---

<Layout
  title="Directorio de Espacios y Salas Asociadas | Madrid Live Press"
  description="Censo oficial de las 96 salas, teatros y discotecas federadas en NocheMadrid. Fichas técnicas y contactos de prensa."
  lang="es"
>
  <div class="w-full bg-paper">
    <!-- Top Monospaced Breadcrumb -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
      <div class="font-mono text-xs text-zinc-400 uppercase tracking-widest flex items-center gap-3">
        <a href="/" class="hover:text-zinc-950 transition-colors">PORTADA</a>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-900 font-semibold">ARCHIVO DE SALAS</span>
      </div>
    </div>

    <!-- Page Header (Swiss Minimalist) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 border-b border-zinc-200">
      <div class="space-y-3">
        <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 font-semibold">
          CENSO OFICIAL NOCHEMADRID · 96 ASOCIADOS
        </div>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-zinc-950 tracking-tight">
          Directorio de Salas y Espacios Escénicos
        </h1>
        <p class="font-sans text-base text-zinc-600 max-w-3xl leading-relaxed">
          Catálogo arquitectónico y técnico de los 96 espacios culturales, salas de conciertos y recintos de ocio nocturno federados en la Comunidad de Madrid.
        </p>
      </div>

      <!-- Search & Filters -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
        <div class="md:col-span-6">
          <input
            type="text"
            id="pageSearchInput"
            placeholder="Buscar por nombre, distrito o tipología..."
            class="w-full border border-zinc-200 bg-paper px-4 py-2.5 font-mono text-xs text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-900 focus:outline-none transition-colors"
          />
        </div>

        <div class="md:col-span-6 flex flex-wrap gap-1.5 justify-start md:justify-end">
          {districts.map((d) => (
            <button
              type="button"
              data-district={d.value}
              class="pageFilterBtn font-mono text-[11px] uppercase tracking-wider px-2.5 py-1 border border-zinc-200 hover:border-zinc-900 text-zinc-600 hover:text-zinc-950 transition-colors first:bg-zinc-900 first:text-white first:border-zinc-900"
            >
              {d.label}
            </button>
          ))}
        </div>
      </div>
    </div>

    <!-- Venues Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div id="pageVenuesGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {salas.map((sala) => {
          const cover = sala.imagen_portada ? getAssetUrl(sala.imagen_portada, { width: 600, height: 400, format: 'webp' }) : null;

          return (
            <article
              class="venuePageCard border border-zinc-200 bg-paper hover:border-zinc-950 transition-colors flex flex-col justify-between"
              data-name={sala.nombre.toLowerCase()}
              data-district={(sala.distrito || '').toLowerCase()}
              data-type={(sala.tipo_espacio || '').toLowerCase()}
            >
              <div>
                {cover && (
                  <div class="aspect-[16/10] w-full border-b border-zinc-200 overflow-hidden bg-zinc-100">
                    <img
                      src={cover}
                      alt={sala.nombre}
                      class="h-full w-full object-cover filter grayscale-[15%] contrast-105"
                      loading="lazy"
                    />
                  </div>
                )}

                <div class="p-6 space-y-4">
                  <div class="flex items-center justify-between font-mono text-[11px] text-zinc-500 uppercase tracking-widest">
                    <span class="text-zinc-950 font-semibold">{sala.tipo_espacio || 'Espacio'}</span>
                    <span>{sala.distrito || 'Madrid'}</span>
                  </div>

                  <h2 class="font-display text-xl font-bold text-zinc-950">
                    <a href={`/salas/${sala.slug}`} class="hover:text-vermilion transition-colors">
                      {sala.nombre}
                    </a>
                  </h2>

                  <div class="space-y-1 font-mono text-xs text-zinc-600">
                    {sala.aforo && <div>AFORO HOMOLOGADO: {sala.aforo.toLocaleString()} PAX</div>}
                    {sala.direccion && <div class="text-zinc-500 line-clamp-1">{sala.direccion}</div>}
                  </div>

                  {sala.descripcion && (
                    <p class="font-sans text-xs text-zinc-600 line-clamp-2 leading-relaxed pt-2 border-t border-zinc-100">
                      {sala.descripcion}
                    </p>
                  )}
                </div>
              </div>

              <div class="p-6 pt-0 border-t border-zinc-100 flex items-center justify-between font-mono text-xs">
                <a
                  href={`/salas/${sala.slug}`}
                  class="uppercase tracking-wider font-semibold text-zinc-950 hover:text-vermilion transition-colors"
                >
                  FICHA TÉCNICA ↗
                </a>

                {sala.sitio_web && (
                  <a
                    href={sala.sitio_web}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-zinc-400 hover:text-zinc-900 transition-colors"
                  >
                    WEB
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>

  <script>
    const searchInput = document.getElementById('pageSearchInput') as HTMLInputElement | null;
    const filterBtns = document.querySelectorAll('.pageFilterBtn');
    const cards = document.querySelectorAll('.venuePageCard') as NodeListOf<HTMLElement>;

    let currentDistrict = 'all';
    let currentQuery = '';

    function filterVenues() {
      cards.forEach((card) => {
        const name = card.dataset.name || '';
        const district = card.dataset.district || '';
        const type = card.dataset.type || '';

        const matchesQuery = !currentQuery || name.includes(currentQuery) || district.includes(currentQuery) || type.includes(currentQuery);
        const matchesDistrict = currentDistrict === 'all' || district.includes(currentDistrict);

        if (matchesQuery && matchesDistrict) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    }

    searchInput?.addEventListener('input', (e) => {
      currentQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterVenues();
    });

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        filterBtns.forEach((b) => {
          b.classList.remove('bg-zinc-900', 'text-white', 'border-zinc-900');
          b.classList.add('text-zinc-600', 'border-zinc-200');
        });

        btn.classList.add('bg-zinc-900', 'text-white', 'border-zinc-900');
        btn.classList.remove('text-zinc-600', 'border-zinc-200');

        currentDistrict = btn.getAttribute('data-district') || 'all';
        filterVenues();
      });
    });
  </script>
</Layout>
