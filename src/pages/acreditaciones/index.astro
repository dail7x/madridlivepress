---
import Layout from '@/layouts/Layout.astro';
import { directus } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import type { Evento } from '@/lib/directus';

export const prerender = false;

const selectedEventoId = Astro.url.searchParams.get('evento');

let eventos: Evento[] = [];
try {
  const res = await directus.request(
    readItems('eventos' as any, {
      filter: { status: { _eq: 'published' } },
      sort: ['fecha_evento'],
      fields: ['id', 'titulo', 'fecha_evento'],
    })
  );
  eventos = (res as any) || [];
} catch (e) {
  console.error('Error in /acreditaciones:', e);
}
---

<Layout
  title="Acreditación Oficial de Prensa | Madrid Live Press"
  description="Solicitud de acreditación oficial para redactores, fotoperiodistas y corresponsales extranjeros ante NocheMadrid."
  lang="es"
>
  <div class="w-full bg-paper">
    <!-- Top Monospaced Breadcrumb -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
      <div class="font-mono text-xs text-zinc-400 uppercase tracking-widest flex items-center gap-3">
        <a href="/" class="hover:text-zinc-950 transition-colors">PORTADA</a>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-900 font-semibold">ACREDITACIÓN DE PRENSA</span>
      </div>
    </div>

    <!-- Header Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 border-b border-zinc-200">
      <div class="space-y-3">
        <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 font-semibold">
          GABINETE DE PRENSA NOCHEMADRID · SERVICIO A REDACCIONES
        </div>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-zinc-950 tracking-tight">
          Acreditación para Periodistas y Medios
        </h1>
        <p class="font-sans text-base text-zinc-600 max-w-3xl leading-relaxed">
          Punto único de acreditación para cobertura informativa de eventos, ruedas de prensa y acceso profesional a las 96 salas de la Federación NocheMadrid.
        </p>
      </div>
    </div>

    <!-- Form Section -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <form id="acreditacionForm" class="border border-zinc-200 bg-paper p-8 sm:p-12 space-y-8">
        <div class="border-b border-zinc-200 pb-4">
          <div class="font-mono text-xs font-bold uppercase tracking-wider text-zinc-950">
            DATOS DE LA SOLICITUD
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="space-y-1.5">
            <label for="medio" class="font-mono text-[11px] font-semibold uppercase tracking-wider text-zinc-700 block">
              Medio de Comunicación *
            </label>
            <input
              type="text"
              id="medio"
              name="medio"
              required
              placeholder="Ej. Reuters, El País, BBC, Mixmag..."
              class="w-full border border-zinc-300 bg-paper px-4 py-2.5 font-mono text-xs text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-950 focus:outline-none"
            />
          </div>

          <div class="space-y-1.5">
            <label for="tipo_medio" class="font-mono text-[11px] font-semibold uppercase tracking-wider text-zinc-700 block">
              Tipología de Medio *
            </label>
            <select
              id="tipo_medio"
              name="tipo_medio"
              required
              class="w-full border border-zinc-300 bg-paper px-4 py-2.5 font-mono text-xs text-zinc-900 focus:border-zinc-950 focus:outline-none"
            >
              <option value="prensa_escrita">Prensa Escrita / Digital</option>
              <option value="television">Televisión / Agencia Audiovisual</option>
              <option value="radio">Radio / Podcast</option>
              <option value="agencia">Agencia de Noticias Internacional</option>
              <option value="fotoperiodismo">Fotoperiodista Independiente</option>
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="nombre_solicitante" class="font-mono text-[11px] font-semibold uppercase tracking-wider text-zinc-700 block">
              Nombre y Apellidos *
            </label>
            <input
              type="text"
              id="nombre_solicitante"
              name="nombre_solicitante"
              required
              placeholder="Nombre del redactor o fotógrafo"
              class="w-full border border-zinc-300 bg-paper px-4 py-2.5 font-mono text-xs text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-950 focus:outline-none"
            />
          </div>

          <div class="space-y-1.5">
            <label for="cargo" class="font-mono text-[11px] font-semibold uppercase tracking-wider text-zinc-700 block">
              Cargo / Función *
            </label>
            <input
              type="text"
              id="cargo"
              name="cargo"
              required
              placeholder="Redactor, Corresponsal, Jefe de Sección..."
              class="w-full border border-zinc-300 bg-paper px-4 py-2.5 font-mono text-xs text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-950 focus:outline-none"
            />
          </div>

          <div class="space-y-1.5">
            <label for="email" class="font-mono text-[11px] font-semibold uppercase tracking-wider text-zinc-700 block">
              Email Profesional *
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              placeholder="redaccion@medio.com"
              class="w-full border border-zinc-300 bg-paper px-4 py-2.5 font-mono text-xs text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-950 focus:outline-none"
            />
          </div>

          <div class="space-y-1.5">
            <label for="telefono" class="font-mono text-[11px] font-semibold uppercase tracking-wider text-zinc-700 block">
              Teléfono de Contacto
            </label>
            <input
              type="tel"
              id="telefono"
              name="telefono"
              placeholder="+34 600 000 000"
              class="w-full border border-zinc-300 bg-paper px-4 py-2.5 font-mono text-xs text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-950 focus:outline-none"
            />
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="evento" class="font-mono text-[11px] font-semibold uppercase tracking-wider text-zinc-700 block">
            Convocatoria o Sala Específica
          </label>
          <select
            id="evento"
            name="evento"
            class="w-full border border-zinc-300 bg-paper px-4 py-2.5 font-mono text-xs text-zinc-900 focus:border-zinc-950 focus:outline-none"
          >
            <option value="">Acreditación General para Coberturas Temporada 2026</option>
            {eventos.map((e) => (
              <option value={e.id} selected={selectedEventoId === String(e.id)}>
                {e.titulo}
              </option>
            ))}
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="motivo_cobertura" class="font-mono text-[11px] font-semibold uppercase tracking-wider text-zinc-700 block">
            Detalle del Enfoque Informativo / Publicación Prevista
          </label>
          <textarea
            id="motivo_cobertura"
            name="motivo_cobertura"
            rows="3"
            placeholder="Breve resumen de la pieza editorial o reportaje a realizar..."
            class="w-full border border-zinc-300 bg-paper px-4 py-2.5 font-mono text-xs text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-950 focus:outline-none"
          ></textarea>
        </div>

        <div class="pt-4 border-t border-zinc-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="font-mono text-[11px] text-zinc-500">
            Respuesta oficial en menos de 24 horas laborables.
          </div>

          <button
            type="submit"
            id="submitAcredBtn"
            class="w-full sm:w-auto bg-zinc-900 hover:bg-zinc-800 text-white px-8 py-3 font-mono text-xs uppercase tracking-wider font-semibold transition-colors"
          >
            <span id="acredBtnText">ENVIAR SOLICITUD</span>
          </button>
        </div>

        <div id="acredStatus" class="hidden font-mono text-xs p-4 border"></div>
      </form>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('acreditacionForm');
    const btn = document.getElementById('submitAcredBtn');
    const btnText = document.getElementById('acredBtnText');
    const statusDiv = document.getElementById('acredStatus');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      btn.disabled = true;
      if (btnText) btnText.textContent = 'PROCESANDO...';

      try {
        const res = await fetch('/api/acreditacion', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });

        const resData = await res.json();
        statusDiv.classList.remove('hidden');

        if (res.ok) {
          statusDiv.className = 'font-mono text-xs p-4 border border-zinc-900 bg-zinc-900 text-white';
          statusDiv.textContent = '✓ Solicitud registrada con éxito. El departamento de prensa contactará para validar sus credenciales.';
          form.reset();
        } else {
          statusDiv.className = 'font-mono text-xs p-4 border border-red-500 bg-red-50 text-red-700';
          statusDiv.textContent = resData.message || 'Error al enviar la solicitud.';
        }
      } catch (err) {
        statusDiv.classList.remove('hidden');
        statusDiv.className = 'font-mono text-xs p-4 border border-red-500 bg-red-50 text-red-700';
        statusDiv.textContent = 'Error de conexión. Intente nuevamente.';
      } finally {
        btn.disabled = false;
        if (btnText) btnText.textContent = 'ENVIAR SOLICITUD';
      }
    });
  </script>
</Layout>
