---
import Layout from '@/layouts/Layout.astro';
import WireframeHeader from '@/components/ui/WireframeHeader.astro';

export const prerender = false;
---

<Layout
  title="Agenda de Convocatorias y Ruedas de Prensa | Madrid Live Press"
  description="Calendario de convocatorias de prensa, ruedas informativas y presentaciones del sector del ocio nocturno y la cultura de Madrid."
  lang="es"
>
  <div class="w-full bg-paper pb-16">
    <!-- Top Wireframe Header "CONVOCATORIAS" (Clean Baseline Cut) -->
    <WireframeHeader
      title="AGENDA"
      subtitle="Agenda oficial de convocatorias, ruedas de prensa y actos sectoriales para medios de comunicación."
      badge="PRÓXIMA CONVOCATORIA"
      updatedTime="OCTUBRE 2026"
    />

    <!-- Events List -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
      <!-- Priority Upcoming Event Card (Entire card clickable) -->
      <a
        href="/eventos/conferencia-anual-nochemadrid-2026"
        class="group block border-2 border-zinc-950 bg-paper hover:bg-canvas transition-all p-6 sm:p-8 space-y-6 active:scale-[0.99]"
      >
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-zinc-200 pb-4">
          <div class="flex items-center gap-3">
            <span class="w-3 h-3 rounded-full bg-vermilion inline-block animate-pulse"></span>
            <span class="font-mono text-xs font-bold text-zinc-950 uppercase tracking-wider">
              CONVOCATORIA PRINCIPAL · RUEDA DE PRENSA OFICIAL
            </span>
          </div>
          <div class="font-mono text-xs text-vermilion font-bold uppercase tracking-wider">
            ✓ ACREDITACIÓN DE PRENSA ABIERTA
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
          <div class="lg:col-span-8 space-y-3">
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-zinc-950 group-hover:text-vermilion transition-colors leading-tight">
              Conferencia Anual de la Noche y Entrega de Premios NocheMadrid 2026
            </h2>
            <p class="font-sans text-sm sm:text-base text-zinc-700 leading-relaxed">
              Presentación del Balance Económico Anual del sector, entrega de los Galardones a la Excelencia e Innovación Cultural, y mesa redonda sobre la proyección internacional de Madrid como capital del ocio europeo.
            </p>
          </div>

          <div class="lg:col-span-4 bg-paper p-4 border border-zinc-200 font-mono text-xs space-y-2">
            <div class="text-zinc-500 uppercase text-[10px]">Fecha & Hora:</div>
            <div class="font-bold text-zinc-950 text-sm">Jueves, 15 de Octubre de 2026 · 11:00 CET</div>
            <div class="text-zinc-500 uppercase text-[10px] pt-1">Lugar:</div>
            <div class="text-zinc-800 font-medium">Teatro Eslava (Calle Arenal, 11, Madrid)</div>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-zinc-200 font-mono text-xs">
          <div class="text-zinc-500">
            Pases de prensa para redactores, cámaras de televisión y fotoperiodistas.
          </div>
          <div class="font-bold text-zinc-950 group-hover:text-vermilion flex items-center gap-1.5 uppercase">
            <span>Ver Ficha y Acreditarse</span>
            <span class="transform group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </div>
      </a>

      <!-- Secondary Past / Future Events -->
      <div class="border-t border-zinc-200 pt-8 space-y-4">
        <h3 class="font-mono text-xs font-bold text-zinc-400 uppercase tracking-widest">
          OTRAS CONVOCATORIAS DEL CALENDARIO
        </h3>

        <div class="divide-y divide-zinc-200 border border-zinc-200 bg-paper">
          <div class="p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs">
            <div class="space-y-1">
              <span class="text-zinc-400 text-[10px] uppercase">05 NOV 2026 · 10:30 CET</span>
              <h4 class="font-display text-base font-bold text-zinc-950">Presentación del Plan Acústico y de Convivencia Vecinal 2027</h4>
              <p class="font-sans text-xs text-zinc-600">Sede NocheMadrid · Rueda de prensa técnica</p>
            </div>
            <a href="/acreditaciones" class="font-bold text-zinc-950 hover:text-vermilion uppercase whitespace-nowrap">
              Solicitar Pase ↗
            </a>
          </div>

          <div class="p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 font-mono text-xs">
            <div class="space-y-1">
              <span class="text-zinc-400 text-[10px] uppercase">28 NOV 2026 · 12:00 CET</span>
              <h4 class="font-display text-base font-bold text-zinc-950">Encuentro Internacional de Festivales y Circuitos de Música en Vivo</h4>
              <p class="font-sans text-xs text-zinc-600">Florida Park · Sesión bilingüe ES / EN</p>
            </div>
            <a href="/acreditaciones" class="font-bold text-zinc-950 hover:text-vermilion uppercase whitespace-nowrap">
              Solicitar Pase ↗
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
