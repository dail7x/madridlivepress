---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import type { Evento, Sala } from '@/lib/directus';

export const prerender = false;

let eventos: Evento[] = [];
try {
  const res = await directus.request(
    readItems('eventos' as any, {
      filter: { status: { _eq: 'published' } },
      sort: ['fecha_evento'],
      fields: [
        'id',
        'titulo',
        'slug',
        'fecha_evento',
        'categoria',
        'descripcion',
        'imagen_portada.*',
        'pases_prensa_disponibles',
        'fecha_limite_acreditacion',
        { sala: ['id', 'nombre', 'slug', 'direccion'] },
      ],
    })
  );
  eventos = (res as any) || [];
} catch (e) {
  console.error('Error in /eventos:', e);
}
---

<Layout
  title="Agenda de Convocatorias y Ruedas de Prensa | Madrid Live Press"
  description="Convocatorias institucionales, ruedas de prensa del sector del ocio y reserva de pases de prensa para periodistas."
  lang="es"
>
  <div class="w-full bg-paper">
    <!-- Top Monospaced Breadcrumb -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
      <div class="font-mono text-xs text-zinc-400 uppercase tracking-widest flex items-center gap-3">
        <a href="/" class="hover:text-zinc-950 transition-colors">PORTADA</a>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-900 font-semibold">AGENDA DE PRENSA</span>
      </div>
    </div>

    <!-- Header Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 border-b border-zinc-200">
      <div class="space-y-3">
        <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 font-semibold">
          CALENDARIO OFICIAL DE PRENSA · NOCHEMADRID
        </div>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-zinc-950 tracking-tight">
          Convocatorias y Ruedas de Prensa
        </h1>
        <p class="font-sans text-base text-zinc-600 max-w-3xl leading-relaxed">
          Calendario de convocatorias presenciales y telemáticas para redactores, fotoperiodistas y equipos de televisión acreditados.
        </p>
      </div>
    </div>

    <!-- Events List -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="divide-y divide-zinc-200 border-t border-b border-zinc-200">
        {eventos.length === 0 ? (
          <div class="py-16 text-center text-zinc-500 font-sans text-sm">
            No hay convocatorias de prensa abiertas en este momento.
          </div>
        ) : (
          eventos.map((ev) => {
            const sala = ev.sala as Sala | undefined;
            const eventDate = ev.fecha_evento ? new Date(ev.fecha_evento) : new Date();
            const dateStr = eventDate.toLocaleDateString('es-ES', {
              day: '2-digit',
              month: 'short',
              year: 'numeric',
            }).toUpperCase();

            const timeStr = eventDate.toLocaleTimeString('es-ES', {
              hour: '2-digit',
              minute: '2-digit',
            });

            return (
              <article class="py-6 sm:py-8 grid grid-cols-1 md:grid-cols-12 gap-6 items-start group hover:bg-canvas transition-colors px-2">
                <!-- Date & Status (~25%) -->
                <div class="md:col-span-3 font-mono text-xs text-zinc-500 space-y-1">
                  <div class="text-zinc-950 font-bold tracking-wider">{dateStr} · {timeStr} CET</div>
                  {sala && (
                    <div class="text-zinc-700 font-medium pt-1">
                      {sala.nombre}
                    </div>
                  )}
                  {sala?.direccion && (
                    <div class="text-zinc-400 text-[11px]">
                      {sala.direccion}
                    </div>
                  )}
                </div>

                <!-- Event Details (~65%) -->
                <div class="md:col-span-7 space-y-2">
                  <div class="font-mono text-[11px] text-zinc-500 uppercase tracking-widest">
                    {ev.categoria || 'Convocatoria Oficial'}
                  </div>
                  <h2 class="font-display text-lg sm:text-xl font-bold text-zinc-950 leading-snug">
                    {ev.titulo}
                  </h2>
                  {ev.descripcion && (
                    <p class="font-sans text-sm text-zinc-600 line-clamp-2 leading-relaxed">
                      {ev.descripcion}
                    </p>
                  )}
                </div>

                <!-- Accreditation Action (~10%) -->
                <div class="md:col-span-2 flex md:justify-end items-center pt-2 md:pt-0">
                  <a
                    href={`/acreditaciones?evento=${ev.slug}`}
                    class="font-mono text-xs uppercase tracking-wider font-semibold text-zinc-950 hover:text-vermilion transition-colors border-b border-zinc-950 hover:border-vermilion pb-0.5"
                  >
                    ACREDITARSE ↗
                  </a>
                </div>
              </article>
            );
          })
        )}
      </div>
    </div>
  </div>
</Layout>
