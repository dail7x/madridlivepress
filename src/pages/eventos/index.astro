---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import { useTranslations } from '@/lib/i18n';
import type { Evento, Sala } from '@/lib/directus';
import { Calendar, MapPin, ShieldCheck, ArrowRight, Clock } from 'lucide-astro';

export const prerender = false;

const t = useTranslations('es');

let eventos: Evento[] = [];
try {
  const res = await directus.request(
    readItems('eventos' as any, {
      filter: { status: { _eq: 'published' } },
      sort: ['fecha_evento'],
      fields: [
        'id',
        'titulo',
        'slug',
        'fecha_evento',
        'categoria',
        'descripcion',
        'imagen_portada.*',
        'pases_prensa_disponibles',
        'fecha_limite_acreditacion',
        { sala: ['id', 'nombre', 'slug', 'direccion'] },
      ],
    })
  );
  eventos = (res as any) || [];
} catch (e) {
  console.error('Error in /eventos:', e);
}
---

<Layout
  title="Agenda de Medios & Convocatorias de Prensa"
  description="Convocatorias oficiales, ruedas de prensa y acceso a pases prioritarios de medios para eventos de NocheMadrid."
  lang="es"
>
  <div class="space-y-10">
    <div class="space-y-3 border-b border-white/10 pb-8">
      <div class="inline-flex items-center gap-2 text-rose-400 font-mono text-xs uppercase tracking-widest font-semibold">
        <Calendar class="h-4 w-4" />
        <span>Convocatorias & Ruedas de Prensa</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        {t.events.title}
      </h1>
      <p class="font-sans text-lg text-zinc-300 max-w-3xl">
        {t.events.subtitle}
      </p>
    </div>

    {eventos.length === 0 ? (
      <div class="rounded-2xl border border-white/10 bg-surface/50 p-12 text-center text-zinc-400">
        No hay convocatorias de prensa abiertas en este momento.
      </div>
    ) : (
      <div class="space-y-6">
        {eventos.map((evento) => {
          const sala = evento.sala as Sala | undefined;
          const cover = evento.imagen_portada
            ? getAssetUrl(evento.imagen_portada, { width: 400, height: 260, format: 'webp' })
            : null;

          return (
            <div class="group rounded-3xl border border-white/10 bg-surface/80 p-6 sm:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 hover:border-white/20 hover:shadow-2xl backdrop-blur-xl transition-all">
              <div class="flex flex-col sm:flex-row items-start gap-6">
                {/* Date Box */}
                <div class="rounded-2xl border border-brand-primary/30 bg-brand-primary/10 p-4 text-center flex-shrink-0 w-24 sm:w-28 space-y-0.5">
                  <span class="font-mono text-xs font-bold uppercase tracking-wider text-rose-400 block">
                    {new Date(evento.fecha_evento).toLocaleDateString('es-ES', { month: 'short' })}
                  </span>
                  <span class="font-display text-3xl sm:text-4xl font-extrabold text-white block">
                    {new Date(evento.fecha_evento).toLocaleDateString('es-ES', { day: 'numeric' })}
                  </span>
                  <span class="font-mono text-[11px] text-zinc-400 block">
                    {new Date(evento.fecha_evento).toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' })}h
                  </span>
                </div>

                {/* Info */}
                <div class="space-y-2 max-w-xl">
                  {evento.categoria && (
                    <span class="rounded-md bg-white/5 px-2.5 py-0.5 font-mono text-[11px] font-semibold text-amber-300">
                      {evento.categoria}
                    </span>
                  )}
                  <h2 class="font-display text-xl sm:text-2xl font-bold text-white group-hover:text-rose-400 transition-colors">
                    {evento.titulo}
                  </h2>
                  {sala && (
                    <div class="flex items-center gap-2 font-sans text-xs text-zinc-400">
                      <MapPin class="h-3.5 w-3.5 text-zinc-500 flex-shrink-0" />
                      <span>{sala.nombre} {sala.direccion ? `(${sala.direccion})` : ''}</span>
                    </div>
                  )}
                  {evento.descripcion && (
                    <div class="font-sans text-xs text-zinc-400 line-clamp-2" set:html={evento.descripcion} />
                  )}
                </div>
              </div>

              {/* Action */}
              <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 self-stretch md:self-auto justify-end border-t md:border-t-0 border-white/10 pt-4 md:pt-0">
                {evento.fecha_limite_acreditacion && (
                  <div class="font-mono text-[11px] text-zinc-400 flex items-center gap-1.5">
                    <Clock class="h-3.5 w-3.5 text-amber-400" />
                    <span>Límite: {new Date(evento.fecha_limite_acreditacion).toLocaleDateString('es-ES', { day: 'numeric', month: 'short' })}</span>
                  </div>
                )}
                <a
                  href={`/acreditaciones?evento=${evento.id}`}
                  class="inline-flex items-center justify-center gap-2 rounded-xl bg-brand-primary px-5 py-3 font-sans font-semibold text-white hover:bg-brand-primary-hover transition-all w-full sm:w-auto shadow-md shadow-rose-950/40"
                >
                  <ShieldCheck class="h-4 w-4" />
                  <span>Acreditarse</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</Layout>
