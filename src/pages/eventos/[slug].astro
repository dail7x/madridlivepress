---
import Layout from '@/layouts/Layout.astro';

export const prerender = false;

const { slug } = Astro.params;
---

<Layout
  title="Conferencia Anual de la Noche y Premios NocheMadrid 2026 | Madrid Live Press"
  description="Ficha oficial de convocatoria, acreditación de medios y dossier de la Conferencia Anual de NocheMadrid 2026."
  lang="es"
>
  <article class="w-full bg-paper pb-16">
    <!-- Breadcrumb -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-8 pb-4">
      <div class="font-mono text-[11px] sm:text-xs text-zinc-600 uppercase tracking-widest flex items-center gap-2">
        <a href="/eventos" class="hover:text-zinc-950 transition-colors">CONVOCATORIAS</a>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-700">AGENDA OFICIAL</span>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-950 font-bold">EVENTO-01</span>
      </div>
    </div>

    <!-- Main Content Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left: Event Information -->
        <div class="lg:col-span-7 space-y-6">
          <div class="flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-vermilion font-bold">
            <span class="w-2.5 h-2.5 rounded-full bg-vermilion inline-block animate-pulse"></span>
            <span>RUEDA DE PRENSA OFICIAL · ACREDITACIONES ABIERTAS</span>
          </div>

          <h1 class="font-display text-3xl sm:text-5xl font-bold text-zinc-950 tracking-tight leading-tight">
            Conferencia Anual de la Noche y Entrega de Premios NocheMadrid 2026
          </h1>

          <div class="prose prose-zinc max-w-none font-sans text-sm sm:text-base text-zinc-700 leading-relaxed space-y-4">
            <p>
              El gabinete de comunicación de NocheMadrid convoca a los medios de comunicación, redactores económicos, agencias internacionales y equipos audiovisuales a la presentación oficial de los datos de cierre del ejercicio 2025-2026 y la entrega de los Premios NocheMadrid a la Innovación y Sostenibilidad.
            </p>
            <h3>Orden del Día de la Convocatoria</h3>
            <ul class="font-mono text-xs text-zinc-800 space-y-2">
              <li><strong>10:30 CET:</strong> Recepción y entrega de pases de prensa y kits de prensa oficiales.</li>
              <li><strong>11:00 CET:</strong> Apertura a cargo de Alejandro Zamarro, Presidente de NocheMadrid.</li>
              <li><strong>11:30 CET:</strong> Presentación del Estudio de Impacto Turístico e Inversión Cultural.</li>
              <li><strong>12:00 CET:</strong> Entrega de Premios NocheMadrid 2026 y turno de preguntas para medios.</li>
              <li><strong>12:45 CET:</strong> Canutazo de prensa y entrevistas individuales con portavoces.</li>
            </ul>
          </div>

          <!-- Quick Action Buttons -->
          <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-zinc-200 font-mono text-xs">
            <a
              href="/acreditaciones"
              class="bg-vermilion hover:bg-rose-700 text-white font-bold py-3.5 px-6 uppercase tracking-wider transition-colors active:scale-[0.98]"
            >
              Solicitar Acreditación de Prensa ↗
            </a>
            <a
              href="/press-kits"
              class="border border-zinc-950 hover:bg-zinc-100 text-zinc-950 font-bold py-3.5 px-6 uppercase tracking-wider transition-colors active:scale-[0.98]"
            >
              Descargar Dossier Previo ↓
            </a>
          </div>
        </div>

        <!-- Right: Technical Card & Venue Specs -->
        <div class="lg:col-span-5 space-y-6">
          <div class="border-2 border-zinc-950 p-6 bg-canvas space-y-4 font-mono text-xs">
            <h3 class="font-bold text-sm text-zinc-950 uppercase tracking-wider border-b border-zinc-200 pb-2">
              DATOS TÉCNICOS DE LA CONVOCATORIA
            </h3>

            <div class="space-y-3">
              <div>
                <span class="text-zinc-500 uppercase text-[10px] block">Fecha y Hora</span>
                <span class="font-bold text-zinc-950 text-sm">Jueves, 15 de Octubre de 2026 · 11:00 CET</span>
              </div>

              <div>
                <span class="text-zinc-500 uppercase text-[10px] block">Recinto Oficial</span>
                <span class="font-bold text-zinc-950 text-sm">Teatro Eslava</span>
                <span class="text-zinc-600 block text-[11px]">Calle Arenal, 11 (Sol / Ópera, Madrid)</span>
              </div>

              <div>
                <span class="text-zinc-500 uppercase text-[10px] block">Instalaciones para Medios</span>
                <span class="text-zinc-800 text-[11px] block">
                  Tarima para cámaras de televisión, splitter de audio balanceado, red Wi-Fi dedicada para agencias y cabina de traducción simultánea ES/EN.
                </span>
              </div>

              <div class="pt-2 border-t border-zinc-200">
                <span class="text-zinc-500 uppercase text-[10px] block">Contacto de Prensa en Sala</span>
                <span class="font-bold text-zinc-950">prensa@nochemadrid.org · +34 91 542 23 00</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>
</Layout>
