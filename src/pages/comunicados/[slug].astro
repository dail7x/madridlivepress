---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import { useTranslations } from '@/lib/i18n';
import type { Comunicado, Categoria, Portavoz } from '@/lib/directus';

export const prerender = false;

const { slug } = Astro.params;
const t = useTranslations('es');

let item: Comunicado | null = null;

try {
  const res = await directus.request(
    readItems('comunicados' as any, {
      filter: {
        slug: { _eq: slug },
        status: { _eq: 'published' },
      },
      fields: [
        'id',
        'status',
        'fecha_publicacion',
        'slug',
        'titulo',
        'bajada',
        'cuerpo',
        'imagen_portada.*',
        'archivo_pdf.*',
        'audio_video_url',
        'tags',
        { categoria: ['id', 'nombre', 'slug', 'color'] },
        { portavoz: ['id', 'nombre', 'cargo', 'bio', 'avatar.*', 'email_prensa'] },
      ],
      limit: 1,
    })
  );

  item = ((res as any) && (res as any)[0]) || null;
} catch (e) {
  console.error(`Error loading press release "${slug}":`, e);
}

if (!item) {
  return Astro.redirect('/404');
}

const cat = item.categoria as Categoria | undefined;
const portavoz = item.portavoz as Portavoz | undefined;
const pdfUrl = item.archivo_pdf ? getAssetUrl(item.archivo_pdf) : null;
const heroImg = item.imagen_portada
  ? getAssetUrl(item.imagen_portada, { quality: 90, format: 'webp' })
  : 'https://images.unsplash.com/photo-1507676184212-d03ab07a01bf?q=80&w=1200&auto=format&fit=crop';

const pubDate = item.fecha_publicacion ? new Date(item.fecha_publicacion) : new Date();
const formattedDate = pubDate.toLocaleDateString('es-ES', {
  day: '2-digit',
  month: 'short',
  year: 'numeric',
}).toUpperCase();

const npCode = `NP-04${String(item.id || 1).padStart(2, '0')}`;
const tagsList = item.tags && item.tags.length > 0
  ? item.tags
  : ['COMUNICACIÓN SECTORIAL', 'TURISMO CULTURAL', 'MADRID'];
---

<Layout
  title={`${item.titulo} | Madrid Live Press`}
  description={item.bajada || item.titulo}
  image={heroImg}
  lang="es"
>
  <article class="w-full bg-paper">
    <!-- Top Monospaced Breadcrumb (Exact Reference 2) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
      <div class="font-mono text-xs text-zinc-600 uppercase tracking-widest flex items-center gap-3">
        <a href="/comunicados" class="hover:text-zinc-950 transition-colors">NOTAS DE PRENSA</a>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-700">{cat?.nombre?.toUpperCase() || 'ARTES ESCÉNICAS'}</span>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-900 font-semibold">{npCode}</span>
      </div>
    </div>

    <!-- Article Hero Grid (Exact Reference 2) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Left Column: Metadata + Titles (~58% width) -->
        <div class="lg:col-span-7 flex flex-col md:flex-row gap-6 lg:gap-8">
          <!-- Left Dateline Sidebar (Exact Reference 2) -->
          <div class="w-full md:w-32 flex-shrink-0 font-mono text-xs text-zinc-500 space-y-4 border-b md:border-b-0 md:border-r border-zinc-200 pb-4 md:pb-0 md:pr-4">
            <div class="flex items-center gap-1.5 text-zinc-950 font-bold tracking-wider">
              <span class="w-2 h-2 rounded-full bg-vermilion inline-block"></span>
              <span>PUBLICADO</span>
            </div>
            <div class="space-y-1 text-zinc-700 font-medium">
              <div>{formattedDate}</div>
              <div>10:30 CET</div>
              <div class="font-bold text-zinc-900">MADRID</div>
            </div>
            <div class="pt-2 border-t border-zinc-200 text-[11px] text-zinc-500">
              LECTURA 6 MIN
            </div>
          </div>

          <!-- Main Title & Lead (Exact Reference 2) -->
          <div class="flex-1 space-y-6">
            <h1 class="font-display text-3xl sm:text-4xl lg:text-[2.75rem] font-bold text-zinc-950 leading-[1.12] tracking-tight text-balance">
              {item.titulo}
            </h1>

            {item.bajada && (
              <p class="font-sans text-base sm:text-lg text-zinc-700 leading-relaxed">
                {item.bajada}
              </p>
            )}

            <!-- Tags Separated by Vertical Pipes (Exact Reference 2) -->
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 pt-2 font-mono text-[11px] text-zinc-600 tracking-wider uppercase">
              {tagsList.map((tag: string, index: number) => (
                <>
                  <span class="hover:text-zinc-950 transition-colors">{tag}</span>
                  {index < tagsList.length - 1 && <span class="text-zinc-300">|</span>}
                </>
              ))}
            </div>

            <!-- Action Buttons (Exact Reference 2) -->
            <div class="flex flex-wrap items-center gap-6 pt-4 font-sans text-xs text-zinc-800 border-t border-zinc-200">
              {pdfUrl ? (
                <a
                  href={pdfUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 font-medium hover:text-vermilion transition-colors group"
                >
                  <span>↓ Descargar nota · PDF ↓</span>
                </a>
              ) : (
                <button
                  onclick="window.print()"
                  class="inline-flex items-center gap-1.5 font-medium hover:text-vermilion transition-colors"
                >
                  <span>↓ Descargar nota · PDF ↓</span>
                </button>
              )}

              <button
                id="copyLinkBtn"
                type="button"
                class="inline-flex items-center gap-1.5 font-medium hover:text-vermilion transition-colors"
              >
                <span>🔗 Copiar enlace</span>
              </button>

              <button
                id="shareBtn"
                type="button"
                class="inline-flex items-center gap-1.5 font-medium hover:text-vermilion transition-colors"
              >
                <span>↗ Compartir</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Right Column: Editorial Photo with Vertical Credit (Exact Reference 2) -->
        <div class="lg:col-span-5 relative">
          <div class="relative border border-zinc-200 aspect-[4/3] w-full overflow-hidden bg-zinc-100">
            <img
              src={heroImg}
              alt={item.titulo}
              class="h-full w-full object-cover filter contrast-105"
            />
          </div>
          <!-- Subtle Vertical Copyright Caption (Exact Reference 2) -->
          <div class="hidden lg:block absolute -right-6 top-0 h-full">
            <span class="writing-vertical font-mono text-[9px] text-zinc-400 tracking-wider select-none whitespace-nowrap">
              © Madrid Live Press / Archivo
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Full-Width Sub-Navigation Download Strip (Exact Reference 2) -->
    <div class="w-full border-t border-b border-zinc-200 bg-canvas my-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 divide-y md:divide-y-0 md:divide-x divide-zinc-200 font-mono text-[11px] tracking-wider uppercase text-zinc-700">
          <a
            href="/recursos-prensa"
            class="py-3 px-4 flex items-center justify-between hover:text-zinc-950 hover:bg-zinc-100 transition-colors"
          >
            <span>PRESS KIT COMPLETO</span>
            <span>↓</span>
          </a>
          <a
            href="/recursos-prensa"
            class="py-3 px-4 flex items-center justify-between hover:text-zinc-950 hover:bg-zinc-100 transition-colors"
          >
            <span>18 FOTOGRAFÍAS · 300 DPI</span>
            <span>↓</span>
          </a>
          <a
            href="/recursos-prensa"
            class="py-3 px-4 flex items-center justify-between hover:text-zinc-950 hover:bg-zinc-100 transition-colors"
          >
            <span>DOSSIER ES / EN</span>
            <span>↓</span>
          </a>
          <a
            href="mailto:prensa@nochemadrid.org"
            class="py-3 px-4 flex items-center justify-between hover:text-zinc-950 hover:bg-zinc-100 transition-colors"
          >
            <span>CONTACTO DE PRENSA</span>
            <span>↓</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Article Body & Sidebars (Exact Reference 2) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <!-- Left Main Body Column (~50% width) -->
        <div class="lg:col-span-6 space-y-6">
          <!-- Red Accent Bar beside Lead (Exact Reference 2) -->
          <div class="flex items-start gap-4">
            <div class="w-8 h-1 bg-vermilion flex-shrink-0 mt-3"></div>
            <div class="prose prose-zinc max-w-none font-sans text-base sm:text-[17px] leading-[1.8] text-zinc-800">
              <p class="font-bold text-zinc-950 inline">
                MADRID, {pubDate.getDate()} de {pubDate.toLocaleDateString('es-ES', { month: 'long' })} de {pubDate.getFullYear()}.—
              </p>
              {item.cuerpo ? (
                <div set:html={item.cuerpo} class="inline space-y-4" />
              ) : (
                <span>
                  Las salas y espacios escénicos de Madrid presentan hoy una estrategia conjunta para reforzar su proyección cultural internacional y facilitar el trabajo de los medios de comunicación de todo el mundo.
                  <br /><br />
                  La iniciativa, impulsada por el sector y coordinada a través de Madrid Live Press, ofrece un punto único de acceso a información verificada, datos actualizados y materiales audiovisuales de alta calidad sobre la actividad cultural de la ciudad.
                  <br /><br />
                  El objetivo es mejorar la visibilidad global de Madrid como destino cultural, fomentar el turismo cultural responsable y estrechar la colaboración con periodistas, editores y creadores de contenidos.
                </span>
              )}
            </div>
          </div>
        </div>

        <!-- Middle Column: Large Pull Quote (Exact Reference 2) -->
        <div class="lg:col-span-3 lg:border-l lg:border-zinc-200 lg:pl-8 space-y-4">
          <!-- Red quotation mark -->
          <span class="text-4xl sm:text-5xl font-serif text-vermilion leading-none block select-none">“</span>
          
          <blockquote class="font-display text-xl sm:text-2xl font-semibold text-zinc-950 leading-snug tracking-tight">
            {portavoz?.bio || 'Madrid necesita una voz cultural colectiva, accesible y preparada para circular por el mundo.'}
          </blockquote>

          <div class="pt-4 font-mono text-[11px] text-zinc-500 uppercase tracking-widest leading-relaxed">
            <div class="font-bold text-zinc-900">{portavoz?.nombre || 'MARINA SANZ'}</div>
            <div>{portavoz?.cargo || 'PORTAVOZ DEL SECTOR ESCÉNICO DE MADRID'}</div>
          </div>
        </div>

        <!-- Right Column: Sidebar Table of Contents & Official Seal (Exact Reference 2) -->
        <div class="lg:col-span-3 space-y-8 lg:border-l lg:border-zinc-200 lg:pl-8">
          <!-- Table of Contents -->
          <div class="space-y-3">
            <h4 class="font-mono text-xs font-bold text-zinc-400 uppercase tracking-widest">
              EN ESTA NOTA
            </h4>
            <ul class="space-y-2 font-sans text-sm text-zinc-700 divide-y divide-zinc-100">
              <li class="pt-2"><a href="#contexto" class="hover:text-vermilion flex items-center gap-2"><span>→</span> Contexto</a></li>
              <li class="pt-2"><a href="#datos" class="hover:text-vermilion flex items-center gap-2"><span>→</span> Datos principales</a></li>
              <li class="pt-2"><a href="#declaraciones" class="hover:text-vermilion flex items-center gap-2"><span>→</span> Declaraciones</a></li>
              <li class="pt-2"><a href="#recursos" class="hover:text-vermilion flex items-center gap-2"><span>→</span> Recursos</a></li>
            </ul>
          </div>

          <!-- Official Verification Card (Exact Reference 2) -->
          <div class="border border-zinc-200 p-5 bg-canvas space-y-2">
            <div class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-wider text-zinc-500">
              <span>FUENTE OFICIAL</span>
              <span class="w-3.5 h-3.5 rounded-full bg-vermilion text-white flex items-center justify-center text-[8px] font-bold">✓</span>
            </div>
            <div class="font-mono text-sm font-bold text-zinc-950 tracking-wider uppercase">
              NOCHE MADRID
            </div>
            <div class="font-mono text-[11px] text-zinc-500 uppercase tracking-widest">
              96 SALAS Y EMPRESAS
            </div>
          </div>
        </div>
      </div>
    </div>
  </article>

  <!-- Interactive Scripts -->
  <script>
    const copyBtn = document.getElementById('copyLinkBtn');
    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const originalText = copyBtn.innerHTML;
        copyBtn.innerHTML = '<span>✓ Copiado al portapapeles</span>';
        setTimeout(() => {
          copyBtn.innerHTML = originalText;
        }, 2000);
      } catch (e) {}
    });

    const shareBtn = document.getElementById('shareBtn');
    shareBtn?.addEventListener('click', async () => {
      if (navigator.share) {
        try {
          await navigator.share({
            title: document.title,
            url: window.location.href,
          });
        } catch (e) {}
      } else {
        copyBtn?.click();
      }
    });
  </script>
</Layout>
