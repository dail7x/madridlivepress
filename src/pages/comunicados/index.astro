---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import { useTranslations } from '@/lib/i18n';
import type { Comunicado, Categoria } from '@/lib/directus';
import { FileText, Download, Calendar, ArrowRight, ChevronRight, Tag } from 'lucide-astro';

export const prerender = false;

const t = useTranslations('es');
const catSlug = Astro.url.searchParams.get('cat');

let comunicados: Comunicado[] = [];
let categorias: Categoria[] = [];

try {
  const [comunicadosRes, categoriasRes] = await Promise.all([
    directus.request(
      readItems('comunicados' as any, {
        filter: { status: { _eq: 'published' } },
        sort: ['-fecha_publicacion', '-id'],
        fields: [
          'id',
          'status',
          'fecha_publicacion',
          'slug',
          'titulo',
          'bajada',
          'imagen_portada.*',
          'archivo_pdf.*',
          'tags',
          { categoria: ['id', 'nombre', 'slug', 'color'] },
          { portavoz: ['id', 'nombre', 'cargo'] },
        ],
      })
    ),
    directus.request(
      readItems('categorias' as any, {
        fields: ['id', 'nombre', 'slug', 'color'],
      })
    ),
  ]);

  comunicados = (comunicadosRes as any) || [];
  categorias = (categoriasRes as any) || [];
} catch (e) {
  console.error('Error in /comunicados:', e);
}

// Filter by category if param is present
const filteredComunicados = catSlug
  ? comunicados.filter((c) => (c.categoria as Categoria)?.slug === catSlug)
  : comunicados;
---

<Layout
  title="Sala de Comunicados y Notas de Prensa Oficiales"
  description="Archivo completo de notas de prensa, balances económicos e informes oficiales de NocheMadrid."
  lang="es"
>
  <div class="space-y-10">
    {/* Page Header */}
    <div class="space-y-3 border-b border-white/10 pb-8">
      <div class="inline-flex items-center gap-2 text-brand-primary font-mono text-xs uppercase tracking-widest font-semibold">
        <FileText class="h-4 w-4" />
        <span>Hemeroteca de Medios</span>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        {t.press.title}
      </h1>
      <p class="font-sans text-lg text-zinc-300 max-w-3xl">
        {t.press.subtitle}
      </p>
    </div>

    {/* Category Filter Chips */}
    {categorias.length > 0 && (
      <div class="flex flex-wrap items-center gap-2 pb-2">
        <a
          href="/comunicados"
          class:list={[
            'rounded-full px-4 py-2 font-mono text-xs font-medium transition-all',
            !catSlug
              ? 'bg-brand-primary text-white shadow-md shadow-rose-950/40'
              : 'bg-surface/80 text-zinc-300 border border-white/10 hover:border-white/20 hover:text-white',
          ]}
        >
          {t.press.filterAll}
        </a>
        {categorias.map((cat) => {
          const isSelected = catSlug === cat.slug;
          return (
            <a
              href={`/comunicados?cat=${cat.slug}`}
              class:list={[
                'rounded-full px-4 py-2 font-mono text-xs font-medium transition-all',
                isSelected
                  ? 'bg-brand-primary text-white shadow-md shadow-rose-950/40'
                  : 'bg-surface/80 text-zinc-300 border border-white/10 hover:border-white/20 hover:text-white',
              ]}
            >
              {cat.nombre}
            </a>
          );
        })}
      </div>
    )}

    {/* List of Releases */}
    {filteredComunicados.length === 0 ? (
      <div class="rounded-2xl border border-white/10 bg-surface/50 p-12 text-center text-zinc-400">
        No se encontraron comunicados para esta categoría.
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {filteredComunicados.map((item) => {
          const coverUrl = item.imagen_portada
            ? getAssetUrl(item.imagen_portada, { width: 800, height: 450, quality: 80, format: 'webp' })
            : null;
          const pdfUrl = item.archivo_pdf ? getAssetUrl(item.archivo_pdf) : null;
          const cat = item.categoria as Categoria | undefined;
          const detailUrl = `/comunicados/${item.slug}`;

          return (
            <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-surface/80 transition-all duration-300 hover:border-white/20 hover:shadow-2xl hover:shadow-rose-950/20 backdrop-blur-md">
              <div>
                <a href={detailUrl} class="relative block aspect-[16/9] w-full overflow-hidden bg-zinc-900">
                  {coverUrl ? (
                    <img
                      src={coverUrl}
                      alt={item.titulo}
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                    />
                  ) : (
                    <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-surface to-background p-6">
                      <span class="font-mono text-xs uppercase tracking-widest text-zinc-500">Madrid Live Press</span>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-60"></div>
                  {cat && (
                    <span class="absolute top-3 left-3 rounded-md bg-black/70 px-2.5 py-1 font-mono text-[11px] font-semibold text-rose-300 border border-white/10 backdrop-blur-md">
                      {cat.nombre}
                    </span>
                  )}
                </a>

                <div class="p-6 space-y-3">
                  <div class="flex items-center gap-2 font-mono text-xs text-zinc-400">
                    <Calendar class="h-3.5 w-3.5 text-zinc-500" />
                    <time datetime={item.fecha_publicacion}>
                      {new Date(item.fecha_publicacion || Date.now()).toLocaleDateString('es-ES', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                      })}
                    </time>
                    <span class="text-zinc-600">•</span>
                    <span>Madrid</span>
                  </div>

                  <h2 class="font-display text-xl font-bold text-white leading-snug group-hover:text-rose-400 transition-colors">
                    <a href={detailUrl}>{item.titulo}</a>
                  </h2>

                  {item.bajada && (
                    <p class="font-sans text-sm text-zinc-400 line-clamp-3 leading-relaxed">
                      {item.bajada}
                    </p>
                  )}
                </div>
              </div>

              <div class="flex items-center justify-between border-t border-white/10 px-6 py-4 bg-black/20">
                <a
                  href={detailUrl}
                  class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-zinc-300 hover:text-white transition-colors"
                >
                  <span>{t.press.readMore}</span>
                  <ChevronRight class="h-3.5 w-3.5" />
                </a>

                {pdfUrl && (
                  <a
                    href={pdfUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    download
                    class="inline-flex items-center gap-1 rounded-md bg-white/5 px-2.5 py-1 font-mono text-xs font-medium text-amber-300 border border-amber-400/20 hover:bg-amber-400/10 transition-colors"
                    title={t.press.downloadPdf}
                  >
                    <Download class="h-3 w-3" />
                    <span>PDF</span>
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</Layout>
