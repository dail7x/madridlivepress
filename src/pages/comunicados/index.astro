---
import Layout from '@/layouts/Layout.astro';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import type { Comunicado, Categoria } from '@/lib/directus';

export const prerender = false;

const catSlug = Astro.url.searchParams.get('cat');

let comunicados: Comunicado[] = [];
let categorias: Categoria[] = [];

try {
  const [comunicadosRes, categoriasRes] = await Promise.all([
    directus.request(
      readItems('comunicados' as any, {
        filter: { status: { _eq: 'published' } },
        sort: ['-fecha_publicacion', '-id'],
        fields: [
          'id',
          'status',
          'fecha_publicacion',
          'slug',
          'titulo',
          'bajada',
          'imagen_portada.*',
          'archivo_pdf.*',
          'tags',
          { categoria: ['id', 'nombre', 'slug', 'color'] },
          { portavoz: ['id', 'nombre', 'cargo'] },
        ],
      })
    ),
    directus.request(
      readItems('categorias' as any, {
        fields: ['id', 'nombre', 'slug', 'color'],
        sort: ['nombre'],
      })
    ),
  ]);

  comunicados = (comunicadosRes as any) || [];
  categorias = (categoriasRes as any) || [];
} catch (e) {
  console.error('Error in /comunicados:', e);
}

const filteredComunicados = catSlug
  ? comunicados.filter((c) => (c.categoria as Categoria)?.slug === catSlug)
  : comunicados;
---

<Layout
  title="Notas de Prensa y Comunicados Oficiales | Madrid Live Press"
  description="Archivo completo de comunicados oficiales, balances sectoriales y convocatorias de prensa de NocheMadrid."
  lang="es"
>
  <div class="w-full bg-paper">
    <!-- Top Monospaced Breadcrumb -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-4">
      <div class="font-mono text-xs text-zinc-400 uppercase tracking-widest flex items-center gap-3">
        <a href="/" class="hover:text-zinc-950 transition-colors">PORTADA</a>
        <span class="text-zinc-300">/</span>
        <span class="text-zinc-900 font-semibold">NOTAS DE PRENSA</span>
      </div>
    </div>

    <!-- Page Header (Swiss Minimalist) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 border-b border-zinc-200">
      <div class="space-y-3">
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-zinc-950 tracking-tight">
          Hemeroteca de Notas de Prensa
        </h1>
        <p class="font-sans text-base text-zinc-600 max-w-3xl leading-relaxed">
          Servicio informativo para periodistas, redacciones y medios internacionales. Acceso a declaraciones oficiales, datos del sector del ocio y material audiovisual verificado.
        </p>
      </div>

      <!-- Filter Buttons -->
      <div class="flex flex-wrap gap-2 pt-8">
        <a
          href="/comunicados"
          class={`font-mono text-xs uppercase px-3 py-1.5 border tracking-wider transition-colors ${
            !catSlug
              ? 'border-zinc-900 bg-zinc-900 text-white'
              : 'border-zinc-200 hover:border-zinc-900 text-zinc-700 hover:text-zinc-950'
          }`}
        >
          Todas las notas
        </a>
        {categorias.map((c) => {
          const isActive = catSlug === c.slug;
          return (
            <a
              href={`/comunicados?cat=${c.slug}`}
              class={`font-mono text-xs uppercase px-3 py-1.5 border tracking-wider transition-colors ${
                isActive
                  ? 'border-zinc-900 bg-zinc-900 text-white'
                  : 'border-zinc-200 hover:border-zinc-900 text-zinc-700 hover:text-zinc-950'
              }`}
            >
              {c.nombre}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Press Releases List -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="divide-y divide-zinc-200 border-t border-b border-zinc-200">
        {filteredComunicados.length === 0 ? (
          <div class="py-16 text-center text-zinc-500 font-sans text-sm">
            No se han encontrado notas de prensa en esta categoría.
          </div>
        ) : (
          filteredComunicados.map((item, index) => {
            const cat = item.categoria as Categoria | undefined;
            const pdf = item.archivo_pdf ? getAssetUrl(item.archivo_pdf) : null;
            const pubDate = item.fecha_publicacion ? new Date(item.fecha_publicacion) : new Date();
            const dateFormatted = pubDate.toLocaleDateString('es-ES', {
              day: '2-digit',
              month: 'short',
              year: 'numeric',
            }).toUpperCase();

            const npCode = `NP-04${String(item.id || index + 1).padStart(2, '0')}`;

            return (
              <article class="py-6 sm:py-8 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-start group hover:bg-canvas transition-colors px-2">
                <!-- Metadata (~25%) -->
                <div class="md:col-span-3 font-mono text-xs text-zinc-500 space-y-1">
                  <div class="text-zinc-950 font-bold tracking-wider">{dateFormatted}</div>
                  <div class="text-zinc-400">{npCode}</div>
                  {cat && (
                    <div class="text-zinc-600 uppercase tracking-widest pt-1 font-semibold">
                      {cat.nombre}
                    </div>
                  )}
                </div>

                <!-- Title & Bajada (~65%) -->
                <div class="md:col-span-7 space-y-2">
                  <h2 class="font-display text-lg sm:text-xl font-semibold text-zinc-950 leading-snug group-hover:text-vermilion transition-colors">
                    <a href={`/comunicados/${item.slug}`}>
                      {item.titulo}
                    </a>
                  </h2>

                  {item.bajada && (
                    <p class="font-sans text-sm text-zinc-600 line-clamp-2 leading-relaxed">
                      {item.bajada}
                    </p>
                  )}
                </div>

                <!-- Action (~10%) -->
                <div class="md:col-span-2 flex md:justify-end items-center gap-3 pt-2 md:pt-0 font-sans text-xs">
                  {pdf && (
                    <a
                      href={pdf}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="font-mono text-[11px] uppercase tracking-wider text-zinc-500 hover:text-vermilion transition-colors"
                    >
                      PDF ↓
                    </a>
                  )}

                  <a
                    href={`/comunicados/${item.slug}`}
                    class="font-sans text-sm font-semibold text-zinc-900 group-hover:text-vermilion transition-colors"
                  >
                    ↗
                  </a>
                </div>
              </article>
            );
          })
        )}
      </div>
    </div>
  </div>
</Layout>
