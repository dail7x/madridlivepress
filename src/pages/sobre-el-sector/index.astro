---
import Layout from '@/layouts/Layout.astro';
import WireframeHeader from '@/components/ui/WireframeHeader.astro';
import { association, pressOffice } from '@/lib/contacts';

export const prerender = false;
---

<Layout
  title="Sobre nosotros | Noche Madrid Press"
  description="Noche Madrid es la asociación de empresarios del ocio nocturno de la Comunidad de Madrid. Sector: ocio nocturno y espectáculos."
  lang="es"
  alternateUrlEs="/sobre-el-sector"
  alternateUrlEn="/en/about"
>
  <div class="w-full bg-paper pb-16">
    <WireframeHeader
      title="SOBRE NOSOTROS"
      subtitle="Noche Madrid es la asociación de empresarios del ocio nocturno de la Comunidad de Madrid. Sector: ocio nocturno y espectáculos."
      badge="ASOCIACIÓN"
      updatedTime="DESDE 2010"
    />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-7 space-y-6">
          <h2 class="font-display text-2xl sm:text-4xl font-bold text-zinc-950 tracking-tight leading-tight">
            Una asociación empresarial para la noche de Madrid.
          </h2>

          <div class="font-sans text-sm sm:text-base text-zinc-700 leading-relaxed space-y-4">
            <p>
              <strong>Noche Madrid</strong> es la asociación de empresarios del ocio nocturno de la Comunidad de Madrid. No es una federación. Su sector es el <strong>ocio nocturno y los espectáculos</strong>.
            </p>
            <p>
              Es la principal organización empresarial del ocio nocturno de Madrid e integra las actividades recreativas, culturales, la gastronomía y los espectáculos que forman parte de la vida nocturna.
            </p>
            <p>
              Se constituyó en 2010 al integrarse la Asociación de Empresarios de Espectáculos, Salas de Fiesta y Ocio de la Comunidad de Madrid (ASFYDIS) y la Asociación Madrileña de Empresarios por la Calidad del Ocio (ECO). Desde entonces trabaja en la defensa y la dignificación de la actividad profesional y empresarial del ocio y los espectáculos.
            </p>
            <p class="font-mono text-[11px] text-zinc-500 uppercase tracking-wider">
              Texto institucional a partir de{' '}
              <a href="https://nochemadrid.org/quienes-somos/" class="underline hover:text-vermilion" target="_blank" rel="noopener noreferrer">nochemadrid.org/quienes-somos</a>.
            </p>
          </div>

          <div class="pt-2 flex flex-wrap gap-4 font-mono text-xs">
            <a
              href="/estudios"
              class="bg-zinc-950 text-white hover:bg-vermilion px-5 py-3 font-bold uppercase tracking-wider transition-colors inline-flex items-center gap-1.5"
            >
              <span>Estudios y campañas</span>
              <span>→</span>
            </a>
            <a
              href="/comunicados"
              class="border border-zinc-950 hover:bg-zinc-100 text-zinc-950 px-5 py-3 font-bold uppercase tracking-wider transition-colors inline-flex items-center gap-1.5"
            >
              <span>Notas de prensa</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-5 grid grid-cols-1 gap-4 bg-canvas p-6 border border-zinc-200 font-mono">
          <div class="border-b border-zinc-200 pb-4">
            <div class="font-display text-xl font-bold text-zinc-950">Asociación</div>
            <div class="text-[11px] text-zinc-500 uppercase tracking-widest mt-1">Empresarios del ocio nocturno</div>
          </div>
          <div class="border-b border-zinc-200 pb-4">
            <div class="font-display text-xl font-bold text-zinc-950">Comunidad de Madrid</div>
            <div class="text-[11px] text-zinc-500 uppercase tracking-widest mt-1">Ámbito territorial</div>
          </div>
          <div>
            <div class="font-display text-xl font-bold text-zinc-950">Ocio nocturno y espectáculos</div>
            <div class="text-[11px] text-zinc-500 uppercase tracking-widest mt-1">Sector</div>
          </div>
        </div>
      </div>

      <div id="contacto" class="border-t border-zinc-200 pt-10">
        <h3 class="font-mono text-xs font-bold text-zinc-400 uppercase tracking-widest mb-6">
          Contacto
        </h3>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="border border-zinc-200 p-6 bg-paper space-y-4">
            <div>
              <h4 class="font-display text-lg font-bold text-zinc-950">{association.name}</h4>
              <p class="font-mono text-xs text-zinc-500 uppercase">{association.description}</p>
            </div>
            <p class="font-sans text-sm text-zinc-600 leading-relaxed">
              Sede y contacto general publicados en nocheMadrid.org.
            </p>
            <div class="space-y-1 font-mono text-xs">
              <a href={`mailto:${association.email}`} class="block text-vermilion font-bold hover:underline">{association.email}</a>
              <a href={`tel:${association.phoneTel}`} class="block text-zinc-950 font-bold">{association.phoneDisplay}</a>
              <div class="text-zinc-500">{association.address} · {association.city}</div>
            </div>
          </div>

          <div class="border border-zinc-200 p-6 bg-paper space-y-4">
            <div>
              <h4 class="font-display text-lg font-bold text-zinc-950">{pressOffice.name}</h4>
              <p class="font-mono text-xs text-zinc-500 uppercase">{pressOffice.office}</p>
            </div>
            <p class="font-sans text-sm text-zinc-600 leading-relaxed">
              Contacto de prensa principal para medios, agencias y corresponsales.
            </p>
            <div class="space-y-1 font-mono text-xs">
              <a href={`tel:${pressOffice.phoneTel}`} class="block text-vermilion font-bold">Tel. {pressOffice.phoneDisplay}</a>
              <div class="text-zinc-500">{pressOffice.lineEs}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
