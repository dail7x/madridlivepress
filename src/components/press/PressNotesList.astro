---
import { hasPressPdf, resolvePressPdfUrl } from '@/lib/pressPdf';
import type { Comunicado } from '@/lib/directus';

interface Props {
  items: Comunicado[];
  lang?: 'es' | 'en';
}

const { items: sourceItems, lang = 'es' } = Astro.props;
const items = sourceItems.filter((item) => hasPressPdf(item));
const isEn = lang === 'en';
const base = isEn ? '/en/news' : '/notasdeprensa';
const PAGE_SIZE = 12;

const MONTHS_ES = ['ENE', 'FEB', 'MAR', 'ABR', 'MAY', 'JUN', 'JUL', 'AGO', 'SEP', 'OCT', 'NOV', 'DIC'];
const MONTHS_EN = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];

function monthKey(iso: string): string {
  if (/^\d{4}-\d{2}/.test(iso)) return iso.slice(0, 7);
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return '';
  const parts = new Intl.DateTimeFormat('en-CA', {
    timeZone: 'Europe/Madrid',
    year: 'numeric',
    month: '2-digit',
  }).format(date);
  return parts.slice(0, 7);
}

function formatDate(iso: string): string {
  const date = new Date(iso);
  if (Number.isNaN(date.getTime())) return '';
  return date
    .toLocaleDateString(isEn ? 'en-GB' : 'es-ES', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
    })
    .toUpperCase();
}

function monthLabel(key: string): string {
  const [year, month] = key.split('-');
  const names = isEn ? MONTHS_EN : MONTHS_ES;
  const index = Number(month) - 1;
  if (!year || index < 0 || index > 11) return key;
  return `${names[index]} ${year.slice(2)}`;
}

const rows = items
  .map((item) => {
    const iso = item.fecha_publicacion || '';
    const slug = (isEn ? item.slug_en || item.slug : item.slug) || '';
    const title = (isEn ? item.titulo_en || item.titulo : item.titulo) || item.titulo || '';
    return {
      id: String(item.id ?? slug),
      iso,
      month: monthKey(iso),
      dateLabel: iso ? formatDate(iso) : '',
      title,
      href: slug ? `${base}/${slug}` : base,
      pdfUrl: resolvePressPdfUrl(item),
    };
  })
  .filter((row) => row.title && row.pdfUrl);

const months = [...new Set(rows.map((row) => row.month).filter(Boolean))].sort().reverse();

const mesParam = Astro.url.searchParams.get('mes') || 'all';
const mes = mesParam === 'all' || months.includes(mesParam) ? mesParam : 'all';
const orden = Astro.url.searchParams.get('orden') === 'asc' ? 'asc' : 'desc';
const requestedPage = Number.parseInt(Astro.url.searchParams.get('pagina') || '1', 10);

const filtered = rows
  .filter((row) => mes === 'all' || row.month === mes)
  .sort((a, b) => {
    const byDate = a.iso.localeCompare(b.iso);
    if (byDate !== 0) return orden === 'asc' ? byDate : -byDate;
    return orden === 'asc' ? a.id.localeCompare(b.id) : b.id.localeCompare(a.id);
  });

const total = filtered.length;
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const page = Math.min(Math.max(Number.isFinite(requestedPage) ? requestedPage : 1, 1), totalPages);
const start = (page - 1) * PAGE_SIZE;
const pageRows = filtered.slice(start, start + PAGE_SIZE);
const rangeFrom = total === 0 ? 0 : start + 1;
const rangeTo = start + pageRows.length;

function pageHref(next: { mes?: string; orden?: 'asc' | 'desc'; pagina?: number }): string {
  const params = new URLSearchParams();
  const month = next.mes ?? mes;
  const sort = next.orden ?? orden;
  const nextPage = next.pagina ?? 1;
  if (month && month !== 'all') params.set('mes', month);
  if (sort === 'asc') params.set('orden', 'asc');
  if (nextPage > 1) params.set('pagina', String(nextPage));
  const query = params.toString();
  return query ? `${Astro.url.pathname}?${query}` : Astro.url.pathname;
}

const sortLabel = orden === 'desc'
  ? (isEn ? 'Most recent ↓' : 'Más reciente ↓')
  : (isEn ? 'Oldest ↑' : 'Más antiguo ↑');
const sortNext = orden === 'desc' ? 'asc' : 'desc';
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16" aria-label={isEn ? 'Press notes' : 'Notas de prensa'}>
  <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4 py-4 border-b border-zinc-200">
    <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-[11px] uppercase tracking-wider" aria-label={isEn ? 'Filter by month' : 'Filtrar por mes'}>
      <a
        href={pageHref({ mes: 'all', pagina: 1 })}
        class:list={[
          'hover:text-zinc-950',
          mes === 'all' ? 'text-vermilion font-bold' : 'text-zinc-500',
        ]}
        aria-current={mes === 'all' ? 'true' : undefined}
      >
        {isEn ? 'All months' : 'Todos los meses'}
      </a>
      {months.map((key) => (
        <a
          href={pageHref({ mes: key, pagina: 1 })}
          class:list={[
            'hover:text-zinc-950',
            mes === key ? 'text-vermilion font-bold' : 'text-zinc-500',
          ]}
          aria-current={mes === key ? 'true' : undefined}
        >
          {monthLabel(key)}
        </a>
      ))}
    </nav>

    <a
      href={pageHref({ orden: sortNext, pagina: 1 })}
      class="inline-flex items-center self-start border border-zinc-950 px-3 py-1.5 font-mono text-[11px] font-bold uppercase tracking-wider text-zinc-950 hover:bg-zinc-950 hover:text-white transition-colors"
      aria-label={isEn ? 'Change sort order' : 'Cambiar el orden'}
    >
      {sortLabel}
    </a>
  </div>

  {total > 0 && (
    <p class="pt-3 font-mono text-[11px] uppercase tracking-wider text-zinc-500">
      {isEn
        ? `Showing ${rangeFrom}–${rangeTo} of ${total}`
        : `Mostrando ${rangeFrom}–${rangeTo} de ${total}`}
    </p>
  )}

  {pageRows.length === 0 ? (
    <p class="py-12 font-sans text-sm text-zinc-500">
      {isEn ? 'There are no press notes for this period.' : 'No hay notas de prensa en este periodo.'}
    </p>
  ) : (
    <ul class="mt-2 divide-y divide-zinc-200 border-b border-zinc-200">
      {pageRows.map((row) => (
        <li class="grid grid-cols-1 sm:grid-cols-12 gap-2 sm:gap-4 items-center py-3.5">
          <time datetime={row.iso} class="sm:col-span-2 font-mono text-[11px] text-zinc-500 uppercase">
            {row.dateLabel}
          </time>
          <a href={row.href} class="sm:col-span-7 font-display text-sm sm:text-base font-semibold text-zinc-950 hover:text-vermilion leading-snug">
            {row.title}
          </a>
          <div class="sm:col-span-3 sm:text-right">
            <a
              href={row.pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex font-mono text-[11px] font-bold uppercase tracking-wider text-zinc-950 border border-zinc-950 hover:bg-zinc-950 hover:text-white px-2.5 py-1.5 transition-colors"
            >
              {isEn ? 'Download PDF' : 'Descargar PDF'} ↓
            </a>
          </div>
        </li>
      ))}
    </ul>
  )}

  {totalPages > 1 && (
    <nav class="flex flex-wrap items-center gap-2 pt-6 font-mono text-[11px] uppercase tracking-wider" aria-label={isEn ? 'Pagination' : 'Paginación'}>
      {page > 1 ? (
        <a href={pageHref({ pagina: page - 1 })} class="border border-zinc-300 px-2.5 py-1.5 text-zinc-800 hover:border-zinc-950">
          {isEn ? 'Previous' : 'Anterior'}
        </a>
      ) : (
        <span class="border border-zinc-200 px-2.5 py-1.5 text-zinc-300">{isEn ? 'Previous' : 'Anterior'}</span>
      )}

      {Array.from({ length: totalPages }, (_, index) => index + 1).map((number) => (
        <a
          href={pageHref({ pagina: number })}
          class:list={[
            'min-w-8 px-2.5 py-1.5 text-center border',
            number === page ? 'border-zinc-950 bg-zinc-950 text-white font-bold' : 'border-zinc-300 text-zinc-700 hover:border-zinc-950',
          ]}
          aria-current={number === page ? 'page' : undefined}
        >
          {number}
        </a>
      ))}

      {page < totalPages ? (
        <a href={pageHref({ pagina: page + 1 })} class="border border-zinc-300 px-2.5 py-1.5 text-zinc-800 hover:border-zinc-950">
          {isEn ? 'Next' : 'Siguiente'}
        </a>
      ) : (
        <span class="border border-zinc-200 px-2.5 py-1.5 text-zinc-300">{isEn ? 'Next' : 'Siguiente'}</span>
      )}
    </nav>
  )}
</section>
