---
import type { BlockMediaKit, RecursoPrensa } from '@/lib/directus';
import { directus, readItems, getAssetUrl } from '@/lib/directus';
import { useTranslations } from '@/lib/i18n';

interface Props {
  block: BlockMediaKit;
  lang?: 'es' | 'en';
}

const { block, lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const prefix = isEn ? '/en' : '';
const t = useTranslations(lang);

// Fetch recent media kits from directus
let recursos: RecursoPrensa[] = [];
try {
  const res = await directus.request(
    readItems('recursos_prensa' as any, {
      filter: { status: { _eq: 'published' } },
      sort: ['-id'],
      limit: 3,
      fields: ['id', 'titulo', 'categoria_recurso', 'descripcion', 'archivo.*', 'formato', 'peso', 'imagen_previa.*'],
    })
  );
  recursos = (res as any) || [];
} catch (e) {
  console.error('Error fetching media resources in BlockMediaKit:', e);
}

const directZipUrl = block.archivo_zip ? getAssetUrl(block.archivo_zip) : null;
---

<section class="w-full bg-paper border-b border-zinc-200 py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Header (Swiss Minimalist) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-zinc-200">
      <div class="space-y-2">
        <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 font-semibold">
          {isEn ? 'GRAPHIC & AUDIOVISUAL ASSETS' : 'RECURSOS GRÁFICOS Y AUDIOVISUALES'}
        </div>
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-zinc-950 tracking-tight">
          {block.titulo || t.mediaKit.title}
        </h2>
      </div>

      <a
        href={`${prefix}/recursos-prensa`}
        class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-wider text-zinc-800 hover:text-vermilion transition-colors group"
      >
        <span>{isEn ? 'View all media kits' : 'Ver todos los paquetes'}</span>
        <span class="transform group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
    </div>

    <!-- Featured Kit Banner if defined -->
    {directZipUrl && (
      <div class="border border-zinc-200 p-6 sm:p-8 bg-canvas grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-8 space-y-4">
          <div class="flex items-center gap-3 font-mono text-xs text-zinc-500 uppercase tracking-wider">
            <span class="font-bold text-zinc-950">{isEn ? 'OFFICIAL MEDIA KIT' : 'MEDIA KIT OFICIAL'}</span>
            <span class="text-zinc-300">/</span>
            <span>{block.tamanio_formato || '300 DPI · ZIP'}</span>
          </div>

          <h3 class="font-display text-xl sm:text-2xl font-bold text-zinc-950">
            {block.titulo}
          </h3>

          {block.especificaciones && (
            <p class="font-sans text-sm text-zinc-600 leading-relaxed max-w-2xl">
              {block.especificaciones}
            </p>
          )}

          <div class="pt-2">
            <a
              href={directZipUrl}
              download
              class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider font-bold text-zinc-950 hover:text-vermilion border-b border-zinc-950 hover:border-vermilion pb-1 transition-colors"
            >
              <span>{isEn ? 'DOWNLOAD COMPLETE ZIP' : 'DESCARGAR ZIP COMPLETO'}</span>
              <span>↓</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-4 border border-zinc-200 p-4 bg-paper font-mono text-xs text-zinc-600 space-y-2">
          <div class="text-zinc-950 font-bold uppercase">{isEn ? 'TECHNICAL SPECS' : 'ESPECIFICACIONES'}</div>
          <div class="text-[11px] text-zinc-500">FORMATO: ZIP (RGB + CMYK)</div>
          <div class="text-[11px] text-zinc-500">RESOLUCIÓN: 300 DPI ALTA DEFINICIÓN</div>
          <div class="text-[11px] text-zinc-500">LICENCIA: LIBRE USO EDITORIAL</div>
        </div>
      </div>
    )}

    <!-- Secondary Media Assets Grid -->
    {recursos.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4">
        {recursos.map((item) => {
          const fileUrl = item.archivo ? getAssetUrl(item.archivo) : '#';

          return (
            <div class="border border-zinc-200 bg-paper p-6 space-y-4 hover:border-zinc-400 transition-colors flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between font-mono text-[11px] text-zinc-500 uppercase tracking-wider">
                  <span class="text-zinc-950 font-semibold">{item.categoria_recurso || 'Recurso'}</span>
                  <span>{item.peso || '300 DPI'}</span>
                </div>

                <h4 class="font-display text-base font-bold text-zinc-950">
                  {item.titulo}
                </h4>

                {item.descripcion && (
                  <p class="font-sans text-xs text-zinc-600 line-clamp-3 leading-relaxed">
                    {item.descripcion}
                  </p>
                )}
              </div>

              <div class="pt-4 border-t border-zinc-100">
                <a
                  href={fileUrl}
                  download
                  class="inline-flex items-center justify-between w-full font-mono text-xs uppercase tracking-wider font-semibold text-zinc-900 hover:text-vermilion transition-colors"
                >
                  <span>{isEn ? 'DOWNLOAD ASSET' : 'DESCARGAR RECURSO'}</span>
                  <span>↓</span>
                </a>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>
</section>
