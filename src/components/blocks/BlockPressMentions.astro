---
import {
  COBERTURA_TOTAL,
  coberturaAgrupada,
  coberturaReciente,
  formatCoberturaFecha,
  type CoberturaItem,
} from '@/data/cobertura';

interface Props {
  lang?: 'es' | 'en';
  /**
   * Portada: solo las N menciones más recientes.
   * Sin límite, la página de cobertura lista las 37 agrupadas por mes.
   */
  limit?: number;
}

const { lang = 'es', limit } = Astro.props;
const isEn = lang === 'en';
const isPreview = typeof limit === 'number';
const mentions: CoberturaItem[] = isPreview ? coberturaReciente(limit) : [];
const groups = isPreview ? [] : coberturaAgrupada(lang);
const archiveHref = isEn ? '/en/coverage' : '/cobertura';
const noteLabel = isEn ? 'View note' : 'Ver nota';
---

{isPreview ? (
  <section class="w-full bg-paper border-b border-zinc-200 py-12 md:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 pb-6 border-b border-zinc-200">
        <div class="space-y-1">
          <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 font-bold">
            {isEn ? 'MEDIA CLIPPING & PRESS COVERAGE' : 'COBERTURA EN MEDIOS & CLIPPING DE PRENSA'}
          </div>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-zinc-950 tracking-tight">
            {isEn ? 'Noche Madrid in the media' : 'Noche Madrid en los medios'}
          </h2>
        </div>

        <a
          href={archiveHref}
          class="font-mono text-xs uppercase tracking-wider text-zinc-950 hover:text-vermilion font-bold inline-flex items-center gap-1"
        >
          <span>{isEn ? 'All coverage' : 'Ver toda la cobertura'}</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {mentions.map((m) => (
          <article class="group border border-zinc-200 bg-paper hover:border-zinc-950 transition-all p-5 flex flex-col justify-between gap-4">
            <div class="space-y-3">
              <div class="flex items-center justify-between gap-3 font-mono text-[10px] uppercase tracking-wider text-zinc-500">
                <span class="font-bold text-zinc-950 px-2 py-0.5 bg-canvas border border-zinc-200">{m.medio}</span>
                <time datetime={m.fecha}>{formatCoberturaFecha(m.fecha, lang)}</time>
              </div>
              <h3 class="font-display text-base font-bold text-zinc-950 group-hover:text-vermilion transition-colors leading-snug">
                <a href={m.url} target="_blank" rel="noopener noreferrer">
                  {m.titular}
                </a>
              </h3>
            </div>
            {m.origen && (
              <div class="pt-3 border-t border-zinc-100">
                <a
                  href={m.origen}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-xs font-bold text-zinc-950 group-hover:text-vermilion inline-flex items-center gap-1"
                >
                  <span>{noteLabel}</span>
                  <span>↗</span>
                </a>
              </div>
            )}
          </article>
        ))}
      </div>
    </div>
  </section>
) : (
  <div class="space-y-10">
    <p class="font-mono text-[11px] uppercase tracking-wider text-zinc-500">
      {isEn
        ? `${COBERTURA_TOTAL} pieces from 2026, newest first`
        : `${COBERTURA_TOTAL} piezas de 2026, de la más reciente a la más antigua`}
    </p>

    {groups.map((group) => (
      <section class="space-y-3">
        <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-zinc-400">
          {group.label}
          <span class="text-zinc-300"> · {group.items.length}</span>
        </h2>
        <ul class="divide-y divide-zinc-200 border-y border-zinc-200">
          {group.items.map((m) => (
            <li class="py-4 grid grid-cols-1 md:grid-cols-12 gap-2 md:gap-4 md:items-baseline">
              <div class="md:col-span-3 flex items-baseline justify-between gap-3 md:block">
                <span class="font-mono text-[11px] font-bold uppercase tracking-wider text-zinc-950">{m.medio}</span>
                <time datetime={m.fecha} class="font-mono text-[11px] uppercase tracking-wider text-zinc-500 md:mt-1 md:block">
                  {formatCoberturaFecha(m.fecha, lang)}
                </time>
              </div>
              <a
                href={m.url}
                target="_blank"
                rel="noopener noreferrer"
                class="md:col-span-7 font-display text-base font-semibold text-zinc-950 hover:text-vermilion leading-snug"
              >
                {m.titular}
              </a>
              {m.origen && (
                <a
                  href={m.origen}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="md:col-span-2 md:text-right font-mono text-[11px] font-bold uppercase tracking-wider text-zinc-950 hover:text-vermilion"
                >
                  {noteLabel}
                </a>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
)}
