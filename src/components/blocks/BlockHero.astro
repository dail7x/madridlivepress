---
import type { BlockHero, Comunicado, Categoria } from '@/lib/directus';
import { directus, readItems, getAssetUrl } from '@/lib/directus';

interface Props {
  block: BlockHero;
  lang?: 'es' | 'en';
}

const { block, lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const prefix = isEn ? '/en' : '';
const newsBase = isEn ? '/en/news' : '/comunicados';

// Pull latest stories directly with real images and translations
let latestStories: Comunicado[] = [];
try {
  const res = await directus.request(
    readItems('comunicados' as any, {
      filter: { status: { _eq: 'published' } },
      sort: ['-fecha_publicacion', '-id'],
      limit: 3,
      fields: [
        'id',
        'titulo',
        'titulo_en',
        'slug',
        'slug_en',
        'fecha_publicacion',
        'imagen_url_externa',
        'imagen_portada.*',
        { categoria: ['id', 'nombre', 'nombre_en', 'slug', 'slug_en'] }
      ],
    })
  );
  latestStories = (res as any) || [];
} catch (e) {
  console.error('Error in BlockHero:', e);
}

const DEFAULT_THUMBS = [
  '/images/news/dos-millones-turistas.jpg',
  '/images/news/tardeo-madrid.jpg',
  '/images/news/bad-bunny-residencia.jpg',
];

const heroImage = block.fondo
  ? getAssetUrl(block.fondo, { quality: 90, format: 'webp' })
  : '/images/news/enlacolasilencio.jpg';
---

<section class="w-full bg-paper border-b border-zinc-200">
  <!-- Top Wireframe Header "MADRID LIVE PRESS" (Clean Baseline Cut) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6">
    <div class="w-full h-12 sm:h-16 lg:h-20 overflow-hidden flex items-end select-none pointer-events-none">
      <span class="font-display font-black text-4xl sm:text-6xl lg:text-7xl xl:text-[5.75rem] tracking-tight leading-none text-wireframe block translate-y-1 sm:translate-y-3 whitespace-nowrap">
        MADRID LIVE PRESS
      </span>
    </div>

    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pt-2 pb-3 border-b border-zinc-200">
      <div class="flex items-center gap-2 font-mono text-[11px] sm:text-xs text-zinc-600 uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-vermilion inline-block animate-pulse"></span>
        <span class="font-bold text-zinc-950">{isEn ? 'LIVE PRESSROOM' : 'SALA DE PRENSA EN DIRECTO'}</span>
        <span class="text-zinc-300">·</span>
        <span>NOCHEMADRID</span>
      </div>

      <div class="font-mono text-[11px] sm:text-xs text-zinc-500 uppercase tracking-wider">
        {isEn ? 'UPDATED 12:38 CET' : 'ACTUALIZADO 12:38 CET'}
      </div>
    </div>
  </div>

  <!-- First Viewport Desktop Grid: Left Hero (60%) + Right 3 Latest News (40%) -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Left Column: Featured Editorial Story -->
      <div class="lg:col-span-7 border border-zinc-200 bg-paper hover:border-zinc-950 transition-all p-0 flex flex-col justify-between">
        <!-- Panoramic Compact Visual -->
        <div class="relative aspect-[21/9] sm:aspect-[16/8] max-h-56 lg:max-h-64 w-full overflow-hidden bg-zinc-100 border-b border-zinc-200">
          <img
            src={heroImage}
            alt={block.titular || 'Madrid Live Press'}
            class="h-full w-full object-cover filter contrast-105"
            loading="eager"
          />
          <div class="absolute top-3 left-3 bg-paper/95 border border-zinc-200 px-2 py-0.5 font-mono text-[10px] font-bold text-zinc-950 uppercase tracking-wider">
            {isEn ? 'PORTAL / 001' : 'PORTADA / 001'}
          </div>
        </div>

        <div class="p-5 sm:p-6 space-y-3">
          <h1 class="font-display text-xl sm:text-2xl lg:text-3xl font-bold text-zinc-950 leading-tight">
            {block.titular || (isEn ? 'Madrid Nightlife & Culture Virtual Pressroom' : 'Sala de Prensa Virtual de la Noche y la Cultura de Madrid')}
          </h1>

          <p class="font-sans text-xs sm:text-sm text-zinc-600 leading-relaxed line-clamp-2">
            {block.subtitulo || (isEn ? 'Official media channel, institutional press releases, and access to all associated cultural venues of NocheMadrid.' : 'Canal oficial de comunicación, comunicados institucionales y acceso a los espacios y salas de ocio asociados a NocheMadrid.')}
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2 border-t border-zinc-100 font-mono text-xs">
            <a
              href={newsBase}
              data-astro-prefetch="hover"
              class="bg-zinc-950 hover:bg-vermilion text-white font-bold px-4 py-2 uppercase tracking-wider transition-colors inline-flex items-center gap-1.5"
            >
              <span>{isEn ? 'Explore News' : 'Explorar Comunicados'}</span>
              <span>↗</span>
            </a>
            <a
              href={`${prefix}/press-kits`}
              data-astro-prefetch="hover"
              class="border border-zinc-950 hover:bg-zinc-100 text-zinc-950 font-bold px-4 py-2 uppercase tracking-wider transition-colors"
            >
              {isEn ? 'Press Kits ↓' : 'Press Kits Oficiales ↓'}
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: 3 Stacked Latest News (Visible in First Viewport!) -->
      <div class="lg:col-span-5 space-y-3">
        <div class="flex items-center justify-between pb-1 border-b border-zinc-200 font-mono text-xs">
          <div class="font-bold text-zinc-950 uppercase tracking-wider flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-vermilion inline-block"></span>
            <span>{isEn ? 'LATEST PRESS RELEASES' : 'ÚLTIMOS COMUNICADOS'}</span>
          </div>
          <a href={newsBase} data-astro-prefetch="hover" class="text-zinc-500 hover:text-vermilion text-[11px] font-semibold">
            {isEn ? 'VIEW ALL →' : 'VER TODOS →'}
          </a>
        </div>

        <div class="space-y-3">
          {latestStories.map((story, idx) => {
            const cat = story.categoria as Categoria | undefined;
            const imgUrl = (story as any).imagen_url_externa || (story.imagen_portada ? getAssetUrl(story.imagen_portada, { width: 350, height: 250, format: 'webp' }) : DEFAULT_THUMBS[idx]);
            const dateStr = new Date(story.fecha_publicacion).toLocaleDateString(isEn ? 'en-US' : 'es-ES', { day: '2-digit', month: 'short', year: 'numeric' }).toUpperCase();
            const storyTitle = (isEn ? story.titulo_en : story.titulo) || story.titulo;
            const storySlug = (isEn ? (story.slug_en || story.slug) : story.slug);
            const catName = (isEn ? cat?.nombre_en : cat?.nombre) || cat?.nombre || (isEn ? 'OFFICIAL' : 'OFICIAL');

            return (
              <a
                href={`${newsBase}/${storySlug}`}
                data-astro-prefetch="hover"
                class="group block border border-zinc-200 bg-paper p-3 hover:border-zinc-950 transition-all active:scale-[0.99]"
              >
                <div class="grid grid-cols-12 gap-3 items-center">
                  <div class="col-span-4 aspect-[4/3] overflow-hidden bg-zinc-100 border border-zinc-200">
                    <img
                      src={imgUrl}
                      alt={storyTitle}
                      class="h-full w-full object-cover filter contrast-105 group-hover:scale-105 transition-transform duration-300"
                    />
                  </div>

                  <div class="col-span-8 flex flex-col justify-between h-full space-y-1">
                    <div class="font-mono text-[9px] uppercase tracking-wider text-zinc-500 flex items-center justify-between">
                      <span class="font-semibold text-zinc-900">{catName.toUpperCase()}</span>
                      <span>{dateStr}</span>
                    </div>

                    <h3 class="font-display text-xs sm:text-sm font-bold text-zinc-950 leading-snug group-hover:text-vermilion transition-colors line-clamp-2">
                      {storyTitle}
                    </h3>

                    <div class="flex justify-end">
                      <span class="text-zinc-900 text-xs font-bold group-hover:translate-x-1 transition-transform">→</span>
                    </div>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>
