---
import type { BlockHero, Comunicado } from '@/lib/directus';
import { getAssetUrl } from '@/lib/directus';
import { useTranslations } from '@/lib/i18n';
import { ArrowRight, Newspaper, Flame, DownloadCloud } from 'lucide-astro';

interface Props {
  block: BlockHero;
  lang?: 'es' | 'en';
}

const { block, lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const nota = block.nota_prioritaria as Comunicado | undefined;
const fondoUrl = block.fondo ? getAssetUrl(block.fondo, { quality: 85, format: 'webp' }) : '';
const ctaLink = block.cta_enlace || (lang === 'en' ? '/en/comunicados' : '/comunicados');
---

<section class="relative w-full overflow-hidden rounded-3xl border border-white/10 bg-surface/80 p-8 sm:p-12 lg:p-16 shadow-2xl backdrop-blur-xl">
  {/* Ambient Background Glows */}
  <div class="pointer-events-none absolute -top-24 -left-24 h-96 w-96 rounded-full bg-brand-primary/20 blur-3xl"></div>
  <div class="pointer-events-none absolute -bottom-24 -right-24 h-96 w-96 rounded-full bg-brand-electric/15 blur-3xl"></div>

  {/* Background Media if available */}
  {fondoUrl && (
    <div class="absolute inset-0 -z-10 overflow-hidden opacity-25">
      {block.tipo_fondo === 'video' ? (
        <video autoplay loop muted playsinline class="h-full w-full object-cover">
          <source src={fondoUrl} type="video/mp4" />
        </video>
      ) : (
        <img src={fondoUrl} alt={block.titular} class="h-full w-full object-cover" />
      )}
      <div class="absolute inset-0 bg-gradient-to-t from-background via-surface/90 to-surface/40"></div>
    </div>
  )}

  <div class="relative z-10 max-w-4xl space-y-8">
    {/* Official Badge */}
    <div class="inline-flex items-center gap-2 rounded-full border border-brand-primary/40 bg-brand-primary/10 px-4 py-1.5 backdrop-blur-md">
      <span class="relative flex h-2.5 w-2.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-brand-primary opacity-75"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-brand-primary"></span>
      </span>
      <span class="font-mono text-xs font-medium uppercase tracking-widest text-rose-300">
        {t.hero.badge} • NocheMadrid
      </span>
    </div>

    {/* Main Headline */}
    <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white leading-[1.1] text-balance">
      {block.titular}
    </h1>

    {/* Subtitle */}
    {block.subtitulo && (
      <p class="font-sans text-lg sm:text-xl text-zinc-300 max-w-2xl leading-relaxed">
        {block.subtitulo}
      </p>
    )}

    {/* CTAs */}
    <div class="flex flex-wrap items-center gap-4 pt-2">
      <a
        href={ctaLink}
        class="inline-flex items-center gap-2 rounded-xl bg-brand-primary px-6 py-3.5 font-sans font-semibold text-white transition-all duration-300 hover:bg-brand-primary-hover hover:scale-[1.02] shadow-lg shadow-rose-600/30"
      >
        <span>{block.cta_texto || t.hero.viewAll}</span>
        <ArrowRight class="h-4 w-4" />
      </a>

      <a
        href={lang === 'en' ? '/en/recursos-prensa' : '/recursos-prensa'}
        class="inline-flex items-center gap-2 rounded-xl border border-white/15 bg-white/5 px-6 py-3.5 font-sans font-medium text-zinc-200 backdrop-blur-md transition-all duration-300 hover:bg-white/10 hover:border-white/25"
      >
        <DownloadCloud class="h-4 w-4 text-amber-400" />
        <span>{t.nav.mediaKit}</span>
      </a>
    </div>

    {/* Priority Press Release Card */}
    {nota && (
      <div class="mt-8 pt-6 border-t border-white/10">
        <a
          href={`${lang === 'en' ? '/en/comunicados/' : '/comunicados/'}${nota.slug}`}
          class="group block rounded-2xl border border-amber-500/20 bg-amber-500/5 p-4 sm:p-5 transition-all duration-300 hover:border-amber-500/40 hover:bg-amber-500/10"
        >
          <div class="flex items-start sm:items-center justify-between gap-4">
            <div class="space-y-1.5">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1 rounded-md bg-amber-500/20 px-2 py-0.5 font-mono text-xs font-semibold text-amber-300">
                  <Flame class="h-3.5 w-3.5" />
                  {t.hero.liveNotice}
                </span>
                {nota.fecha_publicacion && (
                  <span class="font-mono text-xs text-zinc-400">
                    {new Date(nota.fecha_publicacion).toLocaleDateString(lang === 'en' ? 'en-US' : 'es-ES', {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric',
                    })}
                  </span>
                )}
              </div>
              <h4 class="font-display text-base sm:text-lg font-bold text-white group-hover:text-amber-300 transition-colors">
                {nota.titulo}
              </h4>
            </div>
            <div class="flex-shrink-0 self-center rounded-xl bg-white/5 p-2 text-zinc-400 group-hover:bg-amber-500/20 group-hover:text-amber-300 transition-all">
              <ArrowRight class="h-5 w-5 transform group-hover:translate-x-1 transition-transform" />
            </div>
          </div>
        </a>
      </div>
    )}
  </div>
</section>
