---
import type { BlockVenuesMap, Sala } from '@/lib/directus';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import { useTranslations } from '@/lib/i18n';

interface Props {
  block: BlockVenuesMap;
  lang?: 'es' | 'en';
}

const { block, lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const prefix = isEn ? '/en' : '';
const t = useTranslations(lang);

let salas: Sala[] = [];
try {
  const res = await directus.request(
    readItems('salas' as any, {
      filter: { status: { _eq: 'published' } },
      sort: ['-destacado', 'nombre'],
      limit: 12,
      fields: [
        'id',
        'nombre',
        'slug',
        'tipo_espacio',
        'distrito',
        'direccion',
        'aforo',
        'descripcion',
        'imagen_portada.*',
        'contacto_prensa_email',
        'contacto_prensa_nombre',
        'dossier_pdf.*',
        'sitio_web',
        'destacado',
      ],
    })
  );
  salas = (res as any) || [];
} catch (e) {
  console.error('Error fetching venues in BlockVenuesMap:', e);
}

const districts = [
  { label: isEn ? 'All Districts' : 'Todos los distritos', value: 'all' },
  { label: 'Centro / Gran Vía', value: 'centro' },
  { label: 'Chamberí', value: 'chamberi' },
  { label: 'Salamanca', value: 'salamanca' },
  { label: 'Malasaña / Chueca', value: 'malasana' },
  { label: 'Chamartín / Tetuán', value: 'chamartin' },
  { label: 'Retiro / Arganzuela', value: 'retiro' },
];

const DEFAULT_VENUE_PHOTOS = [
  'https://images.unsplash.com/photo-1514306191717-452ec28c7814?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1574391884720-bbc3740c59d1?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1507676184212-d03ab07a01bf?q=80&w=800&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?q=80&w=800&auto=format&fit=crop',
];
---

<section class="w-full bg-paper border-b border-zinc-200 py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-zinc-200">
      <div class="space-y-2">
        <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 font-semibold">
          {isEn ? 'NOCHEMADRID DIRECTORY · 96 ASSOCIATES' : 'DIRECTORIO NOCHEMADRID · 96 ASOCIADOS'}
        </div>
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-zinc-950 tracking-tight">
          {block.titulo || (isEn ? '96 Associated Cultural Venues & Clubs' : '96 Espacios Escénicos y Salas Asociadas')}
        </h2>
      </div>

      <a
        href={`${prefix}/directorio`}
        data-astro-prefetch="hover"
        class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-wider text-zinc-800 hover:text-vermilion transition-colors group"
      >
        <span>{isEn ? 'Full directory' : 'Directorio completo'}</span>
        <span class="transform group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
    </div>

    <!-- Search & Filter Bar -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
      <div class="md:col-span-6 relative">
        <input
          type="text"
          id="homeVenuesSearchInput"
          placeholder={isEn ? 'Search venue by name, district or type...' : 'Buscar sala por nombre, distrito o tipología...'}
          class="w-full border border-zinc-200 bg-paper px-4 py-2.5 font-mono text-xs text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-900 focus:outline-none transition-colors"
        />
      </div>

      <div class="md:col-span-6 flex flex-wrap gap-1.5 justify-start md:justify-end">
        {districts.map((d, index) => (
          <button
            type="button"
            data-district={d.value}
            class={`homeDistrictFilterBtn font-mono text-[11px] uppercase tracking-wider px-2.5 py-1 border transition-colors ${
              index === 0
                ? 'bg-zinc-900 text-white border-zinc-900'
                : 'border-zinc-200 text-zinc-600 hover:text-zinc-950 hover:border-zinc-900'
            }`}
          >
            {d.label}
          </button>
        ))}
      </div>
    </div>

    <!-- Venues Grid -->
    <div id="homeVenuesGridContainer" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 pt-4">
      {salas.map((sala, idx) => {
        const cover = sala.imagen_portada
          ? getAssetUrl(sala.imagen_portada, { width: 600, height: 400, format: 'webp' })
          : DEFAULT_VENUE_PHOTOS[idx % DEFAULT_VENUE_PHOTOS.length];
        const monogram = sala.nombre.split(' ').map((n) => n[0]).slice(0, 2).join('').toUpperCase();

        return (
          <article
            class="homeVenueCard border border-zinc-200 bg-paper hover:border-zinc-950 transition-colors flex flex-col justify-between"
            data-name={sala.nombre.toLowerCase()}
            data-district={(sala.distrito || '').toLowerCase()}
            data-type={(sala.tipo_espacio || '').toLowerCase()}
          >
            <div>
              <div class="relative aspect-[16/10] w-full border-b border-zinc-200 overflow-hidden bg-zinc-100">
                <img
                  src={cover}
                  alt={sala.nombre}
                  class="h-full w-full object-cover filter contrast-105"
                  loading="lazy"
                />
                <div class="absolute top-3 left-3 bg-paper/95 backdrop-blur-sm border border-zinc-200 px-2.5 py-1 flex items-center gap-1.5 shadow-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-vermilion inline-block"></span>
                  <span class="font-mono text-[10px] font-bold text-zinc-950 uppercase tracking-wider">{monogram}</span>
                </div>
              </div>

              <div class="p-6 space-y-4">
                <div class="flex items-center justify-between font-mono text-[11px] text-zinc-500 uppercase tracking-widest">
                  <span class="text-zinc-900 font-semibold">{sala.tipo_espacio || 'Espacio'}</span>
                  <span>{sala.distrito || 'Madrid'}</span>
                </div>

                <h3 class="font-display text-xl font-bold text-zinc-950">
                  <a href={`${prefix}/directorio/${sala.slug}`} data-astro-prefetch="hover" class="hover:text-vermilion transition-colors">
                    {sala.nombre}
                  </a>
                </h3>

                <div class="space-y-1 font-mono text-xs text-zinc-600">
                  {sala.aforo && <div>AFORO HOMOLOGADO: {sala.aforo.toLocaleString()} PAX</div>}
                  {sala.direccion && <div class="text-zinc-500 line-clamp-1">{sala.direccion}</div>}
                </div>
              </div>
            </div>

            <div class="p-6 pt-0 border-t border-zinc-100 flex items-center justify-between font-mono text-xs">
              <a
                href={`${prefix}/directorio/${sala.slug}`}
                data-astro-prefetch="hover"
                class="uppercase tracking-wider font-semibold text-zinc-950 hover:text-vermilion transition-colors"
              >
                {isEn ? 'TECHNICAL SHEET' : 'FICHA TÉCNICA'} ↗
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>

  <script is:inline>
    function setupHomeVenues() {
      function normalize(str) {
        return (str || '')
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .trim();
      }

      const searchInput = document.getElementById('homeVenuesSearchInput');
      const filterBtns = document.querySelectorAll('.homeDistrictFilterBtn');
      const cards = document.querySelectorAll('.homeVenueCard');

      let currentDistrict = 'all';

      function filter() {
        const query = normalize(searchInput ? searchInput.value : '');
        const normDist = normalize(currentDistrict);

        cards.forEach((card) => {
          const name = normalize(card.getAttribute('data-name'));
          const district = normalize(card.getAttribute('data-district'));
          const type = card.getAttribute('data-type') || '';

          const matchesQuery = !query || name.includes(query) || district.includes(query) || type.includes(query);
          let matchesDistrict = true;
          if (normDist !== 'all') {
            matchesDistrict = district.includes(normDist);
          }

          if (matchesQuery && matchesDistrict) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      }

      searchInput?.addEventListener('input', filter);

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          filterBtns.forEach((b) => {
            b.classList.remove('bg-zinc-900', 'text-white', 'border-zinc-900');
            b.classList.add('text-zinc-600', 'border-zinc-200');
          });

          btn.classList.add('bg-zinc-900', 'text-white', 'border-zinc-900');
          btn.classList.remove('text-zinc-600', 'border-zinc-200');

          currentDistrict = btn.getAttribute('data-district') || 'all';
          filter();
        });
      });
    }

    document.addEventListener('astro:page-load', setupHomeVenues);
    setupHomeVenues();
  </script>
</section>
