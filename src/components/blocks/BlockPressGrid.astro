---
import type { BlockPressGrid, Comunicado, Categoria } from '@/lib/directus';
import { directus, readItems, getAssetUrl } from '@/lib/directus';

interface Props {
  block: BlockPressGrid;
  lang?: 'es' | 'en';
}

const { block, lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const prefix = isEn ? '/en' : '';
const newsBase = isEn ? '/en/news' : '/comunicados';
const limit = block.limite || 6;

let comunicados: Comunicado[] = [];
let categorias: Categoria[] = [];

try {
  const filter: Record<string, any> = { status: { _eq: 'published' } };
  if (block.categoria_filtrada) {
    filter.categoria = { _eq: block.categoria_filtrada };
  }

  const [comunicadosRes, categoriasRes] = await Promise.all([
    directus.request(
      readItems('comunicados' as any, {
        filter,
        sort: ['-fecha_publicacion', '-id'],
        limit,
        fields: [
          'id',
          'status',
          'fecha_publicacion',
          'slug',
          'slug_en',
          'titulo',
          'titulo_en',
          'bajada',
          'bajada_en',
          'imagen_url_externa',
          'imagen_portada.*',
          'archivo_pdf.*',
          'tags',
          { categoria: ['id', 'nombre', 'nombre_en', 'slug', 'slug_en', 'color'] },
          { portavoz: ['id', 'nombre', 'cargo'] },
        ],
      })
    ),
    directus.request(
      readItems('categorias' as any, {
        fields: ['id', 'nombre', 'nombre_en', 'slug', 'slug_en', 'color'],
        sort: ['nombre'],
      })
    ),
  ]);

  comunicados = (comunicadosRes as Comunicado[]) || [];
  categorias = (categoriasRes as Categoria[]) || [];
} catch (e) {
  console.error('Error loading press releases in BlockPressGrid:', e);
}
---

<section class="w-full bg-paper border-b border-zinc-200 py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header (Swiss Minimalist) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-zinc-200">
      <div class="space-y-2">
        <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 font-semibold">
          {isEn ? 'OFFICIAL NEWS ARCHIVE' : 'ARCHIVO DE NOTICIAS OFICIALES'}
        </div>
        <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-zinc-950 tracking-tight">
          {block.titulo || (isEn ? 'Latest Official Press Releases' : 'Últimos Comunicados Oficiales')}
        </h2>
      </div>

      <a
        href={newsBase}
        class="inline-flex items-center gap-1 font-mono text-xs uppercase tracking-wider text-zinc-800 hover:text-vermilion transition-colors group"
      >
        <span>{isEn ? 'View all news' : 'Ver todas las notas'}</span>
        <span class="transform group-hover:translate-x-0.5 transition-transform">→</span>
      </a>
    </div>

    <!-- Category Filter Chips -->
    {categorias.length > 0 && (
      <div class="flex flex-wrap gap-2 pt-6 pb-2">
        <a
          href={newsBase}
          class="font-mono text-xs uppercase px-3 py-1.5 border border-zinc-900 bg-zinc-900 text-white tracking-wider"
        >
          {isEn ? 'All' : 'Todas'}
        </a>
        {categorias.map((c) => (
          <a
            href={`${newsBase}?cat=${isEn ? (c.slug_en || c.slug) : c.slug}`}
            class="font-mono text-xs uppercase px-3 py-1.5 border border-zinc-200 hover:border-zinc-900 text-zinc-700 hover:text-zinc-950 tracking-wider transition-colors"
          >
            {isEn ? (c.nombre_en || c.nombre) : c.nombre}
          </a>
        ))}
      </div>
    )}

    <!-- Editorial Table / List of Press Releases -->
    <div class="mt-8 divide-y divide-zinc-200 border-t border-b border-zinc-200">
      {comunicados.length === 0 ? (
        <div class="py-12 text-center text-zinc-500 font-sans text-sm">
          {isEn ? 'No press releases available at this moment.' : 'No hay comunicados disponibles en este momento.'}
        </div>
      ) : (
        comunicados.map((item, index) => {
          const cat = item.categoria as Categoria | undefined;
          const storyTitle = (isEn ? item.titulo_en : item.titulo) || item.titulo;
          const storySlug = isEn ? (item.slug_en || item.slug) : item.slug;
          const storyBajada = (isEn ? item.bajada_en : item.bajada) || item.bajada;
          const catName = (isEn ? cat?.nombre_en : cat?.nombre) || cat?.nombre;
          const pdf = item.archivo_pdf ? getAssetUrl(item.archivo_pdf) : null;
          const pubDate = item.fecha_publicacion ? new Date(item.fecha_publicacion) : new Date();
          const dateFormatted = pubDate.toLocaleDateString(isEn ? 'en-US' : 'es-ES', {
            day: '2-digit',
            month: 'short',
            year: 'numeric',
          }).toUpperCase();

          const npCode = `NP-04${String(item.id || index + 1).padStart(2, '0')}`;

          return (
            <article class="py-6 sm:py-8 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-start group hover:bg-canvas transition-colors px-2">
              <!-- Left metadata col (~25%) -->
              <div class="md:col-span-3 font-mono text-xs text-zinc-500 space-y-1">
                <div class="text-zinc-900 font-bold tracking-wider">{dateFormatted}</div>
                <div class="text-zinc-400">{npCode}</div>
                {cat && (
                  <div class="text-zinc-600 uppercase tracking-widest pt-1">
                    {catName}
                  </div>
                )}
              </div>

              <!-- Center title & excerpt col (~65%) -->
              <div class="md:col-span-7 space-y-2">
                <h3 class="font-display text-lg sm:text-xl font-semibold text-zinc-950 leading-snug group-hover:text-vermilion transition-colors">
                  <a href={`${newsBase}/${storySlug}`}>
                    {storyTitle}
                  </a>
                </h3>

                {storyBajada && (
                  <p class="font-sans text-sm text-zinc-600 line-clamp-2 leading-relaxed">
                    {storyBajada}
                  </p>
                )}
              </div>

              <!-- Right action col (~10%) -->
              <div class="md:col-span-2 flex md:justify-end items-center gap-3 pt-2 md:pt-0 font-sans text-xs">
                {pdf && (
                  <a
                    href={pdf}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-[11px] uppercase tracking-wider text-zinc-500 hover:text-vermilion transition-colors"
                    title={isEn ? 'Download PDF' : 'Descargar PDF'}
                  >
                    PDF ↓
                  </a>
                )}

                <a
                  href={`${newsBase}/${storySlug}`}
                  class="font-sans text-sm font-semibold text-zinc-900 group-hover:text-vermilion transition-colors"
                  aria-label={`Read ${storyTitle}`}
                >
                  ↗
                </a>
              </div>
            </article>
          );
        })
      )}
    </div>
  </div>
</section>
