---
import type { BlockPressGrid, Comunicado, Categoria } from '@/lib/directus';
import { directus, getAssetUrl } from '@/lib/directus';
import { readItems } from '@directus/sdk';
import { useTranslations } from '@/lib/i18n';
import { FileText, ArrowRight, Download, Calendar, Tag, ChevronRight } from 'lucide-astro';

interface Props {
  block: BlockPressGrid;
  lang?: 'es' | 'en';
}

const { block, lang = 'es' } = Astro.props;
const t = useTranslations(lang);

// Fetch press releases dynamically for the grid
let comunicados: Comunicado[] = [];
let categorias: Categoria[] = [];

try {
  const limit = block.limite || 6;
  const filter: any = {
    status: { _eq: 'published' }
  };

  if (block.categoria_destacada) {
    const catId = typeof block.categoria_destacada === 'string' ? block.categoria_destacada : block.categoria_destacada.id;
    if (catId) filter.categoria = { _eq: catId };
  }

  const [comunicadosRes, categoriasRes] = await Promise.all([
    directus.request(
      readItems('comunicados' as any, {
        filter,
        sort: ['-fecha_publicacion', '-id'],
        limit,
        fields: [
          'id',
          'status',
          'fecha_publicacion',
          'slug',
          'titulo',
          'bajada',
          'imagen_portada.*',
          'archivo_pdf.*',
          'tags',
          { categoria: ['id', 'nombre', 'slug', 'color'] },
          { portavoz: ['id', 'nombre', 'cargo'] },
        ],
      })
    ),
    directus.request(
      readItems('categorias' as any, {
        limit: 10,
        fields: ['id', 'nombre', 'slug', 'color'],
      })
    ),
  ]);

  comunicados = (comunicadosRes as any) || [];
  categorias = (categoriasRes as any) || [];
} catch (e) {
  console.error('Error loading press releases in BlockPressGrid:', e);
}
---

<section class="space-y-8">
  {/* Header Section */}
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-4 border-b border-white/10">
    <div class="space-y-2 max-w-2xl">
      <div class="inline-flex items-center gap-2 text-brand-primary font-mono text-xs uppercase tracking-widest font-semibold">
        <FileText class="h-4 w-4" />
        <span>Nube de Noticias Oficiales</span>
      </div>
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-white tracking-tight">
        {block.titular || t.press.title}
      </h2>
    </div>

    <a
      href={lang === 'en' ? '/en/comunicados' : '/comunicados'}
      class="inline-flex items-center gap-2 font-mono text-sm text-zinc-400 hover:text-white transition-colors group"
    >
      <span>{t.hero.viewAll}</span>
      <ArrowRight class="h-4 w-4 transform group-hover:translate-x-1 transition-transform" />
    </a>
  </div>

  {/* Category Filter Chips if enabled */}
  {block.mostrar_filtro_categorias && categorias.length > 0 && (
    <div class="flex flex-wrap items-center gap-2 pt-1 pb-2 overflow-x-auto">
      <a
        href={lang === 'en' ? '/en/comunicados' : '/comunicados'}
        class="rounded-full bg-white/10 px-4 py-1.5 font-mono text-xs font-medium text-white border border-white/15 hover:bg-white/20 transition-colors"
      >
        {t.press.filterAll}
      </a>
      {categorias.map((cat) => (
        <a
          href={`${lang === 'en' ? '/en/comunicados?cat=' : '/comunicados?cat='}${cat.slug}`}
          class="rounded-full bg-surface/80 px-4 py-1.5 font-mono text-xs text-zinc-300 border border-white/10 hover:border-white/25 hover:text-white transition-all backdrop-blur-sm"
        >
          {cat.nombre}
        </a>
      ))}
    </div>
  )}

  {/* Press Releases Grid */}
  {comunicados.length === 0 ? (
    <div class="rounded-2xl border border-white/10 bg-surface/50 p-12 text-center text-zinc-400 font-sans">
      No hay comunicados publicados en esta sección actualmente.
    </div>
  ) : (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {comunicados.map((item) => {
        const coverUrl = item.imagen_portada
          ? getAssetUrl(item.imagen_portada, { width: 800, height: 450, quality: 80, format: 'webp' })
          : null;
        const pdfUrl = item.archivo_pdf ? getAssetUrl(item.archivo_pdf) : null;
        const cat = item.categoria as Categoria | undefined;
        const detailUrl = `${lang === 'en' ? '/en/comunicados/' : '/comunicados/'}${item.slug}`;

        return (
          <article class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-white/10 bg-surface/80 transition-all duration-300 hover:border-white/20 hover:shadow-2xl hover:shadow-rose-950/20 backdrop-blur-md">
            <div>
              {/* Cover Image */}
              <a href={detailUrl} class="relative block aspect-[16/9] w-full overflow-hidden bg-zinc-900">
                {coverUrl ? (
                  <img
                    src={coverUrl}
                    alt={item.titulo}
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-surface to-background p-6">
                    <span class="font-mono text-xs uppercase tracking-widest text-zinc-500">Madrid Live Press</span>
                  </div>
                )}
                <div class="absolute inset-0 bg-gradient-to-t from-surface via-transparent to-transparent opacity-60"></div>
                
                {cat && (
                  <span class="absolute top-3 left-3 rounded-md bg-black/70 px-2.5 py-1 font-mono text-[11px] font-semibold text-rose-300 border border-white/10 backdrop-blur-md">
                    {cat.nombre}
                  </span>
                )}
              </a>

              {/* Content Details */}
              <div class="p-5 sm:p-6 space-y-3">
                <div class="flex items-center gap-2 font-mono text-xs text-zinc-400">
                  <Calendar class="h-3.5 w-3.5 text-zinc-500" />
                  <time datetime={item.fecha_publicacion}>
                    {new Date(item.fecha_publicacion || Date.now()).toLocaleDateString(
                      lang === 'en' ? 'en-US' : 'es-ES',
                      { day: 'numeric', month: 'short', year: 'numeric' }
                    )}
                  </time>
                  <span class="text-zinc-600">•</span>
                  <span>Madrid</span>
                </div>

                <h3 class="font-display text-lg sm:text-xl font-bold text-white leading-snug group-hover:text-rose-400 transition-colors line-clamp-2">
                  <a href={detailUrl}>{item.titulo}</a>
                </h3>

                {item.bajada && (
                  <p class="font-sans text-sm text-zinc-400 line-clamp-3 leading-relaxed">
                    {item.bajada}
                  </p>
                )}
              </div>
            </div>

            {/* Footer with Actions */}
            <div class="flex items-center justify-between border-t border-white/10 px-5 py-3.5 bg-black/20">
              <a
                href={detailUrl}
                class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-zinc-300 hover:text-white transition-colors"
              >
                <span>{t.press.readMore}</span>
                <ChevronRight class="h-3.5 w-3.5" />
              </a>

              {block.mostrar_descarga_pdf && pdfUrl && (
                <a
                  href={pdfUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  download
                  class="inline-flex items-center gap-1 rounded-md bg-white/5 px-2.5 py-1 font-mono text-xs font-medium text-amber-300 border border-amber-400/20 hover:bg-amber-400/10 transition-colors"
                  title={t.press.downloadPdf}
                >
                  <Download class="h-3 w-3" />
                  <span>PDF</span>
                </a>
              )}
            </div>
          </article>
        );
      })}
    </div>
  )}
</section>
