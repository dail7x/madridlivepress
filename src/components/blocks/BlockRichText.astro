---
import type { BlockRichText } from '@/lib/directus';
import { getAssetUrl } from '@/lib/directus';

interface Props {
  block: BlockRichText;
  lang?: 'es' | 'en';
}

const { block } = Astro.props;
const avatarUrl = block.cita_avatar ? getAssetUrl(block.cita_avatar, { width: 160, height: 160, format: 'webp' }) : null;
---

<section class="w-full bg-paper border-b border-zinc-200 py-12 md:py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    {block.titulo && (
      <div class="space-y-2 pb-4 border-b border-zinc-200">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-zinc-950 tracking-tight">
          {block.titulo}
        </h2>
      </div>
    )}

    {/* WYSIWYG HTML Content with Swiss Editorial Typography */}
    {block.contenido && (
      <div
        class="prose prose-zinc max-w-none font-sans text-base sm:text-[17px] leading-[1.8] text-zinc-800
        prose-headings:font-display prose-headings:font-bold prose-headings:text-zinc-950 prose-headings:tracking-tight
        prose-a:text-zinc-950 prose-a:underline hover:prose-a:text-vermilion
        prose-strong:text-zinc-950 prose-strong:font-bold"
        set:html={block.contenido}
      />
    )}

    {/* Formatted Spokesperson Pull-Quote (Exact Reference Style) */}
    {block.cita_texto && (
      <div class="border-t border-b border-zinc-200 py-8 my-8 grid grid-cols-1 md:grid-cols-12 gap-6 items-start bg-canvas p-6 sm:p-8">
        <div class="md:col-span-1">
          <span class="text-5xl font-serif text-vermilion leading-none block select-none">“</span>
        </div>

        <div class="md:col-span-11 space-y-4">
          <blockquote class="font-display text-xl sm:text-2xl font-medium text-zinc-950 leading-snug tracking-tight">
            {block.cita_texto}
          </blockquote>

          {(block.cita_autor || block.cita_cargo) && (
            <div class="pt-2 font-mono text-xs text-zinc-500 uppercase tracking-widest leading-relaxed border-t border-zinc-200">
              {block.cita_autor && (
                <div class="font-bold text-zinc-900">{block.cita_autor}</div>
              )}
              {block.cita_cargo && (
                <div class="text-zinc-600">{block.cita_cargo}</div>
              )}
            </div>
          )}
        </div>
      </div>
    )}
  </div>
</section>
