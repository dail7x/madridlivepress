---
import type { BlockNewsletter } from '@/lib/directus';
import { useTranslations } from '@/lib/i18n';

interface Props {
  block: BlockNewsletter;
  lang?: 'es' | 'en';
}

const { block, lang = 'es' } = Astro.props;
const isEn = lang === 'en';
const t = useTranslations(lang);
---

<section class="w-full bg-canvas border-b border-zinc-200 py-12 md:py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-6">
    <div class="space-y-2">
      <div class="font-mono text-xs uppercase tracking-widest text-zinc-400 font-semibold">
        {isEn ? 'JOURNALISTS DISTRIBUTION LIST' : 'LISTA DE DISTRIBUCIÓN PARA PERIODISTAS'}
      </div>
      <h2 class="font-display text-2xl sm:text-3xl font-bold text-zinc-950 tracking-tight">
        {block.titulo || t.newsletter.title}
      </h2>
      <p class="font-sans text-sm sm:text-base text-zinc-600 leading-relaxed max-w-2xl">
        {block.descripcion || t.newsletter.subtitle}
      </p>
    </div>

    <!-- Minimalist Subscription Form -->
    <form id="newsletterForm" class="space-y-4 pt-2">
      <div class="flex flex-col sm:flex-row gap-2">
        <input
          type="email"
          id="newsletterEmail"
          required
          placeholder={block.placeholder_input || (isEn ? 'editor@media.com' : 'redaccion@medio.com')}
          class="flex-1 border border-zinc-300 bg-paper px-4 py-3 font-mono text-xs text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-950 focus:outline-none transition-colors"
        />
        <button
          type="submit"
          id="newsletterBtn"
          class="bg-zinc-900 hover:bg-zinc-800 text-white px-6 py-3 font-mono text-xs uppercase tracking-wider font-semibold transition-colors flex-shrink-0"
        >
          <span id="btnText">{block.texto_boton || (isEn ? 'SUBSCRIBE TO ALERTS' : 'SUSCRIBIRSE A ALERTAS')}</span>
        </button>
      </div>

      <div class="font-mono text-[11px] text-zinc-500">
        {block.texto_privacidad || (isEn ? 'Official institutional notifications only. Zero commercial spam.' : 'Exclusivo para profesionales de medios. Cero spam comercial.')}
      </div>

      <div id="newsletterStatus" class="hidden font-mono text-xs p-3 border"></div>
    </form>
  </div>

  <script is:inline>
    const form = document.getElementById('newsletterForm');
    const emailInput = document.getElementById('newsletterEmail');
    const btn = document.getElementById('newsletterBtn');
    const statusDiv = document.getElementById('newsletterStatus');
    const btnText = document.getElementById('btnText');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput?.value?.trim();
      if (!email) return;

      btn.disabled = true;
      if (btnText) btnText.textContent = 'PROCESANDO...';

      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        const data = await res.json();
        statusDiv.classList.remove('hidden');

        if (res.ok) {
          statusDiv.className = 'font-mono text-xs p-3 border border-zinc-900 bg-zinc-900 text-white';
          statusDiv.textContent = '✓ Registrado con éxito en la lista oficial de medios.';
          form.reset();
        } else {
          statusDiv.className = 'font-mono text-xs p-3 border border-red-500 bg-red-50 text-red-700';
          statusDiv.textContent = data.message || 'Error al procesar la solicitud.';
        }
      } catch (err) {
        statusDiv.classList.remove('hidden');
        statusDiv.className = 'font-mono text-xs p-3 border border-red-500 bg-red-50 text-red-700';
        statusDiv.textContent = 'Error de conexión. Intente nuevamente.';
      } finally {
        btn.disabled = false;
        if (btnText) btnText.textContent = 'SUSCRIBIRSE A ALERTAS';
      }
    });
  </script>
</section>
