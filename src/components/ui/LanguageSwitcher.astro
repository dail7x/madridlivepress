---
import type { Locale } from '@/lib/i18n';

interface Props {
  currentLang?: Locale;
}

const { currentLang = 'es' } = Astro.props;
const currentPath = Astro.url.pathname;

// Strip any existing language prefix from path
function getCleanBasePath(path: string): string {
  const stripped = path.replace(/^\/(en|it|fr)(\/|$)/, '/');
  return stripped === '' ? '/' : stripped;
}

const basePath = getCleanBasePath(currentPath);

function getTargetUrl(targetLang: Locale): string {
  if (targetLang === 'es') {
    return basePath;
  }
  return basePath === '/' ? `/${targetLang}` : `/${targetLang}${basePath}`;
}

const languages: { code: Locale; label: string }[] = [
  { code: 'es', label: 'ES' },
  { code: 'en', label: 'EN' },
  { code: 'it', label: 'IT' },
  { code: 'fr', label: 'FR' },
];
---

<div class="inline-flex items-center rounded-xl border border-white/10 bg-surface/80 p-1 font-mono text-xs backdrop-blur-md">
  {languages.map((lang) => (
    <a
      href={getTargetUrl(lang.code)}
      class:list={[
        'rounded-lg px-2.5 py-1 font-medium transition-all',
        currentLang === lang.code ? 'bg-brand-primary text-white shadow-sm' : 'text-zinc-400 hover:text-white',
      ]}
    >
      {lang.label}
    </a>
  ))}
</div>
