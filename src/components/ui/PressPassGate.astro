---
interface Props {
  lang?: 'es' | 'en' | 'it' | 'fr';
  redirectUrl?: string;
}

const { lang = 'es', redirectUrl = '' } = Astro.props;

const isEs = lang === 'es';
const texts = {
  badgeMeta: isEs ? 'GABINETE DE PRENSA OFICIAL · NOCHEMADRID' : 'OFFICIAL PRESS DESK · NOCHEMADRID',
  badgeFree: isEs ? '100% GRATUITO PARA REDACCIONES' : '100% FREE FOR NEWSROOMS',
  title: isEs ? 'Pase de Prensa: Desbloquea el Comunicado Completo' : 'Press Pass: Unlock the Full Release',
  subtitle: isEs
    ? 'Noche Madrid Press es la fuente oficial del ocio nocturno y la música en vivo. La acreditación profesional es sin coste y te da acceso inmediato a recursos en alta resolución y notas bajo embargo.'
    : 'Noche Madrid Press is the official wire for live music and nightlife culture. Professional accreditation is free and grants immediate access to high-res media kits and embargoed news.',
  benefit1Title: isEs ? 'B-Roll 4K y RAW sin marcas' : '4K B-Roll & RAW Media Kits',
  benefit1Desc: isEs ? 'Vídeo para TV y fotografía de alta resolución libres de derechos editoriales.' : 'Broadcast-ready footage and photography free for editorial use.',
  benefit2Title: isEs ? 'Exclusivas y Embargos 24h' : '24h Pre-Release Embargoes',
  benefit2Desc: isEs ? 'Recibe estudios oficiales e informes de impacto antes del envío masivo.' : 'Receive industry surveys and official reports before general release.',
  benefit3Title: isEs ? 'Contacto Directo con Portavoces' : 'Direct Spokesperson Access',
  benefit3Desc: isEs ? 'Canal prioritario con NocheMadrid y los directores de las 96 salas.' : 'Priority line to federations, venue directors and spokespersons.',
  tabRegister: isEs ? 'NUEVA ACREDITACIÓN' : 'NEW ACCREDITATION',
  tabLogin: isEs ? '¿YA TIENES PASE? (INICIAR SESIÓN)' : 'ALREADY ACCREDITED? (SIGN IN)',
  nameLabel: isEs ? 'Nombre y Apellidos *' : 'Full Name *',
  namePlaceholder: isEs ? 'Ej. Carmen García' : 'e.g. John Doe',
  emailLabel: isEs ? 'Correo Corporativo de Redacción *' : 'Work / Newsroom Email *',
  emailPlaceholder: isEs ? 'nombre@elmedio.com' : 'name@outlet.com',
  mediaLabel: isEs ? 'Medio de Comunicación o Cabecera *' : 'Media Outlet / Publication *',
  mediaPlaceholder: isEs ? 'Ej. El País, Agencia EFE, BBC, Mixmag, Freelance...' : 'e.g. Reuters, BBC, Mixmag, Freelance...',
  typeLabel: isEs ? 'Tipo de Cobertura' : 'Media Type',
  consentText: isEs
    ? 'Deseo recibir comunicados oficiales, convocatorias a ruedas de prensa y dossiers en mi bandeja de entrada.'
    : 'I agree to receive official press releases, embargoed briefings, and conference invites.',
  submitRegister: isEs ? 'SOLICITAR PASE Y VERIFICAR EMAIL →' : 'REQUEST PASS & VERIFY EMAIL →',
  submitLogin: isEs ? 'ENVIAR CÓDIGO DE ACCESO (OTP) →' : 'SEND ACCESS CODE (OTP) →',
  otpTitle: isEs ? 'Verificación de Seguridad (6 Dígitos)' : 'Security Verification (6 Digits)',
  otpDesc: isEs
    ? 'Hemos enviado un código numérico a tu correo para confirmar tu acreditación. Introdúcelo aquí o pulsa en el Magic Link recibido:'
    : 'We sent a verification code to your email to confirm your press pass. Enter it below or click the Magic Link in your email:',
  verifyBtn: isEs ? 'VERIFICAR Y DESBLOQUEAR CONTENIDO →' : 'VERIFY & UNLOCK CONTENT →',
  resendBtn: isEs ? '¿No has recibido el código? Reenviar' : 'Didn’t receive it? Resend code',
  changeEmail: isEs ? 'Cambiar correo' : 'Change email',
};
---

<div class="relative w-full my-8 font-sans" id="mlp-press-gate-container">
  <!-- Smooth Blur / Gradient Cut -->
  <div class="h-32 -mt-32 w-full bg-gradient-to-t from-paper via-paper/95 to-transparent pointer-events-none"></div>

  <!-- Gate Card -->
  <div class="border-2 border-zinc-950 bg-paper shadow-float p-6 sm:p-10 relative overflow-hidden">
    <!-- Top Meta Strip -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-6 border-b border-zinc-200 font-mono text-[11px]">
      <div class="flex items-center gap-2 text-zinc-950 font-bold uppercase tracking-wider">
        <span class="w-2.5 h-2.5 rounded-full bg-vermilion animate-pulse"></span>
        <span>{texts.badgeMeta}</span>
      </div>
      <div class="bg-zinc-100 text-zinc-900 border border-zinc-300 font-bold px-2.5 py-1 uppercase tracking-widest text-[10px] w-fit">
        {texts.badgeFree}
      </div>
    </div>

    <!-- Main Value Proposition Section -->
    <div class="pt-6 pb-6 space-y-4">
      <h3 class="font-display text-2xl sm:text-3xl font-bold text-zinc-950 tracking-tight leading-tight">
        {texts.title}
      </h3>
      <p class="font-sans text-sm sm:text-base text-zinc-600 leading-relaxed max-w-2xl">
        {texts.subtitle}
      </p>

      <!-- Benefits Pills -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
        <div class="border border-zinc-200 bg-canvas p-4 space-y-1">
          <div class="font-mono text-xs font-bold text-zinc-950 flex items-center gap-1.5">
            <span class="text-vermilion font-bold">✓</span>
            <span>{texts.benefit1Title}</span>
          </div>
          <p class="font-sans text-xs text-zinc-600 leading-relaxed">{texts.benefit1Desc}</p>
        </div>
        <div class="border border-zinc-200 bg-canvas p-4 space-y-1">
          <div class="font-mono text-xs font-bold text-zinc-950 flex items-center gap-1.5">
            <span class="text-vermilion font-bold">✓</span>
            <span>{texts.benefit2Title}</span>
          </div>
          <p class="font-sans text-xs text-zinc-600 leading-relaxed">{texts.benefit2Desc}</p>
        </div>
        <div class="border border-zinc-200 bg-canvas p-4 space-y-1">
          <div class="font-mono text-xs font-bold text-zinc-950 flex items-center gap-1.5">
            <span class="text-vermilion font-bold">✓</span>
            <span>{texts.benefit3Title}</span>
          </div>
          <p class="font-sans text-xs text-zinc-600 leading-relaxed">{texts.benefit3Desc}</p>
        </div>
      </div>
    </div>

    <!-- VIEW 1: FORMS (Register & Login Tabs) -->
    <div id="mlp-gate-form-view" class="pt-4 border-t border-zinc-200 space-y-6">
      <!-- Tabs Switcher -->
      <div class="flex items-center gap-2 border-b border-zinc-200 font-mono text-xs">
        <button
          type="button"
          id="mlp-tab-btn-register"
          class="pb-3 px-1 font-bold text-zinc-950 border-b-2 border-zinc-950 transition-colors uppercase tracking-wider"
        >
          {texts.tabRegister}
        </button>
        <button
          type="button"
          id="mlp-tab-btn-login"
          class="pb-3 px-3 font-medium text-zinc-500 hover:text-zinc-950 border-b-2 border-transparent transition-colors uppercase tracking-wider"
        >
          {texts.tabLogin}
        </button>
      </div>

      <!-- Tab Content: Registration -->
      <form id="mlp-register-form" class="space-y-4">
        <input type="hidden" name="redirectUrl" value={redirectUrl} />
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="mlp-reg-name" class="font-mono text-[11px] font-bold uppercase tracking-wider text-zinc-700 block">
              {texts.nameLabel}
            </label>
            <input
              type="text"
              id="mlp-reg-name"
              name="nombre"
              required
              placeholder={texts.namePlaceholder}
              class="w-full border border-zinc-300 bg-paper px-3.5 py-2.5 font-sans text-sm text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-950 focus:outline-none"
            />
          </div>

          <div class="space-y-1.5">
            <label for="mlp-reg-email" class="font-mono text-[11px] font-bold uppercase tracking-wider text-zinc-700 block">
              {texts.emailLabel}
            </label>
            <input
              type="email"
              id="mlp-reg-email"
              name="email"
              required
              placeholder={texts.emailPlaceholder}
              class="w-full border border-zinc-300 bg-paper px-3.5 py-2.5 font-mono text-sm text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-950 focus:outline-none"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="mlp-reg-media" class="font-mono text-[11px] font-bold uppercase tracking-wider text-zinc-700 block">
              {texts.mediaLabel}
            </label>
            <input
              type="text"
              id="mlp-reg-media"
              name="medio"
              required
              placeholder={texts.mediaPlaceholder}
              class="w-full border border-zinc-300 bg-paper px-3.5 py-2.5 font-sans text-sm text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-950 focus:outline-none"
            />
          </div>

          <div class="space-y-1.5">
            <label for="mlp-reg-type" class="font-mono text-[11px] font-bold uppercase tracking-wider text-zinc-700 block">
              {texts.typeLabel}
            </label>
            <select
              id="mlp-reg-type"
              name="tipo_medio"
              class="w-full border border-zinc-300 bg-paper px-3.5 py-2.5 font-mono text-xs text-zinc-900 focus:border-zinc-950 focus:outline-none"
            >
              <option value="Digital">Digital / Web</option>
              <option value="Prensa Escrita">Prensa Escrita / Suplementos</option>
              <option value="Audiovisual / TV">Televisión / Audiovisual</option>
              <option value="Radio / Podcast">Radio / Podcast</option>
              <option value="Agencia">Agencia de Noticias</option>
              <option value="Fotoperiodismo">Fotoperiodismo</option>
              <option value="Freelance">Periodista Freelance / Creador</option>
            </select>
          </div>
        </div>

        <div class="flex items-start gap-2.5 pt-2">
          <input
            type="checkbox"
            id="mlp-reg-consent"
            name="consentimiento"
            required
            defaultChecked
            class="mt-1 h-4 w-4 rounded border-zinc-300 text-vermilion focus:ring-vermilion cursor-pointer"
          />
          <label for="mlp-reg-consent" class="font-sans text-xs text-zinc-600 leading-relaxed cursor-pointer">
            {texts.consentText}
          </label>
        </div>

        <div id="mlp-reg-error" class="hidden font-mono text-xs text-vermilion bg-red-50 p-3 border border-red-200"></div>

        <button
          type="submit"
          id="mlp-reg-submit"
          class="w-full bg-zinc-950 hover:bg-vermilion text-white font-mono text-xs font-bold uppercase tracking-widest py-3.5 px-6 transition-all duration-200 flex items-center justify-center gap-2 active:scale-[0.99]"
        >
          <span>{texts.submitRegister}</span>
        </button>
      </form>

      <!-- Tab Content: Returning Journalist Login -->
      <form id="mlp-login-form" class="space-y-4 hidden">
        <input type="hidden" name="redirectUrl" value={redirectUrl} />
        <div class="space-y-1.5 max-w-lg">
          <label for="mlp-login-email" class="font-mono text-[11px] font-bold uppercase tracking-wider text-zinc-700 block">
            {texts.emailLabel}
          </label>
          <input
            type="email"
            id="mlp-login-email"
            name="email"
            required
            placeholder={texts.emailPlaceholder}
            class="w-full border border-zinc-300 bg-paper px-3.5 py-2.5 font-mono text-sm text-zinc-900 placeholder:text-zinc-400 focus:border-zinc-950 focus:outline-none"
          />
        </div>

        <div id="mlp-login-error" class="hidden font-mono text-xs text-vermilion bg-red-50 p-3 border border-red-200"></div>

        <button
          type="submit"
          id="mlp-login-submit"
          class="w-full sm:w-auto bg-zinc-950 hover:bg-vermilion text-white font-mono text-xs font-bold uppercase tracking-widest py-3.5 px-8 transition-all duration-200 flex items-center justify-center gap-2 active:scale-[0.99]"
        >
          <span>{texts.submitLogin}</span>
        </button>
      </form>
    </div>

    <!-- VIEW 2: OTP VERIFICATION (6 Digits) -->
    <div id="mlp-gate-otp-view" class="pt-6 border-t border-zinc-200 space-y-6 hidden">
      <div class="space-y-2">
        <div class="font-mono text-xs uppercase tracking-widest text-vermilion font-bold flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-vermilion"></span>
          <span>{texts.otpTitle}</span>
        </div>
        <p class="font-sans text-sm text-zinc-600 leading-relaxed">
          {texts.otpDesc} <strong id="mlp-otp-target-email" class="text-zinc-950 font-mono"></strong>
        </p>
      </div>

      <!-- 6-Digit OTP Input Boxes -->
      <div class="flex items-center justify-center gap-2 sm:gap-3 py-4" id="mlp-otp-inputs-wrapper">
        <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="mlp-otp-digit w-11 h-14 sm:w-14 sm:h-16 text-center font-mono text-2xl sm:text-3xl font-bold border-2 border-zinc-300 bg-paper text-zinc-950 focus:border-zinc-950 focus:outline-none transition-colors" />
        <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="mlp-otp-digit w-11 h-14 sm:w-14 sm:h-16 text-center font-mono text-2xl sm:text-3xl font-bold border-2 border-zinc-300 bg-paper text-zinc-950 focus:border-zinc-950 focus:outline-none transition-colors" />
        <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="mlp-otp-digit w-11 h-14 sm:w-14 sm:h-16 text-center font-mono text-2xl sm:text-3xl font-bold border-2 border-zinc-300 bg-paper text-zinc-950 focus:border-zinc-950 focus:outline-none transition-colors" />
        <span class="text-zinc-300 font-mono text-xl font-bold">-</span>
        <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="mlp-otp-digit w-11 h-14 sm:w-14 sm:h-16 text-center font-mono text-2xl sm:text-3xl font-bold border-2 border-zinc-300 bg-paper text-zinc-950 focus:border-zinc-950 focus:outline-none transition-colors" />
        <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="mlp-otp-digit w-11 h-14 sm:w-14 sm:h-16 text-center font-mono text-2xl sm:text-3xl font-bold border-2 border-zinc-300 bg-paper text-zinc-950 focus:border-zinc-950 focus:outline-none transition-colors" />
        <input type="text" maxlength="1" inputmode="numeric" pattern="[0-9]*" class="mlp-otp-digit w-11 h-14 sm:w-14 sm:h-16 text-center font-mono text-2xl sm:text-3xl font-bold border-2 border-zinc-300 bg-paper text-zinc-950 focus:border-zinc-950 focus:outline-none transition-colors" />
      </div>

      <div id="mlp-otp-error" class="hidden font-mono text-xs text-vermilion bg-red-50 p-3 border border-red-200 text-center"></div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2">
        <button
          type="button"
          id="mlp-otp-submit-btn"
          class="w-full sm:w-auto bg-zinc-950 hover:bg-vermilion text-white font-mono text-xs font-bold uppercase tracking-widest py-3.5 px-8 transition-all duration-200 active:scale-[0.99]"
        >
          {texts.verifyBtn}
        </button>

        <div class="flex items-center gap-4 font-mono text-xs text-zinc-500">
          <button type="button" id="mlp-otp-resend-btn" class="hover:text-zinc-950 underline transition-colors">
            {texts.resendBtn}
          </button>
          <span>·</span>
          <button type="button" id="mlp-otp-back-btn" class="hover:text-zinc-950 underline transition-colors">
            {texts.changeEmail}
          </button>
        </div>
      </div>
    </div>

    <!-- VIEW 3: SUCCESS BANNER -->
    <div id="mlp-gate-success-view" class="pt-8 pb-4 text-center space-y-3 hidden">
      <div class="w-12 h-12 bg-zinc-950 text-white rounded-full flex items-center justify-center mx-auto text-xl font-bold">
        ✓
      </div>
      <h4 class="font-display text-xl font-bold text-zinc-950">Acreditación Verificada</h4>
      <p class="font-sans text-xs text-zinc-600">Desbloqueando comunicado completo y recursos de redacción...</p>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    let currentEmail = '';

    const tabRegister = document.getElementById('mlp-tab-btn-register');
    const tabLogin = document.getElementById('mlp-tab-btn-login');
    const formRegister = document.getElementById('mlp-register-form');
    const formLogin = document.getElementById('mlp-login-form');
    const viewForms = document.getElementById('mlp-gate-form-view');
    const viewOtp = document.getElementById('mlp-gate-otp-view');
    const viewSuccess = document.getElementById('mlp-gate-success-view');

    const targetEmailSpan = document.getElementById('mlp-otp-target-email');
    const otpError = document.getElementById('mlp-otp-error');
    const regError = document.getElementById('mlp-reg-error');
    const loginError = document.getElementById('mlp-login-error');
    const otpDigits = Array.from(document.querySelectorAll('.mlp-otp-digit'));
    const otpSubmitBtn = document.getElementById('mlp-otp-submit-btn');
    const otpResendBtn = document.getElementById('mlp-otp-resend-btn');
    const otpBackBtn = document.getElementById('mlp-otp-back-btn');

    // Tab Switching
    tabRegister?.addEventListener('click', () => {
      tabRegister.classList.add('border-zinc-950', 'text-zinc-950', 'font-bold');
      tabRegister.classList.remove('border-transparent', 'text-zinc-500', 'font-medium');
      tabLogin.classList.add('border-transparent', 'text-zinc-500', 'font-medium');
      tabLogin.classList.remove('border-zinc-950', 'text-zinc-950', 'font-bold');
      formRegister.classList.remove('hidden');
      formLogin.classList.add('hidden');
    });

    tabLogin?.addEventListener('click', () => {
      tabLogin.classList.add('border-zinc-950', 'text-zinc-950', 'font-bold');
      tabLogin.classList.remove('border-transparent', 'text-zinc-500', 'font-medium');
      tabRegister.classList.add('border-transparent', 'text-zinc-500', 'font-medium');
      tabRegister.classList.remove('border-zinc-950', 'text-zinc-950', 'font-bold');
      formLogin.classList.remove('hidden');
      formRegister.classList.add('hidden');
    });

    // Handle Registration Submission
    formRegister?.addEventListener('submit', async (e) => {
      e.preventDefault();
      regError.classList.add('hidden');
      const submitBtn = document.getElementById('mlp-reg-submit');
      submitBtn.disabled = true;
      submitBtn.innerHTML = 'ENVIANDO CÓDIGO...';

      const formData = new FormData(formRegister);
      const payload = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/press-auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (!data.success) {
          regError.textContent = data.message || 'Error al procesar el registro.';
          regError.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.innerHTML = 'SOLICITAR PASE Y VERIFICAR EMAIL →';
          return;
        }

        currentEmail = data.email;
        targetEmailSpan.textContent = currentEmail;
        viewForms.classList.add('hidden');
        viewOtp.classList.remove('hidden');
        otpDigits[0]?.focus();
      } catch (err) {
        regError.textContent = 'Error de conexión. Inténtalo de nuevo.';
        regError.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'SOLICITAR PASE Y VERIFICAR EMAIL →';
      }
    });

    // Handle Login Submission
    formLogin?.addEventListener('submit', async (e) => {
      e.preventDefault();
      loginError.classList.add('hidden');
      const submitBtn = document.getElementById('mlp-login-submit');
      submitBtn.disabled = true;
      submitBtn.innerHTML = 'ENVIANDO...';

      const formData = new FormData(formLogin);
      const payload = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/press-auth/request-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();

        if (!data.success) {
          loginError.textContent = data.message || 'Error al solicitar el código.';
          loginError.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.innerHTML = 'ENVIAR CÓDIGO DE ACCESO (OTP) →';
          return;
        }

        currentEmail = data.email;
        targetEmailSpan.textContent = currentEmail;
        viewForms.classList.add('hidden');
        viewOtp.classList.remove('hidden');
        otpDigits[0]?.focus();
      } catch (err) {
        loginError.textContent = 'Error de conexión. Inténtalo de nuevo.';
        loginError.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.innerHTML = 'ENVIAR CÓDIGO DE ACCESO (OTP) →';
      }
    });

    // OTP 6-Digit Keyboard Handling & Auto-jump
    otpDigits.forEach((input, idx) => {
      input.addEventListener('input', (e) => {
        const val = e.target.value.replace(/\D/g, '');
        e.target.value = val ? val.slice(-1) : '';

        if (val && idx < otpDigits.length - 1) {
          otpDigits[idx + 1].focus();
        }

        checkAutoSubmit();
      });

      input.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !input.value && idx > 0) {
          otpDigits[idx - 1].focus();
        }
      });

      input.addEventListener('paste', (e) => {
        e.preventDefault();
        const text = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '');
        if (!text) return;
        text.split('').slice(0, 6).forEach((char, i) => {
          if (otpDigits[i]) otpDigits[i].value = char;
        });
        const nextIdx = Math.min(text.length, 5);
        otpDigits[nextIdx]?.focus();
        checkAutoSubmit();
      });
    });

    function getEnteredOtp() {
      return otpDigits.map((d) => d.value.trim()).join('');
    }

    function checkAutoSubmit() {
      const code = getEnteredOtp();
      if (code.length === 6) {
        submitOtpCode(code);
      }
    }

    otpSubmitBtn?.addEventListener('click', () => {
      const code = getEnteredOtp();
      if (code.length < 6) {
        otpError.textContent = 'Por favor, introduce los 6 dígitos del código.';
        otpError.classList.remove('hidden');
        return;
      }
      submitOtpCode(code);
    });

    async function submitOtpCode(code) {
      otpError.classList.add('hidden');
      otpSubmitBtn.disabled = true;
      otpSubmitBtn.innerHTML = 'VERIFICANDO...';

      try {
        const res = await fetch('/api/press-auth/verify-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: currentEmail, code }),
        });
        const data = await res.json();

        if (!data.success) {
          otpError.textContent = data.message || 'Código incorrecto o expirado.';
          otpError.classList.remove('hidden');
          otpSubmitBtn.disabled = false;
          otpSubmitBtn.innerHTML = 'VERIFICAR Y DESBLOQUEAR CONTENIDO →';
          return;
        }

        // Success!
        viewOtp.classList.add('hidden');
        viewSuccess.classList.remove('hidden');

        // Reload to render full server-side content seamlessly
        setTimeout(() => {
          window.location.reload();
        }, 800);
      } catch (err) {
        otpError.textContent = 'Error de conexión al verificar el código.';
        otpError.classList.remove('hidden');
        otpSubmitBtn.disabled = false;
        otpSubmitBtn.innerHTML = 'VERIFICAR Y DESBLOQUEAR CONTENIDO →';
      }
    }

    // Back button
    otpBackBtn?.addEventListener('click', () => {
      viewOtp.classList.add('hidden');
      viewForms.classList.remove('hidden');
      document.getElementById('mlp-reg-submit').disabled = false;
      document.getElementById('mlp-reg-submit').innerHTML = 'SOLICITAR PASE Y VERIFICAR EMAIL →';
      document.getElementById('mlp-login-submit').disabled = false;
      document.getElementById('mlp-login-submit').innerHTML = 'ENVIAR CÓDIGO DE ACCESO (OTP) →';
    });

    // Resend OTP
    otpResendBtn?.addEventListener('click', async () => {
      otpResendBtn.disabled = true;
      otpResendBtn.textContent = 'Enviando...';
      try {
        await fetch('/api/press-auth/request-otp', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: currentEmail }),
        });
        otpResendBtn.textContent = '¡Código reenviado!';
        setTimeout(() => {
          otpResendBtn.disabled = false;
          otpResendBtn.textContent = '¿No has recibido el código? Reenviar';
        }, 30000);
      } catch (e) {
        otpResendBtn.disabled = false;
        otpResendBtn.textContent = 'Error al reenviar. Reintentar';
      }
    });
  })();
</script>
