---
interface Props {
  title: string;
  scriptText: string;
  duration?: string;
  audioUrl?: string;
  slug?: string;
  lang?: 'es' | 'en';
}

const {
  title,
  scriptText,
  duration = '1:30 min',
  audioUrl,
  slug = '',
  lang = 'es',
} = Astro.props;

const isEn = lang === 'en';
const playerId = `audio-brief-${Math.random().toString(36).substring(2, 9)}`;
const ttsEndpoint = `/api/elevenlabs-tts?slug=${encodeURIComponent(slug)}&lang=${lang}`;

// Calculate a reasonable initial display duration based on word count (~130 words per minute)
const words = scriptText ? scriptText.trim().split(/\s+/).length : 200;
const estTotalSecs = Math.max(30, Math.round((words / 135) * 60));
const estMins = Math.floor(estTotalSecs / 60);
const estSecs = estTotalSecs % 60;
const initialFormattedDuration = `${estMins}:${estSecs < 10 ? '0' : ''}${estSecs} MIN`;
---

<div
  id={playerId}
  class="audio-brief-player border border-zinc-200 bg-canvas p-4 sm:p-5 transition-all hover:border-zinc-950 font-mono text-xs my-6 select-none"
  data-text={scriptText}
  data-audio={audioUrl || ttsEndpoint}
  data-lang={isEn ? 'en-US' : 'es-ES'}
>
  <!-- Hidden Audio Element -->
  <audio class="brief-audio-element" preload="none"></audio>

  <!-- Top bar: Title on Left, Duration + Speed aligned on Right in a single line -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-zinc-200">
    <!-- Left: Headphones Icon + AUDIO BRIEF -->
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-zinc-900 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 18v-6a9 9 0 0 1 18 0v6M3 18a3 3 0 0 0 3 3h1a1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1H3zm18 0a3 3 0 0 1-3 3h-1a1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1h4z"/>
      </svg>
      <span class="font-bold text-zinc-950 uppercase tracking-wider font-mono text-xs">
        AUDIO BRIEF
      </span>
    </div>

    <!-- Right: Single-line Duration aligned with Speed -->
    <div class="flex items-center gap-3 sm:gap-4 flex-nowrap whitespace-nowrap">
      <!-- Dynamic Duration Badge (Single line) -->
      <span class="audio-duration-badge font-mono text-[11px] text-zinc-600 font-semibold tracking-wider whitespace-nowrap uppercase">
        {initialFormattedDuration}
      </span>

      <span class="text-zinc-300 select-none">|</span>

      <!-- Speed Controller -->
      <div class="flex items-center gap-1 text-[11px] whitespace-nowrap">
        <span class="text-zinc-400 mr-1 font-mono">{isEn ? 'SPEED:' : 'VELOCIDAD:'}</span>
        <button type="button" class="speed-btn px-2 py-0.5 border border-zinc-300 bg-paper font-bold text-zinc-950 is-active transition-colors" data-speed="1">1x</button>
        <button type="button" class="speed-btn px-2 py-0.5 border border-zinc-200 hover:border-zinc-950 text-zinc-600 hover:text-zinc-950 font-semibold transition-colors" data-speed="1.25">1.25x</button>
        <button type="button" class="speed-btn px-2 py-0.5 border border-zinc-200 hover:border-zinc-950 text-zinc-600 hover:text-zinc-950 font-semibold transition-colors" data-speed="1.5">1.5x</button>
      </div>
    </div>
  </div>

  <!-- Player controls & waveform -->
  <div class="pt-3 flex items-center gap-4">
    <!-- Play/Pause Button -->
    <button
      type="button"
      class="play-toggle-btn w-11 h-11 rounded-none bg-zinc-950 hover:bg-vermilion text-white flex items-center justify-center transition-colors flex-shrink-0 active:scale-95 shadow-sm cursor-pointer"
      aria-label={isEn ? 'Play audio brief' : 'Reproducir audio-brief'}
    >
      <!-- Play Icon -->
      <svg class="play-icon w-5 h-5 translate-x-0.5" fill="currentColor" viewBox="0 0 24 24">
        <polygon points="5 3 19 12 5 21 5 3"></polygon>
      </svg>
      <!-- Loading Spinner (hidden by default) -->
      <svg class="loading-icon w-5 h-5 animate-spin hidden" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
      </svg>
      <!-- Pause Icon (hidden by default) -->
      <svg class="pause-icon w-5 h-5 hidden" fill="currentColor" viewBox="0 0 24 24">
        <rect x="6" y="4" width="4" height="16"></rect>
        <rect x="14" y="4" width="4" height="16"></rect>
      </svg>
    </button>

    <!-- Visualizer / Scrubber -->
    <div class="flex-1 space-y-1.5">
      <div class="flex items-center justify-between font-mono text-[10px] text-zinc-500 uppercase tracking-wider">
        <span class="current-time">0:00</span>
        <div class="flex items-center gap-0.5 waveform-container h-3 px-2">
          <span class="wave-bar w-0.5 h-1.5 bg-zinc-400"></span>
          <span class="wave-bar w-0.5 h-3 bg-zinc-400"></span>
          <span class="wave-bar w-0.5 h-2 bg-zinc-400"></span>
          <span class="wave-bar w-0.5 h-3.5 bg-zinc-400"></span>
          <span class="wave-bar w-0.5 h-1 bg-zinc-400"></span>
          <span class="wave-bar w-0.5 h-2.5 bg-zinc-400"></span>
          <span class="wave-bar w-0.5 h-3 bg-zinc-400"></span>
          <span class="wave-bar w-0.5 h-1.5 bg-zinc-400"></span>
          <span class="wave-bar w-0.5 h-2 bg-zinc-400"></span>
        </div>
        <span class="total-time">{initialFormattedDuration}</span>
      </div>

      <!-- Scrubber track -->
      <div class="scrubber-track relative w-full h-1.5 bg-zinc-200 cursor-pointer overflow-hidden">
        <div class="scrubber-fill h-full bg-zinc-950 w-0 transition-all duration-75"></div>
      </div>
    </div>
  </div>

  <!-- Clear non-technical note indicating it is a narration of the text -->
  <p class="font-sans text-[11px] text-zinc-500 italic pt-2.5">
    {isEn
      ? 'Audio narration generated from the article text.'
      : 'Locución generada automáticamente a partir del texto de la nota.'}
  </p>
</div>

<script>
  function initAudioBriefPlayers() {
    const players = document.querySelectorAll('.audio-brief-player');

    players.forEach((player) => {
      if (player.hasAttribute('data-initialized')) return;
      player.setAttribute('data-initialized', 'true');

      const audioEl = player.querySelector('.brief-audio-element') as HTMLAudioElement;
      const playBtn = player.querySelector('.play-toggle-btn') as HTMLButtonElement;
      const playIcon = player.querySelector('.play-icon');
      const pauseIcon = player.querySelector('.pause-icon');
      const loadingIcon = player.querySelector('.loading-icon');
      const currentTimeEl = player.querySelector('.current-time');
      const totalTimeEl = player.querySelector('.total-time');
      const durationBadge = player.querySelector('.audio-duration-badge');
      const scrubberTrack = player.querySelector('.scrubber-track') as HTMLElement;
      const scrubberFill = player.querySelector('.scrubber-fill') as HTMLElement;
      const speedBtns = player.querySelectorAll('.speed-btn');
      const waveBars = player.querySelectorAll('.wave-bar');

      const text = player.getAttribute('data-text') || '';
      const audioSrc = player.getAttribute('data-audio') || '';
      const speechLang = player.getAttribute('data-lang') || 'es-ES';

      let isPlaying = false;
      let usingFallbackTTS = false;
      let currentRate = 1.0;
      let synthUtterance: SpeechSynthesisUtterance | null = null;
      let synthTimer: any = null;
      let elapsedSeconds = 0;

      function formatTime(secs: number) {
        if (!secs || isNaN(secs)) return '0:00';
        const m = Math.floor(secs / 60);
        const s = Math.floor(secs % 60);
        return `${m}:${s < 10 ? '0' : ''}${s}`;
      }

      function updateWaveform(animating: boolean) {
        waveBars.forEach((bar) => {
          if (animating) {
            bar.classList.add('animate-pulse');
            bar.classList.remove('bg-zinc-400');
            bar.classList.add('bg-vermilion');
          } else {
            bar.classList.remove('animate-pulse');
            bar.classList.add('bg-zinc-400');
            bar.classList.remove('bg-vermilion');
          }
        });
      }

      function setPlayingState() {
        isPlaying = true;
        playIcon?.classList.add('hidden');
        loadingIcon?.classList.add('hidden');
        pauseIcon?.classList.remove('hidden');
        updateWaveform(true);
      }

      function setPausedState() {
        isPlaying = false;
        playIcon?.classList.remove('hidden');
        loadingIcon?.classList.add('hidden');
        pauseIcon?.classList.add('hidden');
        updateWaveform(false);
      }

      function setLoadingState() {
        playIcon?.classList.add('hidden');
        pauseIcon?.classList.add('hidden');
        loadingIcon?.classList.remove('hidden');
      }

      // 1. Audio Element Event Listeners
      if (audioEl) {
        audioEl.addEventListener('loadedmetadata', () => {
          if (audioEl.duration && isFinite(audioEl.duration)) {
            const formatted = `${formatTime(audioEl.duration)} MIN`;
            if (totalTimeEl) totalTimeEl.textContent = formatted;
            if (durationBadge) durationBadge.textContent = formatted;
          }
        });

        audioEl.addEventListener('play', () => {
          setPlayingState();
        });

        audioEl.addEventListener('pause', () => {
          setPausedState();
        });

        audioEl.addEventListener('ended', () => {
          setPausedState();
          if (scrubberFill) scrubberFill.style.width = '0%';
          if (currentTimeEl) currentTimeEl.textContent = '0:00';
        });

        audioEl.addEventListener('timeupdate', () => {
          if (!audioEl.duration) return;
          const cur = audioEl.currentTime;
          const dur = audioEl.duration;
          if (currentTimeEl) currentTimeEl.textContent = formatTime(cur);
          if (totalTimeEl && isFinite(dur)) {
            const formatted = `${formatTime(dur)} MIN`;
            totalTimeEl.textContent = formatted;
            if (durationBadge) durationBadge.textContent = formatted;
          }
          const pct = Math.min((cur / dur) * 100, 100);
          if (scrubberFill) scrubberFill.style.width = `${pct}%`;
        });

        audioEl.addEventListener('error', (e) => {
          console.warn('Audio playback load error, falling back to Web Speech API:', e);
          usingFallbackTTS = true;
          startFallbackSpeech();
        });
      }

      // 2. Fallback Web Speech API
      function startFallbackSpeech() {
        if (!('speechSynthesis' in window)) return;
        window.speechSynthesis.cancel();
        synthUtterance = new SpeechSynthesisUtterance(text);
        synthUtterance.lang = speechLang;
        synthUtterance.rate = currentRate;

        synthUtterance.onstart = () => {
          setPlayingState();
        };

        synthUtterance.onend = () => {
          setPausedState();
          elapsedSeconds = 0;
          if (scrubberFill) scrubberFill.style.width = '0%';
          if (synthTimer) clearInterval(synthTimer);
        };

        synthUtterance.onerror = () => {
          setPausedState();
          if (synthTimer) clearInterval(synthTimer);
        };

        window.speechSynthesis.speak(synthUtterance);
        setPlayingState();

        if (synthTimer) clearInterval(synthTimer);
        synthTimer = setInterval(() => {
          elapsedSeconds += 1 * currentRate;
          if (currentTimeEl) currentTimeEl.textContent = formatTime(elapsedSeconds);
          const estDuration = Math.max(30, (text.split(' ').length / 130) * 60);
          const pct = Math.min((elapsedSeconds / estDuration) * 100, 100);
          if (scrubberFill) scrubberFill.style.width = `${pct}%`;
        }, 1000);
      }

      function pauseFallbackSpeech() {
        if (!('speechSynthesis' in window)) return;
        window.speechSynthesis.pause();
        setPausedState();
        if (synthTimer) clearInterval(synthTimer);
      }

      function resumeFallbackSpeech() {
        if (!('speechSynthesis' in window)) return;
        window.speechSynthesis.resume();
        setPlayingState();
      }

      // Play / Pause Toggle
      playBtn?.addEventListener('click', async () => {
        if (usingFallbackTTS) {
          if (!isPlaying) {
            if (window.speechSynthesis.paused) {
              resumeFallbackSpeech();
            } else {
              startFallbackSpeech();
            }
          } else {
            pauseFallbackSpeech();
          }
          return;
        }

        if (!audioEl.src && audioSrc) {
          setLoadingState();
          audioEl.src = audioSrc;
          audioEl.load();
        }

        if (!isPlaying) {
          try {
            setLoadingState();
            await audioEl.play();
          } catch (err) {
            console.warn('Audio play failed, triggering fallback speech:', err);
            usingFallbackTTS = true;
            startFallbackSpeech();
          }
        } else {
          audioEl.pause();
        }
      });

      // Scrubber Seek
      scrubberTrack?.addEventListener('click', (e) => {
        if (usingFallbackTTS) return;
        if (!audioEl.duration) return;
        const rect = scrubberTrack.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        const width = rect.width;
        const pct = Math.max(0, Math.min(1, clickX / width));
        audioEl.currentTime = pct * audioEl.duration;
        if (scrubberFill) scrubberFill.style.width = `${pct * 100}%`;
      });

      // Speed Adjustments
      speedBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const speed = parseFloat(btn.getAttribute('data-speed') || '1');
          currentRate = speed;

          if (audioEl) {
            audioEl.playbackRate = speed;
          }
          if (synthUtterance && window.speechSynthesis.speaking) {
            window.speechSynthesis.cancel();
            startFallbackSpeech();
          }

          speedBtns.forEach((b) => {
            b.classList.remove('is-active', 'border-zinc-300', 'bg-paper', 'text-zinc-950');
            b.classList.add('border-zinc-200', 'text-zinc-600');
          });
          btn.classList.add('is-active', 'border-zinc-300', 'bg-paper', 'text-zinc-950');
          btn.classList.remove('border-zinc-200', 'text-zinc-600');
        });
      });
    });
  }

  // Initialize on load and on Astro view transitions
  document.addEventListener('DOMContentLoaded', initAudioBriefPlayers);
  document.addEventListener('astro:page-load', initAudioBriefPlayers);
</script>
