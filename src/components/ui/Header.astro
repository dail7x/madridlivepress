---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const currentPath = Astro.url.pathname;
const isEn = lang === 'en' || currentPath.startsWith('/en');

const navItems = isEn
  ? [
      { label: 'NEWS', href: '/en/news' },
      { label: 'COVERAGE', href: '/en/coverage' },
      { label: 'PRESS KITS', href: '/en/press-kits' },
      { label: 'DIRECTORY', href: '/en/directory' },
      { label: 'ARCHIVE', href: '/en/archive' },
      { label: 'ABOUT THE SECTOR', href: '/en/about' },
    ]
  : [
      { label: 'NOTICIAS', href: '/comunicados' },
      { label: 'COBERTURA', href: '/cobertura' },
      { label: 'PRESS KITS', href: '/press-kits' },
      { label: 'DIRECTORIO', href: '/directorio' },
      { label: 'ARCHIVO', href: '/archivo' },
      { label: 'SOBRE EL SECTOR', href: '/sobre-el-sector' },
    ];
---

<header class="w-full bg-paper border-b border-zinc-200 z-20 sticky top-0 md:relative backdrop-blur-md bg-paper/95">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between md:justify-center h-12 md:h-16 relative">
      <!-- Centered Desktop Navigation Bar with Interactive Animated Home Button -->
      <nav
        id="desktopNav"
        class="hidden md:flex items-center justify-center gap-1 sm:gap-2 lg:gap-3 font-mono text-xs text-zinc-900 relative py-2 whitespace-nowrap"
        aria-label="Navegación principal"
      >
        <!-- Interactive Animated Home Return Button -->
        <a
          href={isEn ? '/en' : '/'}
          data-astro-prefetch="hover"
          class="group relative inline-flex items-center gap-2 px-3 py-1.5 border border-zinc-200 bg-paper hover:border-zinc-950 hover:bg-zinc-950 hover:text-white transition-all duration-300 font-mono text-[11px] font-bold uppercase tracking-wider active:scale-[0.96] shadow-sm mr-1"
          title={isEn ? 'Return to Home / Live Pressroom' : 'Volver a Portada / Inicio'}
        >
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-vermilion opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-vermilion"></span>
          </span>
          <span>{isEn ? 'PORTAL' : 'INICIO'}</span>
          <span class="opacity-40 group-hover:opacity-100 group-hover:-translate-x-0.5 transition-all text-xs">⌂</span>
        </a>

        <!-- Sliding Underline Indicator (NYC Newsroom Style) -->
        <div
          id="navHoverIndicator"
          class="absolute bottom-0 h-0.5 bg-zinc-950 transition-all duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] pointer-events-none opacity-0"
        ></div>

        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && item.href !== '/en' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              data-astro-prefetch="hover"
              class={`nav-link-item px-2.5 lg:px-3 py-1.5 font-bold uppercase tracking-wider transition-colors relative hover:text-vermilion active:scale-[0.98] whitespace-nowrap ${
                isActive ? 'text-zinc-950 is-active font-extrabold' : 'text-zinc-700 font-semibold'
              }`}
            >
              {item.label}
            </a>
          );
        })}

        <!-- Minimalist Search Icon -->
        <a
          href={isEn ? '/en/archive' : '/archivo'}
          data-astro-prefetch="hover"
          class="text-zinc-700 hover:text-zinc-950 p-1.5 transition-colors active:scale-[0.95]"
          aria-label={isEn ? 'Search' : 'Buscar'}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </a>

        <span class="text-zinc-300 mx-1 select-none">|</span>

        <!-- Accreditation CTA Button -->
        <a
          href={isEn ? '/en/accreditation' : '/acreditaciones'}
          data-astro-prefetch="hover"
          class="font-mono text-xs uppercase tracking-wider text-zinc-900 hover:text-vermilion px-2.5 py-1 transition-colors font-bold whitespace-nowrap"
        >
          {isEn ? 'ACCREDITATION' : 'ACREDITACIÓN'}
        </a>

        <!-- Drawer Toggle Button -->
        <button
          id="menuToggleBtn"
          type="button"
          class="text-zinc-800 hover:text-zinc-950 p-1.5 transition-colors active:scale-[0.95]"
          aria-label="Abrir menú"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
      </nav>

      <!-- Mobile Top Bar: Language & Hamburger -->
      <div class="flex items-center justify-between w-full md:hidden">
        <a href={isEn ? '/en' : '/'} class="font-display font-bold text-xs tracking-wider text-zinc-950 uppercase flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-vermilion inline-block"></span>
          <span>MADRID LIVE PRESS</span>
        </a>

        <div class="flex items-center gap-2">
          <a
            href={isEn ? currentPath.replace(/^\/en(\/|$)/, '/').replace(/\/$/, '') || '/' : `/en${currentPath === '/' ? '' : currentPath}`}
            class="font-mono text-xs font-bold text-zinc-950 uppercase tracking-widest px-2 py-1"
          >
            {isEn ? 'ES' : 'EN'}
          </a>

          <button
            id="mobileMenuBtn"
            type="button"
            class="p-1 text-zinc-900 active:scale-[0.95]"
            aria-label="Menú"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <line x1="3" y1="7" x2="21" y2="7" />
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="17" x2="21" y2="17" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Full Drawer Menu -->
  <div id="fullMenuDrawer" class="hidden border-t border-zinc-200 bg-paper px-4 py-8 space-y-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
      <div>
        <h4 class="font-mono text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">
          {isEn ? 'Navigation' : 'Navegación'}
        </h4>
        <div class="space-y-2">
          <a href={isEn ? '/en' : '/'} class="block font-mono text-sm uppercase tracking-wider text-zinc-800 hover:text-vermilion font-bold">
            {isEn ? 'Home / Portal' : 'Inicio / Portada'} ⌂
          </a>
          {navItems.map((item) => (
            <a href={item.href} class="block font-mono text-sm uppercase tracking-wider text-zinc-800 hover:text-vermilion">
              {item.label}
            </a>
          ))}
        </div>
      </div>

      <div>
        <h4 class="font-mono text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">
          {isEn ? 'Press Office' : 'Gabinete de Prensa'}
        </h4>
        <div class="space-y-2 font-mono text-xs text-zinc-600">
          <a href={isEn ? '/en/accreditation' : '/acreditaciones'} class="block hover:text-vermilion">
            {isEn ? 'Request Accreditation' : 'Solicitar Acreditación'}
          </a>
          <a href={isEn ? '/en/press-kits' : '/press-kits'} class="block hover:text-vermilion">
            {isEn ? 'Press Kits & B-Roll' : 'Press Kits y B-Roll Oficial'}
          </a>
          <a href={isEn ? '/en/events' : '/eventos'} class="block hover:text-vermilion">
            {isEn ? 'Media Agenda & Calls' : 'Agenda de Convocatorias'}
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-mono text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">
          {isEn ? 'Associated Federation' : 'Federación Oficial'}
        </h4>
        <p class="font-mono text-xs text-zinc-600 leading-relaxed">
          NOCHEMADRID<br />
          {isEn ? 'Madrid Nightlife & Performing Arts Federation' : 'Asociados de Ocio y Espectáculos de Madrid'}<br />
          prensa@nochemadrid.org
        </p>
      </div>

      <div>
        <h4 class="font-mono text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">
          {isEn ? 'Language' : 'Idioma'}
        </h4>
        <div class="flex gap-4 font-mono text-xs">
          <a href="/" class={!isEn ? 'font-bold text-vermilion' : 'text-zinc-600'}>
            Castellano (ES)
          </a>
          <span class="text-zinc-300">/</span>
          <a href="/en" class={isEn ? 'font-bold text-vermilion' : 'text-zinc-600'}>
            English (EN)
          </a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function setupHeader() {
      const nav = document.getElementById('desktopNav');
      const indicator = document.getElementById('navHoverIndicator');
      const links = document.querySelectorAll('.nav-link-item');
      const activeLink = document.querySelector('.nav-link-item.is-active');

      function positionIndicator(elem) {
        if (!elem || !indicator || !nav) {
          if (indicator) indicator.style.opacity = '0';
          return;
        }
        const navRect = nav.getBoundingClientRect();
        const elemRect = elem.getBoundingClientRect();

        indicator.style.width = `${elemRect.width}px`;
        indicator.style.left = `${elemRect.left - navRect.left}px`;
        indicator.style.opacity = '1';
      }

      if (activeLink) {
        positionIndicator(activeLink);
      }

      links.forEach((link) => {
        link.addEventListener('mouseenter', () => {
          positionIndicator(link);
        });
      });

      nav?.addEventListener('mouseleave', () => {
        if (activeLink) {
          positionIndicator(activeLink);
        } else if (indicator) {
          indicator.style.opacity = '0';
        }
      });

      const toggleBtn = document.getElementById('menuToggleBtn');
      const mobileBtn = document.getElementById('mobileMenuBtn');
      const drawer = document.getElementById('fullMenuDrawer');

      const toggle = () => {
        drawer?.classList.toggle('hidden');
      };

      toggleBtn?.addEventListener('click', toggle);
      mobileBtn?.addEventListener('click', toggle);
    }

    document.addEventListener('astro:page-load', setupHeader);
    setupHeader();
  </script>
</header>
