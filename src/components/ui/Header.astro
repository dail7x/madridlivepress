---
interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const currentPath = Astro.url.pathname;
const isEn = lang === 'en' || currentPath.startsWith('/en');
const prefix = isEn ? '/en' : '';

const navItems = [
  { label: isEn ? 'News' : 'Noticias', href: `${prefix}/comunicados` },
  { label: isEn ? 'Resources' : 'Recursos', href: `${prefix}/recursos-prensa` },
  { label: isEn ? 'Venues' : 'Archivo', href: `${prefix}/salas` },
  { label: isEn ? 'The Sector' : 'Sobre el sector', href: `${prefix}/eventos` },
];
---

<header class="w-full bg-paper border-b border-zinc-200 z-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 md:h-20">
      <!-- Left side (Mobile logo & Desktop subtle branding) -->
      <div class="flex items-center gap-4">
        <a href={isEn ? '/en' : '/'} class="md:hidden flex items-center gap-2 group">
          <span class="font-display font-bold text-base tracking-tight text-zinc-900">
            MADRID<span class="text-vermilion">LIVE</span>PRESS
          </span>
          <span class="w-1.5 h-1.5 rounded-full bg-vermilion inline-block"></span>
        </a>

        <!-- Desktop breadcrumb / space -->
        <div class="hidden md:flex items-center gap-2 font-mono text-xs text-zinc-400">
          <a href={isEn ? '/en' : '/'} class="hover:text-zinc-900 transition-colors">
            {isEn ? 'OFFICIAL PRESS ROOM' : 'SALA DE PRENSA OFICIAL'}
          </a>
          <span>/</span>
          <span class="text-zinc-900 font-medium">{isEn ? 'NOCHEMADRID' : 'NOCHEMADRID'}</span>
        </div>
      </div>

      <!-- Right side navigation links (Matching Reference Images 1 & 2) -->
      <nav class="hidden md:flex items-center gap-8 font-sans text-sm text-zinc-800" aria-label="Navegación principal">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`hover:text-vermilion transition-colors ${isActive ? 'text-zinc-950 font-semibold' : 'text-zinc-700'}`}
            >
              {item.label}
            </a>
          );
        })}

        <!-- Minimalist Search Icon -->
        <a
          href={`${prefix}/comunicados`}
          class="text-zinc-700 hover:text-zinc-950 p-1 transition-colors"
          aria-label={isEn ? 'Search' : 'Buscar'}
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
          </svg>
        </a>

        <span class="text-zinc-300">|</span>

        <!-- Accreditation CTA / Mobile trigger -->
        <a
          href={`${prefix}/acreditaciones`}
          class="font-mono text-xs uppercase tracking-wider text-zinc-900 hover:text-vermilion transition-colors"
        >
          {isEn ? 'Accreditation' : 'Acreditación'}
        </a>

        <!-- Hamburger Icon for full drawer -->
        <button
          id="menuToggleBtn"
          type="button"
          class="text-zinc-800 hover:text-zinc-950 p-1 transition-colors"
          aria-label="Abrir menú"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="3" y1="6" x2="21" y2="6" />
            <line x1="3" y1="12" x2="21" y2="12" />
            <line x1="3" y1="18" x2="21" y2="18" />
          </svg>
        </button>
      </nav>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex items-center gap-2 md:hidden">
        <button
          id="mobileMenuBtn"
          type="button"
          class="p-2 text-zinc-700 hover:text-zinc-950"
          aria-label="Menú"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <line x1="4" y1="6" x2="20" y2="6" />
            <line x1="4" y1="12" x2="20" y2="12" />
            <line x1="4" y1="18" x2="20" y2="18" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Full Drawer / Mobile Menu -->
  <div id="fullMenuDrawer" class="hidden border-t border-zinc-200 bg-paper px-4 py-8 space-y-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
      <div>
        <h4 class="font-mono text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">
          {isEn ? 'Navigation' : 'Navegación'}
        </h4>
        <div class="space-y-2">
          {navItems.map((item) => (
            <a href={item.href} class="block font-sans text-base text-zinc-800 hover:text-vermilion">
              {item.label}
            </a>
          ))}
        </div>
      </div>

      <div>
        <h4 class="font-mono text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">
          {isEn ? 'Press Office' : 'Oficina de Prensa'}
        </h4>
        <div class="space-y-2 font-sans text-sm text-zinc-600">
          <a href={`${prefix}/acreditaciones`} class="block hover:text-vermilion">
            {isEn ? 'Request Accreditation' : 'Solicitar Acreditación'}
          </a>
          <a href={`${prefix}/recursos-prensa`} class="block hover:text-vermilion">
            {isEn ? 'Media Kits & B-Roll' : 'Media Kits y Recursos'}
          </a>
          <a href={`${prefix}/eventos`} class="block hover:text-vermilion">
            {isEn ? 'Media Agenda' : 'Agenda de Medios'}
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-mono text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">
          {isEn ? 'Language' : 'Idioma'}
        </h4>
        <div class="flex gap-4 font-mono text-sm">
          <a href={currentPath.replace(/^\/en/, '') || '/'} class={!isEn ? 'font-bold text-vermilion' : 'text-zinc-600'}>
            Castellano (ES)
          </a>
          <span class="text-zinc-300">/</span>
          <a href={`/en${currentPath === '/' ? '' : currentPath}`} class={isEn ? 'font-bold text-vermilion' : 'text-zinc-600'}>
            English (EN)
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-mono text-xs font-semibold text-zinc-400 uppercase tracking-widest mb-3">
          {isEn ? 'Direct Contact' : 'Contacto Directo'}
        </h4>
        <p class="font-sans text-sm text-zinc-600">
          prensa@nochemadrid.org<br />
          +34 91 542 23 31<br />
          Madrid, España
        </p>
      </div>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById('menuToggleBtn');
    const mobileBtn = document.getElementById('mobileMenuBtn');
    const drawer = document.getElementById('fullMenuDrawer');

    const toggle = () => {
      drawer?.classList.toggle('hidden');
    };

    toggleBtn?.addEventListener('click', toggle);
    mobileBtn?.addEventListener('click', toggle);
  </script>
</header>
