---
import type { Locale } from '@/lib/i18n';
import { useTranslations } from '@/lib/i18n';
import { Radio, Mail, Phone, MapPin, ExternalLink, ShieldCheck } from 'lucide-astro';

interface Props {
  currentLang?: Locale;
}

const { currentLang = 'es' } = Astro.props;
const t = useTranslations(currentLang);
const base = currentLang === 'en' ? '/en' : '';
---

<footer class="border-t border-white/10 bg-black/60 pt-16 pb-12 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      {/* Col 1: Brand & Bio */}
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="h-10 w-10 rounded-xl bg-gradient-to-tr from-brand-primary to-amber-500 p-0.5 shadow-lg">
            <div class="h-full w-full rounded-[10px] bg-black flex items-center justify-center">
              <Radio class="h-5 w-5 text-rose-400" />
            </div>
          </div>
          <div>
            <span class="font-display font-black text-lg text-white">
              MADRID<span class="text-brand-primary">LIVE</span>PRESS
            </span>
            <span class="font-mono text-[10px] text-zinc-400 block -mt-1 uppercase">
              Sala de Prensa Oficial
            </span>
          </div>
        </div>
        <p class="font-sans text-xs text-zinc-400 leading-relaxed">
          {t.footer.association} Plataforma oficial de comunicación y servicio informativo para redacciones de medios nacionales e internacionales.
        </p>
      </div>

      {/* Col 2: Navigation */}
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-white">
          Navegación de Prensa
        </h4>
        <ul class="space-y-2 font-sans text-xs text-zinc-400">
          <li><a href={`${base}/comunicados`} class="hover:text-white transition-colors">{t.nav.pressReleases}</a></li>
          <li><a href={`${base}/salas`} class="hover:text-white transition-colors">{t.nav.venues}</a></li>
          <li><a href={`${base}/recursos-prensa`} class="hover:text-white transition-colors">{t.nav.mediaKit}</a></li>
          <li><a href={`${base}/eventos`} class="hover:text-white transition-colors">{t.nav.events}</a></li>
          <li><a href={`${base}/acreditaciones`} class="hover:text-white transition-colors">{t.nav.accreditations}</a></li>
        </ul>
      </div>

      {/* Col 3: Media Relations Office */}
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-white">
          Gabinete de Comunicación
        </h4>
        <ul class="space-y-2 font-mono text-xs text-zinc-400">
          <li class="flex items-center gap-2">
            <Mail class="h-3.5 w-3.5 text-brand-primary flex-shrink-0" />
            <a href="mailto:prensa@nochemadrid.org" class="hover:text-white transition-colors">prensa@nochemadrid.org</a>
          </li>
          <li class="flex items-center gap-2">
            <Phone class="h-3.5 w-3.5 text-brand-primary flex-shrink-0" />
            <span>+34 91 542 23 00</span>
          </li>
          <li class="flex items-center gap-2">
            <MapPin class="h-3.5 w-3.5 text-brand-primary flex-shrink-0" />
            <span>Madrid, España</span>
          </li>
        </ul>
      </div>

      {/* Col 4: Institutional Seal */}
      <div class="space-y-3">
        <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-white">
          Federación NocheMadrid
        </h4>
        <div class="rounded-2xl border border-white/10 bg-surface/80 p-4 space-y-2">
          <div class="flex items-center gap-2 text-rose-300 font-mono text-xs font-semibold">
            <ShieldCheck class="h-4 w-4" />
            <span>96 Espacios Federados</span>
          </div>
          <p class="font-sans text-[11px] text-zinc-400 leading-relaxed">
            Representación unitaria del ocio nocturno, salas de conciertos y festivales de la Comunidad de Madrid.
          </p>
        </div>
      </div>
    </div>

    {/* Bottom Legal bar */}
    <div class="border-t border-white/10 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-zinc-500">
      <p>© {new Date().getFullYear()} Madrid Live Press • NocheMadrid. {t.footer.rights}</p>
      <div class="flex items-center gap-4">
        <span>Aviso Legal</span>
        <span>•</span>
        <span>Política de Privacidad</span>
        <span>•</span>
        <span>Acceso Directus CMS</span>
      </div>
    </div>
  </div>
</footer>
